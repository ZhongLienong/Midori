module Map
public export { Map, Entry, MapIter, MapIterNew, MapNew, MapInsert, MapGet, MapGetOr, MapUpdate, MapRemove, MapContains, MapCount, MapSize, MapIsEmpty, MapClear, MapKeys, MapValues, MapEntries }
import { "../ArrayUtil.mdr", "../Countable.mdr", "../Equatable.mdr", "../Hashable.mdr", "../Iterable.mdr", "../Prelude/Option.mdr", "./OpenAddressing.mdr" }
use Option.{
    Option
}
type MapSlot < K, V > = Empty | Deleted | Occupied(K, V);
type Entry < K, V > = {
    key: K,
    value: V
};
type Map < K, V > = {
    buckets: Array < MapSlot < K,
    V >>,
    count: Int,
    capacity: Int
};
type MapIter < K, V > = {
    map: Map < K,
    V >,
    index: Int
};
def MapIterNew = fn < K, V >(map: Map < K, V >) -> MapIter < K, V > => MapIter (map, 0);
def MapIterStep = fn < K, V >(map: Map < K, V >, index: Int) -> Option < (Entry < K, V >, MapIter < K, V >) > => {
    if index >= map.capacity then Option::None () else {
        match map.buckets[index] with
            case MapSlot::Occupied(key, value) => Option::Some ((Entry (key, value), MapIter (map, index + 1)))
            default => MapIterStep(map, index + 1)
    }
};
instance Iterable < MapIter < K, V >> {
    type Item = Entry < K,
    V >;
    def Next = fn(iter: MapIter < K, V >) -> Option < (Entry < K, V >, MapIter < K, V >) > => MapIterStep(iter.map, iter.index);
};
def MakeMapBuckets = fn < K, V >(capacity: Int) -> Array < MapSlot < K, V >> => [MapSlot::Empty () for slot in 0..1..capacity];
def MapNewWithCapacity = fn < K, V >(capacity: Int) -> Map < K, V > => {
    def cap = if capacity < 16 then 16 else capacity;
    Map (MakeMapBuckets(cap), 0, cap)
};
def MapNew = fn < K, V >() -> Map < K, V > => MapNewWithCapacity(16);
def FindMapSlot = fn < K, V >(map: Map < K, V >, key: K, hash: Int) -> Int where Equatable < K > => {
    def probe = OpenAddressing::ProbeStart(hash, map.capacity);
    loop {
        if OpenAddressing::ProbeHasNext(probe) then {
            def probe_idx = OpenAddressing::ProbeIndex(probe);
            def entry = map.buckets[probe_idx];
            match entry with
                case MapSlot::Empty() => break- 1
                case MapSlot::Deleted() => {
                OpenAddressing::ProbeAdvance(probe);
                ()
            }
                case MapSlot::Occupied(existing_key, _value) => {
                if Equatable::Equals(existing_key, key) then break probe_idx else {
                    OpenAddressing::ProbeAdvance(probe);
                    ()
                }
            }
        } else break- 1
    }
};
def FindMapInsertSlot = fn < K, V >(map: Map < K, V >, key: K, hash: Int) -> Int where Equatable < K > => {
    def probe = OpenAddressing::ProbeStart(hash, map.capacity);
    loop {
        if OpenAddressing::ProbeHasNext(probe) then {
            def probe_idx = OpenAddressing::ProbeIndex(probe);
            def entry = map.buckets[probe_idx];
            match entry with
                case MapSlot::Empty() => break OpenAddressing::ProbeResolveInsertIndex(probe, probe_idx)
                case MapSlot::Deleted() => {
                OpenAddressing::ProbeRememberDeleted(probe, probe_idx);
                OpenAddressing::ProbeAdvance(probe);
                ()
            }
                case MapSlot::Occupied(existing_key, _value) => {
                if Equatable::Equals(existing_key, key) then break probe_idx else {
                    OpenAddressing::ProbeAdvance(probe);
                    ()
                }
            }
        } else {
            def deleted_idx = OpenAddressing::ProbeDeletedIndex(probe);
            if deleted_idx >= 0 then break deleted_idx else break- 1
        }
    }
};
def MapInsertNoRehash = fn < K, V >(map: Map < K, V >, key: K, value: V) -> Bool where Hashable < K >, Equatable < K > => {
    def h = Hashable::Hash(key);
    def slot = FindMapInsertSlot(map, key, h);
    if slot < 0 then false else {
        def existing = map.buckets[slot];
        match existing with
            case MapSlot::Occupied(_key, _value) => false
            default => {
            map.buckets[slot] = MapSlot::Occupied (key, value);
            map.count = map.count + 1;
            true
        }
    }
};
def MapReinsertAll = fn < K, V >(map: Map < K, V >, old_buckets: Array < MapSlot < K, V > >, old_capacity: Int, index: Int) -> Unit where Hashable < K >, Equatable < K > => {
    if index >= old_capacity then () else {
        match old_buckets[index] with
            case MapSlot::Occupied(key, value) => {
                MapInsertNoRehash(map, key, value);
                ()
            }
            default =>();
        MapReinsertAll(map, old_buckets, old_capacity, index + 1)
    }
};
def MapRehash = fn < K, V >(map: Map < K, V >, new_capacity: Int) -> Unit where Hashable < K >, Equatable < K > => {
    def old_buckets = map.buckets;
    def old_capacity = map.capacity;
    map.buckets = MakeMapBuckets(new_capacity);
    map.capacity = new_capacity;
    map.count = 0;
    MapReinsertAll(map, old_buckets, old_capacity, 0);
    ()
};
def MapInsert = fn < K, V >(map: Map < K, V >, key: K, value: V) -> Bool where Hashable < K >, Equatable < K > => {
    def projected = map.count + 1;
    if projected * 10 >= map.capacity * 7 then MapRehash(map, map.capacity * 2) else();
    MapInsertNoRehash(map, key, value)
};
def MapGet = fn < K, V >(map: Map < K, V >, key: K) -> Option < V > where Hashable < K >, Equatable < K > => {
    def h = Hashable::Hash(key);
    def slot = FindMapSlot(map, key, h);
    if slot < 0 then Option::None () else {
        def entry = map.buckets[slot];
        match entry with
            case MapSlot::Occupied(_key, value) => Option::Some (value)
            default => Option::None ()
    }
};
def MapGetOr = fn < K, V >(map: Map < K, V >, key: K, default_value: V) -> V where Hashable < K >, Equatable < K > => {
    def result = MapGet(map, key);
    match result with
        case Option::Some(value) => value
        case Option::None() => default_value
};
def MapUpdate = fn < K, V >(map: Map < K, V >, key: K, value: V) -> Option < V > where Hashable < K >, Equatable < K > => {
    def h = Hashable::Hash(key);
    def slot = FindMapSlot(map, key, h);
    if slot < 0 then Option::None () else {
        def entry = map.buckets[slot];
        def old_value: Option < V > = match entry with
            case MapSlot::Occupied(_key, existing_value) => Option::Some (existing_value)
            default => Option::None ();
        map.buckets[slot] = MapSlot::Occupied (key, value);
        old_value
    }
};
def MapRemove = fn < K, V >(map: Map < K, V >, key: K) -> Bool where Hashable < K >, Equatable < K > => {
    def h = Hashable::Hash(key);
    def slot = FindMapSlot(map, key, h);
    if slot < 0 then false else {
        def deleted: MapSlot < K, V > = MapSlot::Deleted ();
        map.buckets[slot] = deleted;
        map.count = map.count - 1;
        true
    }
};
def MapContains = fn < K, V >(map: Map < K, V >, key: K) -> Bool where Hashable < K >, Equatable < K > => {
    def h = Hashable::Hash(key);
    def slot = FindMapSlot(map, key, h);
    slot >= 0
};
def MapCount = fn < K, V >(map: Map < K, V >) -> Int => map.count;
instance Countable < Map < K, V >> {
    def Count = fn(value: Map < K, V >) -> Int => MapCount(value);
};
def MapSize = fn < K, V >(map: Map < K, V >) -> Int => MapCount(map);
def MapIsEmpty = fn < K, V >(map: Map < K, V >) -> Bool => map.count == 0;
def MapClear = fn < K, V >(map: Map < K, V >) -> Unit => {
    map.buckets = MakeMapBuckets(map.capacity);
    map.count = 0;
    ()
};
def MapAppendKeys = fn < K, V >(keys: Array < K >, map: Map < K, V >, index: Int) -> Unit => {
    if index >= map.capacity then () else {
        match map.buckets[index] with
            case MapSlot::Occupied(key, _) => {
                ArrayUtil::Append(keys, key);
                ()
            }
            default =>();
        MapAppendKeys(keys, map, index + 1)
    }
};
def MapKeys = fn < K, V >(map: Map < K, V >) -> Array < K > => {
    def keys: Array < K > =[];
    MapAppendKeys(keys, map, 0);
    keys
};
def MapAppendValues = fn < K, V >(values: Array < V >, map: Map < K, V >, index: Int) -> Unit => {
    if index >= map.capacity then () else {
        match map.buckets[index] with
            case MapSlot::Occupied(_, value) => {
                ArrayUtil::Append(values, value);
                ()
            }
            default =>();
        MapAppendValues(values, map, index + 1)
    }
};
def MapValues = fn < K, V >(map: Map < K, V >) -> Array < V > => {
    def values: Array < V > =[];
    MapAppendValues(values, map, 0);
    values
};
def MapAppendEntries = fn < K, V >(entries: Array < Entry < K, V > >, map: Map < K, V >, index: Int) -> Unit => {
    if index >= map.capacity then () else {
        match map.buckets[index] with
            case MapSlot::Occupied(key, value) => {
                ArrayUtil::Append(entries, Entry (key, value));
                ()
            }
            default =>();
        MapAppendEntries(entries, map, index + 1)
    }
};
def MapEntries = fn < K, V >(map: Map < K, V >) -> Array < Entry < K, V >> => {
    def entries: Array < Entry < K, V >> =[];
    MapAppendEntries(entries, map, 0);
    entries
};
