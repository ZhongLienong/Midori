module PersistentSet
import { "./PersistentMap.mdr", "../ArrayUtil.mdr", "../Equatable.mdr", "../Hashable.mdr", "../Iterable.mdr", "../Prelude/Option.mdr" }
public export { PSet, SetEmpty, SetCount, SetIsEmpty, SetWith, SetWithout, SetHas, SetToArray, SetIter, SetIterNew }
use Option.{
    Option
}
// Its own type rather than an alias for PMap<T, Unit>: spec section 5 wants a
// Set's Hashable instance not to collapse into the map's.
//
// The operations are prefixed rather than named Empty, Count and so on. This
// module imports PersistentMap, which exports those names, and a definition
// that collides with an import silently loses to it -- see
// docs/superpowers/repros/shadowed-generic-*.mdr.
type PSet < T > = {
    entries: PersistentMap::PMap < T, Unit >
};
def SetEmpty = fn < T >() -> PSet < T > => PSet (PersistentMap::Empty());
def SetCount = fn < T >(set: PSet < T >) -> Int => PersistentMap::Count(set.entries);
def SetIsEmpty = fn < T >(set: PSet < T >) -> Bool => PersistentMap::IsEmpty(set.entries);
def SetWith = fn < T >(set: PSet < T >, value: T) -> PSet < T > where Hashable < T >, Equatable < T > =>
    PSet (PersistentMap::With(set.entries, value, ()));
def SetWithout = fn < T >(set: PSet < T >, value: T) -> PSet < T > where Hashable < T >, Equatable < T > =>
    PSet (PersistentMap::Without(set.entries, value));
def SetHas = fn < T >(set: PSet < T >, value: T) -> Bool where Hashable < T >, Equatable < T > =>
    PersistentMap::ContainsKey(set.entries, value);
def SetToArray = fn < T >(set: PSet < T >) -> Array < T > => {
    def pairs = PersistentMap::Entries(set.entries);
    [pairs[slot].key for slot in 0..1..ArrayUtil::Length(pairs)]
};
type SetIter < T > = {
    values: Array < T >,
    index: Int
};
def SetIterNew = fn < T >(set: PSet < T >) -> SetIter < T > => SetIter (SetToArray(set), 0);
instance Iterable < SetIter < T >> {
    type Item = T;
    def Next = fn(iter: SetIter < T >) -> Option < (T, SetIter < T >) > =>
        if iter.index >= ArrayUtil::Length(iter.values)
        then Option::None ()
        else Option::Some ((iter.values[iter.index], SetIter (iter.values, iter.index + 1)));
};
