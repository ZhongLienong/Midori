module OpenAddressing
public export { ProbeState, ProbeStart, ProbeHasNext, ProbeIndex, ProbeAdvance, ProbeRememberDeleted, ProbeDeletedIndex, ProbeResolveInsertIndex }
struct ProbeState {
    start: Int,
    first_deleted: Int,
    offset: Int,
    capacity: Int
};
def NormalizeProbeStart = fn(hash: Int, capacity: Int) -> Int => {
    def idx = hash % capacity;
    if idx < 0 then 0 - idx else idx
};
def ProbeStart = fn(hash: Int, capacity: Int) -> ProbeState => new ProbeState(NormalizeProbeStart(hash, capacity), - 1, 0, capacity);
def ProbeHasNext = fn(state: ProbeState) -> Bool => state.offset < state.capacity;
def ProbeIndex = fn(state: ProbeState) -> Int =>(state.start + state.offset) % state.capacity;
def ProbeAdvance = fn(state: ProbeState) -> Unit => {
    state.offset = state.offset + 1;
    ()
};
def ProbeRememberDeleted = fn(state: ProbeState, index: Int) -> Unit => {
    if state.first_deleted < 0 then {
        state.first_deleted = index;
        ()
    } else();
    ()
};
def ProbeDeletedIndex = fn(state: ProbeState) -> Int => state.first_deleted;
def ProbeResolveInsertIndex = fn(state: ProbeState, empty_index: Int) -> Int => {
    if state.first_deleted >= 0 then state.first_deleted else empty_index
};
