module Set
public export { Set, SetIter, SetIterNew, SetNew, SetInsert, SetContains, SetRemove, SetCount, SetSize, SetIsEmpty, SetClear, SetUnion, SetIntersection, SetDifference, SetToArray }
import { "../ArrayUtil.mdr", "../Countable.mdr", "../Equatable.mdr", "../Hashable.mdr", "../Iterable.mdr", "../Prelude/Option.mdr", "./OpenAddressing.mdr" }
use Option.{
    Option
}
type SetSlot < T > = Empty | Deleted | Occupied(T);
type Set < T > = {
    buckets: Array < SetSlot < T >>,
    count: Int,
    capacity: Int
};
type SetIter < T > = {
    set: Set < T >,
    index: Int
};
def SetIterNew = fn < T >(set: Set < T >) -> SetIter < T > => SetIter (set, 0);
instance Iterable < SetIter < T >> {
    type Item = T;
    def Next = fn(iter: SetIter < T >) -> Option < (T, SetIter < T >) > => {
        if iter.index >= iter.set.capacity then Option::None () else {
            match iter.set.buckets[iter.index] with
                case SetSlot::Occupied(elem) => Option::Some ((elem, SetIter (iter.set, iter.index + 1)))
                default => Iterable::Next(SetIter (iter.set, iter.index + 1))
        }
    };
};
def MakeSetBuckets = fn < T >(capacity: Int) -> Array < SetSlot < T >> => {
    def buckets: Array < SetSlot < T >> =[];
    def i = 0;
    loop {
        if i >= capacity then break() else {
            ArrayUtil::Append(buckets, SetSlot::Empty ());
            i = i + 1;
        }
    };
    buckets
};
def SetNewWithCapacity = fn < T >(capacity: Int) -> Set < T > => {
    def cap = if capacity < 16 then 16 else capacity;
    Set (MakeSetBuckets(cap), 0, cap)
};
def SetNew = fn < T >() -> Set < T > => SetNewWithCapacity(16);
def FindSetSlot = fn < T >(set: Set < T >, elem: T, hash: Int) -> Int where Equatable < T > => {
    def probe = OpenAddressing::ProbeStart(hash, set.capacity);
    loop {
        if OpenAddressing::ProbeHasNext(probe) then {
            def probe_idx = OpenAddressing::ProbeIndex(probe);
            def entry = set.buckets[probe_idx];
            match entry with
                case SetSlot::Empty() => break- 1
                case SetSlot::Deleted() => {
                OpenAddressing::ProbeAdvance(probe);
                ()
            }
                case SetSlot::Occupied(existing_elem) => {
                if Equatable::Equals(existing_elem, elem) then break probe_idx else {
                    OpenAddressing::ProbeAdvance(probe);
                    ()
                }
            }
        } else break- 1
    }
};
def FindSetInsertSlot = fn < T >(set: Set < T >, elem: T, hash: Int) -> Int where Equatable < T > => {
    def probe = OpenAddressing::ProbeStart(hash, set.capacity);
    loop {
        if OpenAddressing::ProbeHasNext(probe) then {
            def probe_idx = OpenAddressing::ProbeIndex(probe);
            def entry = set.buckets[probe_idx];
            match entry with
                case SetSlot::Empty() => break OpenAddressing::ProbeResolveInsertIndex(probe, probe_idx)
                case SetSlot::Deleted() => {
                OpenAddressing::ProbeRememberDeleted(probe, probe_idx);
                OpenAddressing::ProbeAdvance(probe);
                ()
            }
                case SetSlot::Occupied(existing_elem) => {
                if Equatable::Equals(existing_elem, elem) then break probe_idx else {
                    OpenAddressing::ProbeAdvance(probe);
                    ()
                }
            }
        } else {
            def deleted_idx = OpenAddressing::ProbeDeletedIndex(probe);
            if deleted_idx >= 0 then break deleted_idx else break- 1
        }
    }
};
def SetInsertNoRehash = fn < T >(set: Set < T >, elem: T) -> Bool where Hashable < T >, Equatable < T > => {
    def h = Hashable::Hash(elem);
    def slot = FindSetInsertSlot(set, elem, h);
    if slot < 0 then false else {
        def existing = set.buckets[slot];
        def was_new = match existing with
            case SetSlot::Occupied(_elem) => false
            default => true;
        if was_new then {
            set.buckets[slot] = SetSlot::Occupied (elem);
            set.count = set.count + 1;
        } else();
        was_new
    }
};
def SetRehash = fn < T >(set: Set < T >, new_capacity: Int) -> Unit where Hashable < T >, Equatable < T > => {
    def old_buckets = set.buckets;
    def old_capacity = set.capacity;
    set.buckets = MakeSetBuckets(new_capacity);
    set.capacity = new_capacity;
    set.count = 0;
    def i = 0;
    loop {
        if i >= old_capacity then break() else {
            def entry = old_buckets[i];
            match entry with
                case SetSlot::Occupied(elem) => {
                SetInsertNoRehash(set, elem);
                ()
            }
                default =>();
            i = i + 1;
        }
    };
    ()
};
def SetInsert = fn < T >(set: Set < T >, elem: T) -> Bool where Hashable < T >, Equatable < T > => {
    def projected = set.count + 1;
    if projected * 10 >= set.capacity * 7 then SetRehash(set, set.capacity * 2) else();
    SetInsertNoRehash(set, elem)
};
def SetContains = fn < T >(set: Set < T >, elem: T) -> Bool where Hashable < T >, Equatable < T > => {
    def h = Hashable::Hash(elem);
    def slot = FindSetSlot(set, elem, h);
    slot >= 0
};
def SetRemove = fn < T >(set: Set < T >, elem: T) -> Bool where Hashable < T >, Equatable < T > => {
    def h = Hashable::Hash(elem);
    def slot = FindSetSlot(set, elem, h);
    if slot < 0 then false else {
        def deleted: SetSlot < T > = SetSlot::Deleted ();
        set.buckets[slot] = deleted;
        set.count = set.count - 1;
        true
    }
};
def SetCount = fn < T >(set: Set < T >) -> Int => set.count;
instance Countable < Set < T >> {
    def Count = fn(value: Set < T >) -> Int => SetCount(value);
};
def SetSize = fn < T >(set: Set < T >) -> Int => SetCount(set);
def SetIsEmpty = fn < T >(set: Set < T >) -> Bool => set.count == 0;
def SetClear = fn < T >(set: Set < T >) -> Unit => {
    def i = 0;
    loop {
        if i >= set.capacity then break() else {
            def empty: SetSlot < T > = SetSlot::Empty ();
            set.buckets[i] = empty;
            i = i + 1;
        }
    };
    set.count = 0;
    ()
};
def SetUnion = fn < T >(set1: Set < T >, set2: Set < T >) -> Set < T > where Hashable < T >, Equatable < T > => {
    def result: Set < T > = SetNew();
    def i = 0;
    loop {
        if i >= set1.capacity then break() else {
            def entry = set1.buckets[i];
            match entry with
                case SetSlot::Occupied(elem) => {
                SetInsert(result, elem);
                ()
            }
                default =>();
            i = i + 1;
        }
    };
    i = 0;
    loop {
        if i >= set2.capacity then break() else {
            def entry = set2.buckets[i];
            match entry with
                case SetSlot::Occupied(elem) => {
                SetInsert(result, elem);
                ()
            }
                default =>();
            i = i + 1;
        }
    };
    result
};
def SetIntersection = fn < T >(set1: Set < T >, set2: Set < T >) -> Set < T > where Hashable < T >, Equatable < T > => {
    def result: Set < T > = SetNew();
    def i = 0;
    loop {
        if i >= set1.capacity then break() else {
            def entry = set1.buckets[i];
            match entry with
                case SetSlot::Occupied(elem) => {
                if SetContains(set2, elem) then {
                    SetInsert(result, elem);
                    ()
                } else()
            }
                default =>();
            i = i + 1;
        }
    };
    result
};
def SetDifference = fn < T >(set1: Set < T >, set2: Set < T >) -> Set < T > where Hashable < T >, Equatable < T > => {
    def result: Set < T > = SetNew();
    def i = 0;
    loop {
        if i >= set1.capacity then break() else {
            def entry = set1.buckets[i];
            match entry with
                case SetSlot::Occupied(elem) => {
                if SetContains(set2, elem) then() else {
                    SetInsert(result, elem);
                    ()
                }
            }
                default =>();
            i = i + 1;
        }
    };
    result
};
def SetToArray = fn < T >(set: Set < T >) -> Array < T > => {
    def values: Array < T > =[];
    def i = 0;
    loop {
        if i >= set.capacity then break() else {
            def entry = set.buckets[i];
            match entry with
                case SetSlot::Occupied(elem) => {
                ArrayUtil::Append(values, elem);
                ()
            }
                default =>();
            i = i + 1;
        }
    };
    values
};
