module HashSet
public export
{
    SetNew, SetInsert, SetContains, SetRemove, SetSize,
    SetIsEmpty, SetClear, SetUnion, SetIntersection, SetDifference,
    SetData, SetEntry
}
import { "Hashable.mdr", "Equatable.mdr" }

union SetEntry<T> = Empty | Deleted | Occupied(T);

struct SetData<T> {
    buckets: Array<SetEntry<T>>,
    count: Int,
    capacity: Int
};

defun SetNew<T>() : SetData<T> => {
    def initial_cap = 16;
    def buckets : Array<SetEntry<T>> = [];
    def i = 0;
    loop {
        if i >= initial_cap
        then break ()
        else {
            buckets ++= new SetEntry::Empty();
            i = i + 1;
        }
    };
    new SetData(buckets, 0, initial_cap)
};

defun find_set_slot<T>(set: SetData<T>, elem: T, hash: Int) : Int
    where Equatable<T> => {
    def idx = hash % set.capacity;
    if idx < 0 then idx = 0 - idx else 0;
    def i = 0;
    loop {
        if i >= set.capacity
        then break -1
        else {
            def probe_idx = (idx + i) % set.capacity;
            def entry = set.buckets[probe_idx];
            match entry with
                case SetEntry::Empty() => break -1
                case SetEntry::Deleted() => { i = i + 1; }
                case SetEntry::Occupied(e) => {
                    if Equatable::Equals(e, elem)
                    then break probe_idx
                    else { i = i + 1; }
                }

        }
    }
};

defun find_set_insert_slot<T>(set: SetData<T>, elem: T, hash: Int) : Int
    where Equatable<T> => {
    def idx = hash % set.capacity;
    if idx < 0 then idx = 0 - idx else 0;
    def i = 0;
    loop {
        if i >= set.capacity
        then break -1
        else {
            def probe_idx = (idx + i) % set.capacity;
            def entry = set.buckets[probe_idx];
            match entry with
                case SetEntry::Empty() => break probe_idx
                case SetEntry::Deleted() => break probe_idx
                case SetEntry::Occupied(e) => {
                    if Equatable::Equals(e, elem)
                    then break probe_idx
                    else { i = i + 1; }
                }

        }
    }
};

defun SetInsert<T>(set: SetData<T>, elem: T) : Bool
    where Hashable<T>, Equatable<T> => {
    def h = Hashable::Hash(elem);
    def slot = find_set_insert_slot(set, elem, h);
    if slot < 0
    then false
    else {
        def existing = set.buckets[slot];
        def was_new = match existing with
            case SetEntry::Occupied(e) => false
            default => true
        ;
        if was_new then {
            set.buckets[slot] = new SetEntry::Occupied(elem);
            set.count = set.count + 1;
        } else ();
        was_new
    }
};

defun SetContains<T>(set: SetData<T>, elem: T) : Bool
    where Hashable<T>, Equatable<T> => {
    def h = Hashable::Hash(elem);
    def slot = find_set_slot(set, elem, h);
    slot >= 0
};

defun SetRemove<T>(set: SetData<T>, elem: T) : Bool
    where Hashable<T>, Equatable<T> => {
    def h = Hashable::Hash(elem);
    def slot = find_set_slot(set, elem, h);
    if slot < 0
    then false
    else {
        set.buckets[slot] = new SetEntry::Deleted();
        set.count = set.count - 1;
        true
    }
};

defun SetSize<T>(set: SetData<T>) : Int => set.count;

defun SetIsEmpty<T>(set: SetData<T>) : Bool => set.count == 0;

defun SetClear<T>(set: SetData<T>) : Unit => {
    def i = 0;
    loop {
        if i >= set.capacity
        then break ()
        else {
            set.buckets[i] = new SetEntry::Empty();
            i = i + 1;
        }
    };
    set.count = 0;
    ()
};

defun SetUnion<T>(set1: SetData<T>, set2: SetData<T>) : SetData<T>
    where Hashable<T>, Equatable<T> => {
    def result : SetData<T> = SetNew();
    def i = 0;
    loop {
        if i >= set1.capacity
        then break ()
        else {
            def entry = set1.buckets[i];
            match entry with
                case SetEntry::Occupied(elem) => { SetInsert(result, elem); () }
                default => ()
            ;
            i = i + 1;
        }
    };
    i = 0;
    loop {
        if i >= set2.capacity
        then break ()
        else {
            def entry = set2.buckets[i];
            match entry with
                case SetEntry::Occupied(elem) => { SetInsert(result, elem); () }
                default => ()
            ;
            i = i + 1;
        }
    };
    result
};

defun SetIntersection<T>(set1: SetData<T>, set2: SetData<T>) : SetData<T>
    where Hashable<T>, Equatable<T> => {
    def result : SetData<T> = SetNew();
    def i = 0;
    loop {
        if i >= set1.capacity
        then break ()
        else {
            def entry = set1.buckets[i];
            match entry with
                case SetEntry::Occupied(elem) => {
                    if SetContains(set2, elem)
                    then { SetInsert(result, elem); () }
                    else ()
                }
                default => ()
            ;
            i = i + 1;
        }
    };
    result
};

defun SetDifference<T>(set1: SetData<T>, set2: SetData<T>) : SetData<T>
    where Hashable<T>, Equatable<T> => {
    def result : SetData<T> = SetNew();
    def i = 0;
    loop {
        if i >= set1.capacity
        then break ()
        else {
            def entry = set1.buckets[i];
            match entry with
                case SetEntry::Occupied(elem) => {
                    if SetContains(set2, elem)
                    then ()
                    else { SetInsert(result, elem); () }
                }
                default => ()
            ;
            i = i + 1;
        }
    };
    result
};
