module Countable
public export { Countable }
class Countable < T > {
    Count: fn(value: T) -> Int;
};
foreign "MIDORI_FFI_TextLength" TextLength: fn(Text) -> Int;
foreign "MIDORI_FFI_ArrayLength" ArrayLength: fn(Array < T >) -> Int;
instance Countable < Text > {
    defun Count(value: Text): Int => TextLength(value);
};
instance Countable < Array < T >> {
    defun Count(value: Array < T >): Int => ArrayLength(value);
};
