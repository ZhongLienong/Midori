module Equatable
public export { Equatable }

class Equatable<T>
{
    Equals: fn(a: T, b: T) -> Bool;
};

instance Equatable<Int> 
{
    defun Equals(a: Int, b: Int) : Bool => a == b;
};

instance Equatable<Float> 
{
    defun Equals(a: Float, b: Float) : Bool => a == b;
};

instance Equatable<Text> 
{
    defun Equals(a: Text, b: Text) : Bool => a == b;
};

instance Equatable<Bool> 
{
    defun Equals(a: Bool, b: Bool) : Bool => a == b;
};

instance Equatable<Byte> 
{
    defun Equals(a: Byte, b: Byte) : Bool => a == b;
};

instance Equatable<Word> 
{
    defun Equals(a: Word, b: Word) : Bool => a == b;
};
