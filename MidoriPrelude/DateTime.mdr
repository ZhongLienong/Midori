{
    GetTime,
    GetYear, GetMonth, GetDay, GetHour, GetMinute, GetSecond,
    GetDayOfWeek, GetDayOfYear,
    FormatTime, GetTimezoneOffset,
    GetUtcYear, GetUtcMonth, GetUtcDay, GetUtcHour, GetUtcMinute, GetUtcSecond
}

foreign "MIDORI_FFI_GetTime" GetTime : fn() -> Float;

