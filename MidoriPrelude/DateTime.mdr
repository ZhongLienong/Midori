foreign "MIDORI_FFI_GetDayOfYear" GetDayOfYear : fn() -> Int;

foreign "MIDORI_FFI_FormatTime" FormatTime : fn(Text) -> Text;

foreign "MIDORI_FFI_GetTimezoneOffset" GetTimezoneOffset : fn() -> Int;

foreign "MIDORI_FFI_GetUtcYear" GetUtcYear : fn() -> Int;

foreign "MIDORI_FFI_GetUtcMonth" GetUtcMonth : fn() -> Int;

foreign "MIDORI_FFI_GetUtcDay" GetUtcDay : fn() -> Int;

foreign "MIDORI_FFI_GetUtcHour" GetUtcHour : fn() -> Int;

