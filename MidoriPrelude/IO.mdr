module IO
public export
{
    Print, PrintLine, PrintError, PrintErrorLine,
    ReadInput, ReadLine,
    ReadFile, WriteFile, AppendToFile,
    ReadBinaryFile, WriteBinaryFile,
    FileExists, DeleteFile, RenameFile, GetFileSize
}

/*
* Console Output
*/

foreign "MIDORI_FFI_Print" Print : fn(Text) -> Unit;

defun PrintLine(text: Text) : Unit => { Print(text ++ "\n"); };

foreign "MIDORI_FFI_PrintError" PrintError : fn(Text) -> Unit;

defun PrintErrorLine(text: Text) : Unit => { PrintError(text ++ "\n"); };

/*
* Console Input
*/

foreign "MIDORI_FFI_ReadInput" ReadInput : fn() -> Text;

foreign "MIDORI_FFI_ReadLine" ReadLine : fn() -> Text;

/*
* File Operations
*/

foreign "MIDORI_FFI_ReadFile" ReadFile : fn(Text) -> Text;

foreign "MIDORI_FFI_WriteFile" WriteFile : fn(Text, Text) -> Bool;

foreign "MIDORI_FFI_AppendToFile" AppendToFile : fn(Text, Text) -> Bool;

/*
* Binary File Operations
*/

foreign "MIDORI_FFI_ReadBinaryFile" ReadBinaryFile : fn(Text) -> Array<Byte>;

foreign "MIDORI_FFI_WriteBinaryFile" WriteBinaryFile : fn(Text, Array<Byte>) -> Bool;

/*
* File System Utilities
*/

foreign "MIDORI_FFI_FileExists" FileExists : fn(Text) -> Bool;

foreign "MIDORI_FFI_DeleteFile" DeleteFile : fn(Text) -> Bool;

foreign "MIDORI_FFI_RenameFile" RenameFile : fn(Text, Text) -> Bool;

foreign "MIDORI_FFI_GetFileSize" GetFileSize : fn(Text) -> Int;