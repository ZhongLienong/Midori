module Panic
public export { Panic }
foreign "MIDORI_FFI_PrintError" PrintErrorRaw: fn(Text) -> Unit;
foreign "MIDORI_FFI_Exit" ExitRaw: fn(Int) -> Unit;
// ExitRaw terminates the process, so the self-call is never reached; it is
// what gives the body type Never now that `loop` is gone.
def Panic = fn(message: Text) -> Never => {
    PrintErrorRaw(message ++ "\n");
    ExitRaw(1);
    Panic(message)
};
