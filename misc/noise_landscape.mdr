module noise_landscape

import
{
    "../MidoriPrelude/IO.mdr",
    "../MidoriPrelude/Math.mdr",
    "../MidoriPrelude/DateTime.mdr",
    "../MidoriPrelude/Appendable.mdr",
    <Image>
}

type Vec3 =
{
    X : Float,
    Y : Float,
    Z : Float,
} deriving (Transferable);

def vec3_add = fn(a : Vec3, b : Vec3) -> Vec3 => Vec3(a.X + b.X, a.Y + b.Y, a.Z + b.Z);
def vec3_sub = fn(a : Vec3, b : Vec3) -> Vec3 => Vec3(a.X - b.X, a.Y - b.Y, a.Z - b.Z);
def vec3_scale = fn(a : Vec3, s : Float) -> Vec3 => Vec3(a.X * s, a.Y * s, a.Z * s);
def vec3_dot = fn(a : Vec3, b : Vec3) -> Float => a.X * b.X + a.Y * b.Y + a.Z * b.Z;
def vec3_length = fn(a : Vec3) -> Float => Math::SquareRoot(vec3_dot(a, a));

def vec3_normalize = fn(a : Vec3) -> Vec3 =>
{
    def len = vec3_length(a);
    if len < 0.000001
    then Vec3(0.0, 0.0, 0.0)
    else vec3_scale(a, 1.0 / len)
};

def hash2d = fn(x : Float, y : Float) -> Float =>
{
    def n = Math::Sin(x * 127.1 + y * 311.7) * 43758.5453;
    n - Math::Floor(n)
};

def lerp = fn(a : Float, b : Float, t : Float) -> Float => a + (b - a) * t;

def smoothstep = fn(t : Float) -> Float => t * t * (3.0 - 2.0 * t);

def value_noise = fn(x : Float, y : Float) -> Float =>
{
    def ix = Math::Floor(x);
    def iy = Math::Floor(y);
    def fx = x - ix;
    def fy = y - iy;
    def u = smoothstep(fx);
    def v = smoothstep(fy);
    def n00 = hash2d(ix, iy);
    def n10 = hash2d(ix + 1.0, iy);
    def n01 = hash2d(ix, iy + 1.0);
    def n11 = hash2d(ix + 1.0, iy + 1.0);
    def nx0 = lerp(n00, n10, u);
    def nx1 = lerp(n01, n11, u);
    lerp(nx0, nx1, v)
};

def fbm = fn(x : Float, y : Float, octaves : Int) -> Float =>
{
    def total = 0.0;
    def amplitude = 0.5;
    def frequency = 1.0;
    def i = 0;
    loop
    {
        if i >= octaves then break () else ();
        total = total + value_noise(x * frequency, y * frequency) * amplitude;
        amplitude = amplitude * 0.5;
        frequency = frequency * 2.0;
        i = i + 1;
    };
    total
};

def terrain_height = fn(x : Float, z : Float) -> Float =>
{
    def base = fbm(x * 0.3 + 50.0, z * 0.3 + 50.0, 6);
    def ridged_raw = fbm(x * 0.5 + 100.0, z * 0.5 + 100.0, 4);
    def ridged = 1.0 - Math::Abs(ridged_raw * 2.0 - 1.0);
    def ridged_sq = ridged * ridged;
    def combined = base * 0.6 + ridged_sq * 0.4;
    combined * 4.0 - 1.0
};

def terrain_normal = fn(x : Float, z : Float) -> Vec3 =>
{
    def eps = 0.02;
    def hc = terrain_height(x, z);
    def hx = terrain_height(x + eps, z);
    def hz = terrain_height(x, z + eps);
    vec3_normalize(Vec3(-1.0 * (hx - hc) / eps, 1.0, -1.0 * (hz - hc) / eps))
};

def terrain_color = fn(height : Float, normal : Vec3, world_pos : Vec3) -> Vec3 =>
{
    def slope = 1.0 - normal.Y;
    if height < -0.2
    then Vec3(0.15, 0.30, 0.55)
    else if height < 0.0
    then
    {
        def t = (height + 0.2) / 0.2;
        def r = lerp(0.15, 0.76, t);
        def g = lerp(0.30, 0.70, t);
        def b = lerp(0.55, 0.50, t);
        Vec3(r, g, b)
    }
    else if height < 0.8
    then
    {
        if slope > 0.5
        then Vec3(0.45, 0.40, 0.35)
        else
        {
            def grass_var = value_noise(world_pos.X * 5.0, world_pos.Z * 5.0) * 0.1;
            Vec3(0.25 + grass_var, 0.50 + grass_var, 0.15 + grass_var)
        }
    }
    else if height < 1.5
    then
    {
        def t = (height - 0.8) / 0.7;
        if slope > 0.4
        then Vec3(0.50, 0.45, 0.40)
        else
        {
            def r = lerp(0.30, 0.55, t);
            def g = lerp(0.50, 0.50, t);
            def b = lerp(0.20, 0.45, t);
            Vec3(r, g, b)
        }
    }
    else
    {
        def snow_t = Math::Clamp((height - 1.5) / 0.5, 0.0, 1.0);
        if slope > 0.6
        then Vec3(0.55, 0.50, 0.45)
        else
        {
            def r = lerp(0.55, 0.95, snow_t);
            def g = lerp(0.50, 0.95, snow_t);
            def b = lerp(0.45, 0.98, snow_t);
            Vec3(r, g, b)
        }
    }
};

def raymarch_terrain = fn(ro : Vec3, rd : Vec3) -> Vec3 =>
{
    def t = 0.1;
    def max_t = 60.0;
    def hit = false;
    def step = 0;
    loop
    {
        if step >= 256 then break () else ();
        if t >= max_t then break () else ();
        def p = vec3_add(ro, vec3_scale(rd, t));
        def h = terrain_height(p.X, p.Z);
        if p.Y < h
        then
        {
            hit = true;
            break ()
        }
        else ();
        def step_size = Math::Max(0.01, (p.Y - h) * 0.4);
        t = t + step_size;
        step = step + 1;
    };

    if !hit
    then
    {
        def sky_t = Math::Clamp(rd.Y * 2.0 + 0.5, 0.0, 1.0);
        def r = lerp(0.75, 0.40, sky_t);
        def g = lerp(0.80, 0.55, sky_t);
        def b = lerp(0.85, 0.85, sky_t);
        Vec3(r, g, b)
    }
    else
    {
        def hit_p = vec3_add(ro, vec3_scale(rd, t));
        def normal = terrain_normal(hit_p.X, hit_p.Z);
        def height = terrain_height(hit_p.X, hit_p.Z);
        def base_color = terrain_color(height, normal, hit_p);

        def light_dir = vec3_normalize(Vec3(0.5, 0.7, -0.3));
        def diff = Math::Max(vec3_dot(normal, light_dir), 0.0);
        def ambient = 0.25;
        def lit = ambient + diff * 0.75;

        def fog_dist = t / max_t;
        def fog = Math::Clamp(fog_dist * fog_dist, 0.0, 1.0);
        def fog_color = Vec3(0.75, 0.80, 0.85);

        def cr = lerp(base_color.X * lit, fog_color.X, fog);
        def cg = lerp(base_color.Y * lit, fog_color.Y, fog);
        def cb = lerp(base_color.Z * lit, fog_color.Z, fog);

        def cr_t = Math::Pow(Math::Clamp(cr, 0.0, 1.0), 1.0 / 2.2);
        def cg_t = Math::Pow(Math::Clamp(cg, 0.0, 1.0), 1.0 / 2.2);
        def cb_t = Math::Pow(Math::Clamp(cb, 0.0, 1.0), 1.0 / 2.2);
        Vec3(cr_t, cg_t, cb_t)
    }
};

def append_color_rgba = fn(pixels : Array<Int>, cr : Float, cg : Float, cb : Float) -> Unit =>
{
    def r = Math::Clamp(Math::Round(cr * 255.0), 0.0, 255.0) as Int;
    def g = Math::Clamp(Math::Round(cg * 255.0), 0.0, 255.0) as Int;
    def b = Math::Clamp(Math::Round(cb * 255.0), 0.0, 255.0) as Int;
    Appendable::Append(pixels, r);
    Appendable::Append(pixels, g);
    Appendable::Append(pixels, b);
    Appendable::Append(pixels, 255);
};

def render_band = fn(y_start : Int, y_end : Int, width : Int, height : Int, cam_origin : Vec3, cam_target : Vec3) -> Array<Int> =>
{
    def pixels : Array<Int> = [];
    def width_f = width as Float;
    def height_f = height as Float;
    def aspect = width_f / height_f;
    def fov = 0.8;

    def forward = vec3_normalize(vec3_sub(cam_target, cam_origin));
    def world_up = Vec3(0.0, 1.0, 0.0);
    def right = vec3_normalize(Vec3(
        forward.Z * world_up.Y - forward.Y * world_up.Z,
        forward.X * world_up.Z - forward.Z * world_up.X,
        forward.Y * world_up.X - forward.X * world_up.Y
    ));
    def up = Vec3(
        right.Z * forward.Y - right.Y * forward.Z,
        right.X * forward.Z - right.Z * forward.X,
        right.Y * forward.X - right.X * forward.Y
    );

    def y = y_start;
    loop
    {
        def x = 0;
        loop
        {
            def u = (2.0 * (x as Float) / width_f - 1.0) * aspect * fov;
            def v = (1.0 - 2.0 * (y as Float) / height_f) * fov;
            def rd = vec3_normalize(vec3_add(vec3_add(vec3_scale(right, u), vec3_scale(up, v)), forward));
            def color = raymarch_terrain(cam_origin, rd);
            append_color_rgba(pixels, color.X, color.Y, color.Z);
            x = x + 1;
            if x >= width then break () else ();
        };
        y = y + 1;
        if y >= y_end then break () else ();
    };
    pixels
};

def append_pixels = fn(target : Array<Int>, values : Array<Int>) -> Unit =>
{
    def index = 0;
    loop
    {
        if index >= #values then break () else ();
        Appendable::Append(target, values[index]);
        index = index + 1;
    };
};

def render_parallel = fn(y_start : Int, y_end : Int, width : Int, height : Int, cam_origin : Vec3, cam_target : Vec3, budget : Int) -> Array<Int> =>
{
    def row_count = y_end - y_start;
    if budget <= 1 || row_count <= 1
    then render_band(y_start, y_end, width, height, cam_origin, cam_target)
    else
    {
        def mid = y_start + (row_count / 2);
        def left_budget = budget / 2;
        def right_budget = budget - left_budget;
        def left_worker = spawn render_parallel(y_start, mid, width, height, cam_origin, cam_target, left_budget);
        def right_pixels = render_parallel(mid, y_end, width, height, cam_origin, cam_target, right_budget);
        def left_pixels = join left_worker;
        def pixels : Array<Int> = [];
        append_pixels(pixels, left_pixels);
        append_pixels(pixels, right_pixels);
        pixels
    }
};

def output_dir = "D:/Xuexi/";
def width = 1920;
def height = 1080;
def band_workers = 32;

def cam_origin = Vec3(8.0, 4.5, 8.0);
def cam_target = Vec3(0.0, 0.5, 0.0);

def start = DateTime::NowUnixMillis();
IO::PrintLine("Rendering procedural terrain with " ++ (band_workers as Text) ++ " workers...");

def pixels = render_parallel(0, height, width, height, cam_origin, cam_target, band_workers);
Image::WriteRGBA(output_dir ++ "noise_landscape.png", width, height, pixels);

def end = DateTime::NowUnixMillis();
IO::PrintLine("Terrain landscape rendered in " ++ ((end - start) as Text) ++ "ms");
