module fractal_test

import
{
    "../MidoriPrelude/IO.mdr",
    "../MidoriPrelude/Appendable.mdr",
    <Image>
}

defun WriteTestWorker(ch : Channel<Text>) -> Int =>
{
    def pixels : Array<Int> = [];
    def y = 0;
    loop
    {
        def x = 0;
        loop
        {
            Appendable::Append(pixels, (x * 3) % 256);
            Appendable::Append(pixels, (y * 5) % 256);
            Appendable::Append(pixels, ((x + y) * 7) % 256);
            Appendable::Append(pixels, 255);
            x = x + 1;
            if x >= 64 then break () else ();
        };
        y = y + 1;
        if y >= 64 then break () else ();
    };
    IO::PrintLine("Worker pixel count: " ++ ((#pixels / 4) as Text));
    def wrote = Image::WriteRGBA("D:/Xuexi/worker_test.png", 64, 64, pixels);
    if wrote
    then IO::PrintLine("Worker wrote file successfully")
    else IO::PrintLine("Worker FAILED to write file");
    ch -> "done";
    0
};

def ch = channel<Text>(1);
def w = spawn WriteTestWorker(ch);
IO::PrintLine("Worker spawned");
def r = <- ch;
IO::PrintLine("Main got: " ++ r);
close(ch);
def j = join w;
IO::PrintLine("Join result: " ++ (j as Text));
