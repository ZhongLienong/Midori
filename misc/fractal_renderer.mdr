module fractal_renderer

import
{
	"../MidoriPrelude/IO.mdr",
    "../MidoriPrelude/Math.mdr",
    "../MidoriPrelude/DateTime.mdr",
    "../MidoriPrelude/Appendable.mdr",
    <Image>
}

type Complex =
{
    Real : Float,
    Imag : Float,
};

type Color =
{
    R : Float,
    G : Float,
    B : Float,
};

def complex_add = fn(a : Complex, b : Complex) -> Complex => Complex(a.Real + b.Real, a.Imag + b.Imag);
def complex_mul = fn(a : Complex, b : Complex) -> Complex => Complex(a.Real * b.Real - a.Imag * b.Imag, a.Real * b.Imag + a.Imag * b.Real);
def complex_square = fn(a : Complex) -> Complex => complex_mul(a, a);
def complex_cube = fn(a : Complex) -> Complex => complex_mul(a, complex_square(a));
def complex_fourth = fn(a : Complex) -> Complex => complex_square(complex_square(a));
def complex_square_conj = fn(a : Complex) -> Complex => Complex(a.Real * a.Real - a.Imag * a.Imag, -2.0 * a.Real * a.Imag);
def complex_celtic_square = fn(a : Complex) -> Complex => Complex(Math::Abs(a.Real * a.Real - a.Imag * a.Imag), 2.0 * a.Real * a.Imag);
def complex_abs_square = fn(a : Complex) -> Float => a.Real * a.Real + a.Imag * a.Imag;

def color_add = fn(a : Color, b : Color) -> Color => Color(a.R + b.R, a.G + b.G, a.B + b.B);
def color_scale = fn(a : Color, scale : Float) -> Color => Color(a.R * scale, a.G * scale, a.B * scale);

def palette_iq = fn(t : Float, a : Color, b : Color, c : Color, d : Color) -> Color =>
{
    def r = a.R + b.R * Math::Cos(Math::Tau * (c.R * t + d.R));
    def g = a.G + b.G * Math::Cos(Math::Tau * (c.G * t + d.G));
    def bval = a.B + b.B * Math::Cos(Math::Tau * (c.B * t + d.B));
    Color(r, g, bval)
};

def smoothstep = fn(t : Float) -> Float => t * t * (3.0 - 2.0 * t);

def palette_for = fn(palette_id : Int, t : Float) -> Color =>
{
    def t_clamped = Math::Clamp(t, 0.0, 1.0);
    if palette_id == 1
    then palette_iq(t_clamped, Color(0.42, 0.55, 0.65), Color(0.38, 0.35, 0.25), Color(1.0, 1.0, 1.0), Color(0.05, 0.25, 0.55))
    else if palette_id == 2
    then palette_iq(t_clamped, Color(0.50, 0.40, 0.30), Color(0.45, 0.45, 0.45), Color(1.0, 1.0, 1.0), Color(0.10, 0.33, 0.67))
    else if palette_id == 3
    then palette_iq(t_clamped, Color(0.40, 0.55, 0.45), Color(0.45, 0.40, 0.35), Color(1.0, 1.0, 1.0), Color(0.00, 0.20, 0.45))
    else palette_iq(t_clamped, Color(0.55, 0.50, 0.60), Color(0.45, 0.45, 0.45), Color(1.0, 1.0, 1.0), Color(0.00, 0.33, 0.67))
};

def color_from_smooth = fn(smooth : Float, limit : Int, palette_id : Int) -> Color =>
{
    def limit_f = limit as Float;
    if smooth >= limit_f
    then Color(0.02, 0.02, 0.03)
    else
    {
        def t = Math::Clamp(smooth / limit_f, 0.0, 1.0);
        def t_gamma = Math::Pow(t, 0.6);
        def t_smooth = smoothstep(t_gamma);
        palette_for(palette_id, t_smooth)
    }
};

def append_color_rgba = fn(pixels : Array<Int>, cr : Float, cg : Float, cb : Float) -> Unit =>
{
    def r = Math::Clamp(Math::Round(cr * 255.0), 0.0, 255.0) as Int;
    def g = Math::Clamp(Math::Round(cg * 255.0), 0.0, 255.0) as Int;
    def b = Math::Clamp(Math::Round(cb * 255.0), 0.0, 255.0) as Int;
    Appendable::Append(pixels, r);
    Appendable::Append(pixels, g);
    Appendable::Append(pixels, b);
    Appendable::Append(pixels, 255);
};

def smooth_iter_finish = fn(iterations : Int, zr : Float, zi : Float, limit : Int) -> Float =>
{
    if iterations >= limit
    then limit as Float
    else
    {
        def zn = zr * zr + zi * zi;
        if zn <= 0.0
        then iterations as Float
        else
        {
            def log_2 = Math::Log(2.0);
            def log_zn = Math::Log(zn) / 2.0;
            def nu = Math::Log(log_zn / log_2) / log_2;
            (iterations as Float) + 1.0 - nu
        }
    }
};

def smooth_iter_mandelbrot = fn(cr : Float, ci : Float, limit : Int) -> Float =>
{
    def zr = 0.0;
    def zi = 0.0;
    def iterations = 0;
    loop
    {
        if iterations >= limit then break () else ();
        def new_zr = zr * zr - zi * zi + cr;
        def new_zi = 2.0 * zr * zi + ci;
        zr = new_zr;
        zi = new_zi;
        if zr * zr + zi * zi >= 4.0 then break () else ();
        iterations = iterations + 1;
    };
    smooth_iter_finish(iterations, zr, zi, limit)
};

def smooth_iter_julia = fn(z0r : Float, z0i : Float, cr : Float, ci : Float, limit : Int) -> Float =>
{
    def zr = z0r;
    def zi = z0i;
    def iterations = 0;
    loop
    {
        if iterations >= limit then break () else ();
        def new_zr = zr * zr - zi * zi + cr;
        def new_zi = 2.0 * zr * zi + ci;
        zr = new_zr;
        zi = new_zi;
        if zr * zr + zi * zi >= 4.0 then break () else ();
        iterations = iterations + 1;
    };
    smooth_iter_finish(iterations, zr, zi, limit)
};

def smooth_iter_burning_ship = fn(cr : Float, ci : Float, limit : Int) -> Float =>
{
    def zr = 0.0;
    def zi = 0.0;
    def iterations = 0;
    loop
    {
        if iterations >= limit then break () else ();
        def ar = Math::Abs(zr);
        def ai = Math::Abs(zi);
        def new_zr = ar * ar - ai * ai + cr;
        def new_zi = 2.0 * ar * ai + ci;
        zr = new_zr;
        zi = new_zi;
        if zr * zr + zi * zi >= 4.0 then break () else ();
        iterations = iterations + 1;
    };
    smooth_iter_finish(iterations, zr, zi, limit)
};

def smooth_iter_tricorn = fn(cr : Float, ci : Float, limit : Int) -> Float =>
{
    def zr = 0.0;
    def zi = 0.0;
    def iterations = 0;
    loop
    {
        if iterations >= limit then break () else ();
        def new_zr = zr * zr - zi * zi + cr;
        def new_zi = -2.0 * zr * zi + ci;
        zr = new_zr;
        zi = new_zi;
        if zr * zr + zi * zi >= 4.0 then break () else ();
        iterations = iterations + 1;
    };
    smooth_iter_finish(iterations, zr, zi, limit)
};

def smooth_iter_multibrot3 = fn(cr : Float, ci : Float, limit : Int) -> Float =>
{
    def zr = 0.0;
    def zi = 0.0;
    def iterations = 0;
    loop
    {
        if iterations >= limit then break () else ();
        def zr2 = zr * zr;
        def zi2 = zi * zi;
        def new_zr = zr * zr2 - 3.0 * zr * zi2 + cr;
        def new_zi = 3.0 * zr2 * zi - zi * zi2 + ci;
        zr = new_zr;
        zi = new_zi;
        if zr * zr + zi * zi >= 4.0 then break () else ();
        iterations = iterations + 1;
    };
    smooth_iter_finish(iterations, zr, zi, limit)
};

def smooth_iter_multibrot4 = fn(cr : Float, ci : Float, limit : Int) -> Float =>
{
    def zr = 0.0;
    def zi = 0.0;
    def iterations = 0;
    loop
    {
        if iterations >= limit then break () else ();
        def zr2 = zr * zr;
        def zi2 = zi * zi;
        def sq_r = zr2 - zi2;
        def sq_i = 2.0 * zr * zi;
        def new_zr = sq_r * sq_r - sq_i * sq_i + cr;
        def new_zi = 2.0 * sq_r * sq_i + ci;
        zr = new_zr;
        zi = new_zi;
        if zr * zr + zi * zi >= 4.0 then break () else ();
        iterations = iterations + 1;
    };
    smooth_iter_finish(iterations, zr, zi, limit)
};

def smooth_iter_celtic = fn(cr : Float, ci : Float, limit : Int) -> Float =>
{
    def zr = 0.0;
    def zi = 0.0;
    def iterations = 0;
    loop
    {
        if iterations >= limit then break () else ();
        def new_zr = Math::Abs(zr * zr - zi * zi) + cr;
        def new_zi = 2.0 * zr * zi + ci;
        zr = new_zr;
        zi = new_zi;
        if zr * zr + zi * zi >= 4.0 then break () else ();
        iterations = iterations + 1;
    };
    smooth_iter_finish(iterations, zr, zi, limit)
};

def smooth_iter_for = fn(fractal_kind : Int, pr : Float, pi : Float, julia_cr : Float, julia_ci : Float, limit : Int) -> Float =>
{
    if fractal_kind == 0
    then smooth_iter_mandelbrot(pr, pi, limit)
    else if fractal_kind == 1
    then smooth_iter_julia(pr, pi, julia_cr, julia_ci, limit)
    else if fractal_kind == 2
    then smooth_iter_burning_ship(pr, pi, limit)
    else if fractal_kind == 3
    then smooth_iter_tricorn(pr, pi, limit)
    else if fractal_kind == 4
    then smooth_iter_multibrot3(pr, pi, limit)
    else if fractal_kind == 5
    then smooth_iter_multibrot4(pr, pi, limit)
    else smooth_iter_celtic(pr, pi, limit)
};

def palette_id_for = fn(fractal_kind : Int) -> Int =>
{
    if fractal_kind == 0
    then 0
    else if fractal_kind == 1
    then 1
    else if fractal_kind == 2
    then 2
    else if fractal_kind == 3
    then 3
    else if fractal_kind == 4
    then 1
    else if fractal_kind == 5
    then 0
    else 2
};

def render_fractal_band_rgba = fn(y_start : Int, y_end : Int, width : Int, height : Int, limit : Int, samples_per_axis : Int, view_min_r : Float, view_min_i : Float, view_max_r : Float, view_max_i : Float, fractal_kind : Int, julia_cr : Float, julia_ci : Float) -> Array<Int> =>
{
    def pixels : Array<Int> = [];

    def width_f = width as Float;
    def height_f = height as Float;
    def real_span = view_max_r - view_min_r;
    def imag_span = view_max_i - view_min_i;
    def samples_f = samples_per_axis as Float;
    def inv_samples = 1.0 / ((samples_per_axis * samples_per_axis) as Float);

    def palette_id = palette_id_for(fractal_kind);
    def y = y_start;
    loop
    {
        def x = 0;
        loop
        {
            def sum_r = 0.0;
            def sum_g = 0.0;
            def sum_b = 0.0;

            def sx = 0;
            loop
            {
                def sy = 0;
                loop
                {
                    def u = ((x as Float) + ((sx as Float) + 0.5) / samples_f) / width_f;
                    def v = ((y as Float) + ((sy as Float) + 0.5) / samples_f) / height_f;
                    def real = view_min_r + u * real_span;
                    def imag = view_min_i + v * imag_span;

                    def smooth = smooth_iter_for(fractal_kind, real, imag, julia_cr, julia_ci, limit);
                    def sample_color = color_from_smooth(smooth, limit, palette_id);
                    sum_r = sum_r + sample_color.R;
                    sum_g = sum_g + sample_color.G;
                    sum_b = sum_b + sample_color.B;

                    sy = sy + 1;
                    if sy >= samples_per_axis then break () else ();
                };

                sx = sx + 1;
                if sx >= samples_per_axis then break () else ();
            };

            append_color_rgba(pixels, sum_r * inv_samples, sum_g * inv_samples, sum_b * inv_samples);

            x = x + 1;
            if x >= width then break () else ();
        };

        y = y + 1;
        if y >= y_end then break () else ();
    };

    pixels
};

def append_pixels = fn(target : Array<Int>, values : Array<Int>) -> Unit =>
{
    def index = 0;
    loop
    {
        if index >= #values then break () else ();
        Appendable::Append(target, values[index]);
        index = index + 1;
    };
};

def render_fractal_parallel_range_rgba = fn(y_start : Int, y_end : Int, width : Int, height : Int, limit : Int, samples_per_axis : Int, view_min_r : Float, view_min_i : Float, view_max_r : Float, view_max_i : Float, fractal_kind : Int, julia_cr : Float, julia_ci : Float, worker_budget : Int) -> Array<Int> =>
{
    def row_count = y_end - y_start;
    if worker_budget <= 1 || row_count <= 1
    then render_fractal_band_rgba(y_start, y_end, width, height, limit, samples_per_axis, view_min_r, view_min_i, view_max_r, view_max_i, fractal_kind, julia_cr, julia_ci)
    else
    {
        def mid = y_start + (row_count / 2);
        def left_budget = worker_budget / 2;
        def right_budget = worker_budget - left_budget;
        def left_worker = spawn render_fractal_parallel_range_rgba(y_start, mid, width, height, limit, samples_per_axis, view_min_r, view_min_i, view_max_r, view_max_i, fractal_kind, julia_cr, julia_ci, left_budget);
        def right_pixels = render_fractal_parallel_range_rgba(mid, y_end, width, height, limit, samples_per_axis, view_min_r, view_min_i, view_max_r, view_max_i, fractal_kind, julia_cr, julia_ci, right_budget);
        def left_pixels = join left_worker;

        def pixels : Array<Int> = [];
        append_pixels(pixels, left_pixels);
        append_pixels(pixels, right_pixels);
        pixels
    }
};

def render_fractal_parallel_rgba = fn(width : Int, height : Int, limit : Int, samples_per_axis : Int, view_min_r : Float, view_min_i : Float, view_max_r : Float, view_max_i : Float, fractal_kind : Int, julia_cr : Float, julia_ci : Float, band_workers : Int) -> Array<Int> =>
{
    def worker_count =
        if band_workers <= 1
        then 1
        else if band_workers < height
        then band_workers
        else height;
    render_fractal_parallel_range_rgba(0, height, width, height, limit, samples_per_axis, view_min_r, view_min_i, view_max_r, view_max_i, fractal_kind, julia_cr, julia_ci, worker_count)
};

def render_fractal_file = fn(output_path : Text, width : Int, height : Int, limit : Int, samples_per_axis : Int, view_min_r : Float, view_min_i : Float, view_max_r : Float, view_max_i : Float, fractal_kind : Int, julia_cr : Float, julia_ci : Float, band_workers : Int) -> Unit =>
{
    def pixels = render_fractal_parallel_rgba(width, height, limit, samples_per_axis, view_min_r, view_min_i, view_max_r, view_max_i, fractal_kind, julia_cr, julia_ci, band_workers);
    Image::WriteRGBA(output_path, width, height, pixels);
};

def output_dir = "D:/Xuexi/";

def width = 1920;
def height = 1080;
def limit = 320;
def samples_per_axis = 3;
def band_workers = 32;

def start = DateTime::NowUnixMillis();

IO::PrintLine("Rendering with " ++ (band_workers as Text) ++ " band workers per image...");

render_fractal_file(output_dir ++ "mandelbrot.png", width, height, limit, samples_per_axis, -2.5, -1.2, 1.0, 1.2, 0, 0.0, 0.0, band_workers);
IO::PrintLine("Mandelbrot done");
render_fractal_file(output_dir ++ "julia.png", width, height, limit, samples_per_axis, -1.8, -1.2, 1.8, 1.2, 1, -0.8, 0.156, band_workers);
IO::PrintLine("Julia done");
render_fractal_file(output_dir ++ "burning_ship.png", width, height, limit, samples_per_axis, -2.2, -2.5, 1.2, 1.2, 2, 0.0, 0.0, band_workers);
IO::PrintLine("Burning Ship done");
render_fractal_file(output_dir ++ "tricorn.png", width, height, limit, samples_per_axis, -2.2, -1.8, 1.2, 1.8, 3, 0.0, 0.0, band_workers);
IO::PrintLine("Tricorn done");
render_fractal_file(output_dir ++ "multibrot3.png", width, height, limit, samples_per_axis, -2.0, -1.5, 1.4, 1.5, 4, 0.0, 0.0, band_workers);
IO::PrintLine("Multibrot3 done");
render_fractal_file(output_dir ++ "multibrot4.png", width, height, limit, samples_per_axis, -2.0, -2.0, 2.0, 2.0, 5, 0.0, 0.0, band_workers);
IO::PrintLine("Multibrot4 done");
render_fractal_file(output_dir ++ "celtic.png", width, height, limit, samples_per_axis, -2.2, -1.8, 2.2, 1.8, 6, 0.0, 0.0, band_workers);
IO::PrintLine("Celtic done");

def end = DateTime::NowUnixMillis();

IO::PrintLine("All 7 fractals rendered in " ++ ((end - start) as Text) ++ "ms");
