module mandelbrot

import
{
	"../MidoriPrelude/IO.mdr",
    "../MidoriPrelude/Math.mdr",
    "../MidoriPrelude/DateTime.mdr",
    "../MidoriPrelude/Appendable.mdr"
}

type Complex =
{
    Real : Float,
    Imag : Float,
};

def complex_abs = fn(x : Complex) -> Float => Math::SquareRoot(x.Real * x.Real + x.Imag * x.Imag);
def complex_add = fn(a : Complex, b : Complex) -> Complex => Complex(a.Real + b.Real, a.Imag + b.Imag);
def complex_mul = fn(a : Complex, b : Complex) -> Complex => Complex(a.Real * b.Real - a.Imag * b.Imag, a.Real * b.Imag + a.Imag * b.Real);
def complex_square = fn(a : Complex) -> Complex => complex_mul(a, a);

def append_color = fn(buf : Text, iterations : Int, max_iterations: Int) -> Unit =>
{
    if iterations == max_iterations
    then Appendable::Append(buf, "0 0 0\n")
    else
    {
        def r = (iterations * 5) % 256;
        def g = (iterations * 10) % 256;
        def b = (iterations * 15) % 256;
        Appendable::Append(buf, (r as Text) ++ " " ++ (g as Text) ++ " " ++ (b as Text) ++ "\n");
    }
};

def ComputeMandelbrotBand = fn(ch : Channel<Text>, y_start : Int, y_end : Int, width : Int, height : Int, limit : Int) -> Int =>
{
    def band_data = "";
    def y = y_start;
    loop
    {
        def x = 0;
        loop
        {
            def c = Complex(-2.05 + (x as Float) * 2.6 / (width as Float), -1.2 + (y as Float) * 2.4 / (height as Float));
            def z = Complex(0.0, 0.0);
            def iterations = 0;
            loop
            {
                if iterations >= limit then break () else ();
                z = complex_add(complex_square(z), c);
                if complex_abs(z) >= 2.0 then break () else ();
                iterations = iterations + 1;
            };
            append_color(band_data, iterations, limit);
            x = x + 1;
            if x >= width then break () else ();
        };
        y = y + 1;
        if y >= y_end then break () else ();
    };

    ch -> band_data;
    0
};

def ComputeJuliaBand = fn(ch : Channel<Text>, y_start : Int, y_end : Int, width : Int, height : Int, limit : Int, c_real : Float, c_imag : Float) -> Int =>
{
    def c = Complex(c_real, c_imag);

    def real_min = -2.5;
    def real_max = 2.5;
    def imag_min = -1.2;
    def imag_max = 1.2;

    def band_data = "";
    def y = y_start;
    loop
    {
        def x = 0;
        loop
        {
            def real = real_min + (x as Float) / (width as Float) * (real_max - real_min);
            def imag = imag_min + (y as Float) / (height as Float) * (imag_max - imag_min);
            def z = Complex(real, imag);
            def iterations = 0;
            loop
            {
                if iterations >= limit then break () else ();
                z = complex_add(complex_square(z), c);
                if complex_abs(z) >= 2.0 then break () else ();
                iterations = iterations + 1;
            };
            append_color(band_data, iterations, limit);
            x = x + 1;
            if x >= width then break () else ();
        };
        y = y + 1;
        if y >= y_end then break () else ();
    };

    ch -> band_data;
    0
};

def parallel_mandelbrot_ppm = fn(width : Int, height : Int, limit : Int, num_workers : Int) -> Text =>
{
    def ppm_header = "P3\n" ++ (width as Text) ++ " " ++ (height as Text) ++ "\n255\n";
    def band_height = height / num_workers;

    def channels: Array<Channel<Text>> = [];
    def workers: Array<Worker> = [];

    def i = 0;
    loop
    {
        def ch = channel<Text>(1);
        channels = channels ++ [ch];
        def y_start = i * band_height;
        def y_end = if i == num_workers - 1 then height else (i + 1) * band_height;
        def w = spawn ComputeMandelbrotBand(ch, y_start, y_end, width, height, limit);
        workers = workers ++ [w];
        i = i + 1;
        if i >= num_workers then break () else ();
    };

    def ppm_data = "";
    def j = 0;
    loop
    {
        def band = <- channels[j];
        Appendable::Append(ppm_data, band);
        close(channels[j]);
        def result = join workers[j];
        j = j + 1;
        if j >= num_workers then break () else ();
    };

    ppm_header ++ ppm_data
};

def parallel_julia_ppm = fn(width : Int, height : Int, c_real : Float, c_imag : Float, limit : Int, num_workers : Int) -> Text =>
{
    def ppm_header = "P3\n" ++ (width as Text) ++ " " ++ (height as Text) ++ "\n255\n";
    def band_height = height / num_workers;

    def channels: Array<Channel<Text>> = [];
    def workers: Array<Worker> = [];

    def i = 0;
    loop
    {
        def ch = channel<Text>(1);
        channels = channels ++ [ch];
        def y_start = i * band_height;
        def y_end = if i == num_workers - 1 then height else (i + 1) * band_height;
        def w = spawn ComputeJuliaBand(ch, y_start, y_end, width, height, limit, c_real, c_imag);
        workers = workers ++ [w];
        i = i + 1;
        if i >= num_workers then break () else ();
    };

    def ppm_data = "";
    def j = 0;
    loop
    {
        def band = <- channels[j];
        Appendable::Append(ppm_data, band);
        close(channels[j]);
        def result = join workers[j];
        j = j + 1;
        if j >= num_workers then break () else ();
    };

    ppm_header ++ ppm_data
};

def limit = 20;
def num_workers = 4;

def start = DateTime::NowUnixMillis();

def mandelbrot_output = parallel_mandelbrot_ppm(1920, 1080, limit, num_workers);
def wrote_m = IO::TryWriteFile("D:/Xuexi/mandelbrot.ppm", mandelbrot_output);

def julia_output = parallel_julia_ppm(1920, 1080, -0.8, 0.156, limit, num_workers);
def wrote_j = IO::TryWriteFile("D:/Xuexi/julia.ppm", julia_output);

def end = DateTime::NowUnixMillis();

IO::PrintLine("Time: " ++ ((end - start) as Text));
