import
{
	"../MidoriPrelude/IO.mdr",
    "../MidoriPrelude/Math.mdr",
    "../MidoriPrelude/DateTime.mdr"
}

struct Complex 
{
    Real : Float,
    Imag : Float,
};

defun abs(x : Float) : Float => if x < 0.0 then -x else x;
defun complex_abs(x : Complex) : Float => Math::SquareRoot(x.Real * x.Real + x.Imag * x.Imag);
defun complex_add(a : Complex, b : Complex) : Complex => new Complex(a.Real + b.Real, a.Imag + b.Imag);
defun complex_mul(a : Complex, b : Complex) : Complex => new Complex(a.Real * b.Real - a.Imag * b.Imag, a.Real * b.Imag + a.Imag * b.Real);
defun complex_square(a : Complex) : Complex => complex_mul(a, a);

defun map_color(iterations : Int, max_iterations: Int) : Text =>
{
    if iterations == max_iterations 
    then "0 0 0\n" // Black (inside set)
    else 
    {
        // Simple color gradient (adjust as needed)
        def r = (iterations * 5) % 256;
        def g = (iterations * 10) % 256;
        def b = (iterations * 15) % 256;
        (r as Text) ++ " " ++ (g as Text) ++ " " ++ (b as Text) ++ "\n"
    }
};

defun mandelbrot_ppm(width : Int, height : Int, limit : Int) : Text =>
{
    def ppm_header = "P3\n" ++ (width as Text) ++ " " ++ (height as Text) ++ "\n255\n";
    def ppm_data = "";

    // Growable array/list so we never default-construct Future<Text>
    def row_tasks : Array<Future<Text>> = [];

    def y = 0;
    loop
    {
        def y_copy = y; // capture
        row_tasks ++= (async
        {
            def row_data = "";
            def x = 0;
            loop
            {
                def c = new Complex(-2.05 + (x as Float) * 2.6 / (width as Float),
                                    -1.2  + (y_copy as Float) * 2.4 / (height as Float));
                def z = new Complex(0.0, 0.0);
                def iterations = 0;
                loop
                {
                    if iterations >= limit then break () else ();
                    z = complex_add(complex_square(z), c);
                    if complex_abs(z) >= 2.0 then break () else ();
                    iterations = iterations + 1;
                };
                row_data ++= map_color(iterations, limit);

                x = x + 1;
                if x >= width then break () else ();
            };
            row_data
        });

        y = y + 1;
        if y >= height then break () else ();
    };

    // Deterministic output order: await rows in the same order we pushed them
    def i = 0;
    loop
    {
        ppm_data ++= await row_tasks[i];
        i = i + 1;
        if i >= height then break () else ();
    };

    ppm_header ++= ppm_data
};

def julia_ppm = fn(width : Int, height : Int, c : Complex, limit : Int) : Text =>
{
    def ppm_header = "P3\n" ++ (width as Text) ++ " " ++ (height as Text) ++ "\n255\n";
    def ppm_data = "";

    // Adjust these values to shift the Julia set
    def real_min = -2.5;  // Original: -2.05
    def real_max = 2.5;   // Original: 0.55
    def imag_min = -1.2;  // Original: -1.2
    def imag_max = 1.2;   // Original: 1.2

    // Growable array/list so we never default-construct Future<Text>
    def row_tasks : Array<Future<Text>> = [];

    def y = 0;
    loop
    {
        def y_copy = y; // capture
        row_tasks ++= (async
        {
            def row_data = "";
            def x = 0;
            loop
            {
                def real = real_min + (x as Float) / (width as Float) * (real_max - real_min);
                def imag = imag_min + (y_copy as Float) / (height as Float) * (imag_max - imag_min);
                def z = new Complex(real, imag);

                def iterations = 0;
                loop
                {
                    if iterations >= limit then break () else ();
                    z = complex_add(complex_square(z), c);
                    if complex_abs(z) >= 2.0 then break () else ();
                    iterations = iterations + 1;
                };

                row_data ++= map_color(iterations, limit);

                x = x + 1;
                if x >= width then break () else ();
            };
            row_data
        });

        y = y + 1;
        if y >= height then break () else ();
    };

    // Deterministic output order: await rows in the same order we pushed them
    def i = 0;
    loop
    {
        ppm_data ++= await row_tasks[i];
        i = i + 1;
        if i >= height then break () else ();
    };

    ppm_header ++= ppm_data
};

def julia_constant = new Complex(-0.8, 0.156); // Rabbit constant
def limit = 20;

def start = DateTime::GetTime();

def mandelbrot_output = mandelbrot_ppm(1920, 1080, limit);
IO::WriteFile("D:/Xuexi/mandelbrot.ppm", mandelbrot_output);

def julia_output = julia_ppm(1920, 1080, julia_constant, limit);
IO::WriteFile("D:/Xuexi/julia.ppm", julia_output);

def end = DateTime::GetTime();

IO::PrintLine("Time: " ++ ((end - start) as Text));