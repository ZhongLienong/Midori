module reaction_diffusion

import
{
    "../MidoriPrelude/IO.mdr",
    "../MidoriPrelude/Math.mdr",
    "../MidoriPrelude/DateTime.mdr",
    "../MidoriPrelude/Appendable.mdr",
    <Image>
}

struct GrayScottParams
{
    Feed : Float,
    Kill : Float,
    DiffuseA : Float,
    DiffuseB : Float,
    Dt : Float,
};

defun make_grid(width : Int, height : Int, fill : Float) -> Array<Float> =>
{
    def grid : Array<Float> = [];
    def total = width * height;
    def i = 0;
    loop
    {
        if i >= total then break () else ();
        Appendable::Append(grid, fill);
        i = i + 1;
    };
    grid
};

defun seed_square(grid : Array<Float>, width : Int, height : Int, cx : Int, cy : Int, radius : Int, value : Float) -> Unit =>
{
    def y = cy - radius;
    loop
    {
        if y > cy + radius then break () else ();
        def x = cx - radius;
        loop
        {
            if x > cx + radius then break () else ();
            if x >= 0 && x < width && y >= 0 && y < height
            then { grid[y * width + x] = value; () }
            else ();
            x = x + 1;
        };
        y = y + 1;
    };
};

defun seed_circle(grid : Array<Float>, width : Int, height : Int, cx : Int, cy : Int, radius : Int, value : Float) -> Unit =>
{
    def r2 = radius * radius;
    def y = cy - radius;
    loop
    {
        if y > cy + radius then break () else ();
        def x = cx - radius;
        loop
        {
            if x > cx + radius then break () else ();
            def dx = x - cx;
            def dy = y - cy;
            if dx * dx + dy * dy <= r2 && x >= 0 && x < width && y >= 0 && y < height
            then { grid[y * width + x] = value; () }
            else ();
            x = x + 1;
        };
        y = y + 1;
    };
};

defun laplacian(grid : Array<Float>, width : Int, height : Int, x : Int, y : Int) -> Float =>
{
    def xm = if x > 0 then x - 1 else width - 1;
    def xp = if x < width - 1 then x + 1 else 0;
    def ym = if y > 0 then y - 1 else height - 1;
    def yp = if y < height - 1 then y + 1 else 0;
    def center = grid[y * width + x];
    def neighbors =
        grid[y * width + xm] +
        grid[y * width + xp] +
        grid[ym * width + x] +
        grid[yp * width + x];
    def diagonals =
        grid[ym * width + xm] +
        grid[ym * width + xp] +
        grid[yp * width + xm] +
        grid[yp * width + xp];
    neighbors * 0.2 + diagonals * 0.05 - center
};

defun step_simulation(grid_a : Array<Float>, grid_b : Array<Float>, next_a : Array<Float>, next_b : Array<Float>, width : Int, height : Int, params : GrayScottParams) -> Unit =>
{
    def y = 0;
    loop
    {
        if y >= height then break () else ();
        def x = 0;
        loop
        {
            if x >= width then break () else ();
            def idx = y * width + x;
            def a = grid_a[idx];
            def b = grid_b[idx];
            def lap_a = laplacian(grid_a, width, height, x, y);
            def lap_b = laplacian(grid_b, width, height, x, y);
            def abb = a * b * b;
            def new_a = a + (params.DiffuseA * lap_a - abb + params.Feed * (1.0 - a)) * params.Dt;
            def new_b = b + (params.DiffuseB * lap_b + abb - (params.Kill + params.Feed) * b) * params.Dt;
            next_a[idx] = Math::Clamp(new_a, 0.0, 1.0);
            next_b[idx] = Math::Clamp(new_b, 0.0, 1.0);
            x = x + 1;
        };
        y = y + 1;
    };
};

defun copy_grid(src : Array<Float>, dst : Array<Float>, size : Int) -> Unit =>
{
    def i = 0;
    loop
    {
        if i >= size then break () else ();
        dst[i] = src[i];
        i = i + 1;
    };
};

struct Vec3
{
    X : Float,
    Y : Float,
    Z : Float,
};

defun color_map(a : Float, b : Float) -> Vec3 =>
{
    def t = Math::Clamp(b, 0.0, 1.0);
    def inv_t = 1.0 - t;
    def r = inv_t * 0.05 + t * 0.15;
    def g = inv_t * 0.10 + t * 0.45;
    def blue = inv_t * 0.20 + t * 0.80;

    def highlight = Math::Pow(t, 3.0);
    def fr = r + highlight * 0.6;
    def fg = g + highlight * 0.3;
    def fb = blue + highlight * 0.1;
    new Vec3(Math::Clamp(fr, 0.0, 1.0), Math::Clamp(fg, 0.0, 1.0), Math::Clamp(fb, 0.0, 1.0))
};

defun append_color_rgba(pixels : Array<Int>, cr : Float, cg : Float, cb : Float) -> Unit =>
{
    def r = Math::Clamp(Math::Round(cr * 255.0), 0.0, 255.0) as Int;
    def g = Math::Clamp(Math::Round(cg * 255.0), 0.0, 255.0) as Int;
    def b = Math::Clamp(Math::Round(cb * 255.0), 0.0, 255.0) as Int;
    Appendable::Append(pixels, r);
    Appendable::Append(pixels, g);
    Appendable::Append(pixels, b);
    Appendable::Append(pixels, 255);
};

defun grid_to_pixels(grid_a : Array<Float>, grid_b : Array<Float>, width : Int, height : Int) -> Array<Int> =>
{
    def pixels : Array<Int> = [];
    def i = 0;
    def total = width * height;
    loop
    {
        if i >= total then break () else ();
        def color = color_map(grid_a[i], grid_b[i]);
        append_color_rgba(pixels, color.X, color.Y, color.Z);
        i = i + 1;
    };
    pixels
};

def output_dir = "D:/Xuexi/";
def width = 512;
def height = 512;
def iterations = 8000;

def start = DateTime::NowUnixMillis();
IO::PrintLine("Running Gray-Scott reaction-diffusion (" ++ (iterations as Text) ++ " steps)...");

def params = new GrayScottParams(0.055, 0.062, 1.0, 0.5, 1.0);

def grid_a = make_grid(width, height, 1.0);
def grid_b = make_grid(width, height, 0.0);
def next_a = make_grid(width, height, 1.0);
def next_b = make_grid(width, height, 0.0);

seed_circle(grid_b, width, height, 256, 256, 20, 1.0);
seed_circle(grid_b, width, height, 180, 180, 12, 1.0);
seed_circle(grid_b, width, height, 330, 200, 15, 1.0);
seed_circle(grid_b, width, height, 200, 340, 10, 1.0);
seed_circle(grid_b, width, height, 350, 350, 18, 1.0);
seed_circle(grid_b, width, height, 128, 300, 14, 1.0);
seed_circle(grid_b, width, height, 400, 128, 11, 1.0);

def total = width * height;
def step = 0;
loop
{
    if step >= iterations then break () else ();
    step_simulation(grid_a, grid_b, next_a, next_b, width, height, params);
    copy_grid(next_a, grid_a, total);
    copy_grid(next_b, grid_b, total);
    step = step + 1;
    if step % 1000 == 0
    then IO::PrintLine("  step " ++ (step as Text) ++ " / " ++ (iterations as Text))
    else ();
};

def pixels = grid_to_pixels(grid_a, grid_b, width, height);
Image::WriteRGBA(output_dir ++ "reaction_diffusion.png", width, height, pixels);

def end = DateTime::NowUnixMillis();
IO::PrintLine("Reaction-diffusion rendered in " ++ ((end - start) as Text) ++ "ms");
