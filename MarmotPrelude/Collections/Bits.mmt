module Bits
public export { PopCount, BitAt, HasBit, SparseIndex, HashChunk, ChunkBits, BranchFactor, MaxDepth }

// Five bits per level, so 32 children and a bitmap that stays clear of the sign
// bit of a 64-bit signed Int.
def ChunkBits : Int = 5;
def BranchFactor : Int = 32;
def MaxDepth : Int = 12;

def BitAt = fn(index: Int) -> Int => 1 << index;

def HasBit = fn(bitmap: Int, index: Int) -> Bool => ((bitmap >> index) & 1) == 1;

// Counts over a fixed 32-bit window rather than shifting until zero: an
// arithmetic right shift of a negative value never reaches zero.
def PopCountFrom = fn(value: Int, bit: Int) -> Int =>
    if bit >= BranchFactor then 0 else ((value >> bit) & 1) + PopCountFrom(value, bit + 1);

def PopCount = fn(value: Int) -> Int => PopCountFrom(value, 0);

// Where a child sits in the sparse array: the number of occupied slots below it.
def SparseIndex = fn(bitmap: Int, index: Int) -> Int => PopCount(bitmap & (BitAt(index) - 1));

def HashChunk = fn(hash: Int, depth: Int) -> Int => (hash >> (depth * ChunkBits)) & (BranchFactor - 1);
