module Equatable
public export { Equatable }
class Equatable < T > {
    Equals: fn(a: T, b: T) -> Bool;
};
instance Equatable < Int > {
    def Equals = fn(a: Int, b: Int) -> Bool => a == b;
};
instance Equatable < Float > {
    def Equals = fn(a: Float, b: Float) -> Bool => a == b;
};
instance Equatable < Text > {
    def Equals = fn(a: Text, b: Text) -> Bool => a == b;
};
instance Equatable < Bool > {
    def Equals = fn(a: Bool, b: Bool) -> Bool => a == b;
};
instance Equatable < Byte > {
    def Equals = fn(a: Byte, b: Byte) -> Bool => a == b;
};
instance Equatable < Word > {
    def Equals = fn(a: Word, b: Word) -> Bool => a == b;
};
