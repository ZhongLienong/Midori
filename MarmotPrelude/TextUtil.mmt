module TextUtil
public export { Length, Contains, Substring, Split, Replace, Trim, Reverse }
foreign "MIDORI_FFI_TextLength" TextLengthRaw: fn(Text) -> Int;
foreign "MIDORI_FFI_TextSubstring" TextSubstringRaw: fn(Text, Int, Int) -> Text;
foreign "MIDORI_FFI_TextSplit" TextSplitRaw: fn(Text, Text) -> Array < Text >;
foreign "MIDORI_FFI_TextReverse" TextReverseRaw: fn(Text) -> Text;
foreign "MIDORI_FFI_TextContains" TextContainsRaw: fn(Text, Text) -> Bool;
foreign "MIDORI_FFI_TextReplace" TextReplaceRaw: fn(Text, Text, Text) -> Text;
foreign "MIDORI_FFI_TextTrim" TextTrimRaw: fn(Text) -> Text;
def Length = fn(text: Text) -> Int => TextLengthRaw(text);
def Contains = fn(text: Text, substring: Text) -> Bool => TextContainsRaw(text, substring);
def Substring = fn(text: Text, start: Int, end: Int) -> Text => TextSubstringRaw(text, start, end);
def Split = fn(text: Text, delimiter: Text) -> Array < Text > => TextSplitRaw(text, delimiter);
def Replace = fn(text: Text, target: Text, replacement: Text) -> Text => TextReplaceRaw(text, target, replacement);
def Trim = fn(text: Text) -> Text => TextTrimRaw(text);
def Reverse = fn(text: Text) -> Text => TextReverseRaw(text);
