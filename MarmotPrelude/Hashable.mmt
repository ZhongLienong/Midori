module Hashable
public export { Hashable }
class Hashable < T > {
    Hash: fn(value: T) -> Int;
};
instance Hashable < Int > {
    def Hash = fn(value: Int) -> Int => value;
};
instance Hashable < Bool > {
    def Hash = fn(value: Bool) -> Int => if value then 1 else 0;
};
instance Hashable < Byte > {
    def Hash = fn(value: Byte) -> Int => value as Int;
};
instance Hashable < Word > {
    def Hash = fn(value: Word) -> Int => value as Int;
};
foreign "MIDORI_FFI_HashText" HashText: fn(Text) -> Int;
instance Hashable < Text > {
    def Hash = fn(value: Text) -> Int => HashText(value);
};
foreign "MIDORI_FFI_HashFloat" HashFloat: fn(Float) -> Int;
instance Hashable < Float > {
    def Hash = fn(value: Float) -> Int => HashFloat(value);
};
