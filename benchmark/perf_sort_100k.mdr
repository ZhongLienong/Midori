module PerfSort100k

import
{
	"../MidoriPrelude/Appendable.mdr",
	"../MidoriPrelude/IO.mdr",
	"../MidoriPrelude/DateTime.mdr"
}

defun QuickSort(arr : Array<Int>, len : Int) -> Array<Int> =>
{
	if len <= 1
	then arr
	else
	{
		def pivot = arr[len / 2];
		def less : Array<Int> = [];
		def less_len = 0;
		def equal : Array<Int> = [];
		def greater : Array<Int> = [];
		def greater_len = 0;

		def i = 0;
		loop
		{
			if i >= len
			then break ()
			else
			{
				def val = arr[i];
				if val < pivot
				then
				{
					Appendable::Append(less, val);
					less_len += 1;
				}
				else
				{
					if val == pivot
					then Appendable::Append(equal, val)
					else
					{
						Appendable::Append(greater, val);
						greater_len += 1;
					}
				};
				i += 1;
			}
		};

		QuickSort(less, less_len) ++ equal ++ QuickSort(greater, greater_len)
	}
};

def start = DateTime::NowUnixMillis();

def test_array : Array<Int> = [];
def array_len = 0;
def i = 100000;
loop
{
	if i <= 0
	then break ()
	else
	{
		Appendable::Append(test_array, i);
		array_len += 1;
		i -= 1;
	}
};

def sorted = QuickSort(test_array, array_len);

def end = DateTime::NowUnixMillis();

IO::PrintLine("Sort100k: " ++ (sorted[0] as Text) ++ " benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
