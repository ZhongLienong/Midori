module GenericCallInInstanceLib
import { "./generic-call-in-instance-class.mdr" }
public export { H, MakeH }

type H < T > = { v: T };
def MakeH = fn() -> H < Int > => H (9);

def GenericT = fn < T >(x: T, n: Int) -> Int => n;

instance G < H < Int >> {
    def Gg = fn(h: H < Int >) -> Int => GenericT(1, 4);
};
