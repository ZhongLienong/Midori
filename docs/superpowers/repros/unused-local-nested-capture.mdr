module UnusedLocalNestedCapture

// Warns "Binding 'total' is never read" for `c` but not `d`, though both read
// `total` on the next line. Diagnostic-only: both evaluate to 4.
// See unused-local-false-positive-nested-capture.md. Fixed.

def c = fn(p : Int) -> fn(Int) -> fn() -> Int =>
	fn(v : Int) -> fn() -> Int =>
	{
		def total = v + 1;
		fn() -> Int => total
	};

def d = fn(v : Int) -> fn() -> Int =>
{
	def total = v + 1;
	fn() -> Int => total
};

def main = fn() -> Int => c(5)(3)() + d(3)();
