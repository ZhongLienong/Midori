module ForBreakValueUnreached

import { "../../../MidoriPrelude/IO.mdr" }

// A `for` whose `break` carries a value yields that value -- but when the loop
// finishes without breaking, the result is an uninitialised slot.
//   Int  -> prints 0, exit 0. A silently wrong answer.
//   Text -> panic[MemoryAccessViolation], exit 2.
// There is no way to tell "found 0" from "never found".

def found = for i in 0..1..10 { if i * i > 30 then break i else (); };
IO::PrintLine(found as Text);          // 6 -- correct

def missing = for i in 0..1..3 { if i > 100 then break i else (); };
IO::PrintLine(missing as Text);        // 0 -- wrong, and silent

def crash = for i in 0..1..3 { if i > 100 then break "found" else (); };
IO::PrintLine("[" ++ crash ++ "]");    // MemoryAccessViolation
