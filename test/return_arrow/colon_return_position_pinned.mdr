module ColonReturnPositionPinned

// PINNED: this file deliberately keeps ':' in return position while the rest of
// the corpus uses '->'. Removing ':' from return position is a separate plan;
// until that plan lands, this test is what catches an accidental early removal.
// Do not migrate it to '->'.

import { "../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

defun Twice(x: Int) : Int => x * 2;

def Add = fn(a: Int, b: Int) : Int => a + b;

defun Length<T>(array: Array<T>) : Int => #array;

PrintLine(Twice(21) as Text);
PrintLine(Add(1, 2) as Text);
PrintLine(Length([1, 2, 3]) as Text);
