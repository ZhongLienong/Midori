module ArrowDefunAndLambda

import { "../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

def Twice = fn(x: Int) -> Int => x * 2;

def Add = fn(a: Int, b: Int) -> Int => a + b;

def Nested = fn(x: Int) -> Int => {
    def inner = fn(y: Int) -> Int => y + 1;
    inner(x)
};

def Inferred = fn(x: Int) => x - 1;

PrintLine(Twice(21) as Text);
PrintLine(Add(1, 2) as Text);
PrintLine(Nested(9) as Text);
PrintLine(Inferred(11) as Text);
