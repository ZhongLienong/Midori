module ColonReturnPositionRemovedInstance

// The same removal at the other site that parses a return type: the definition of
// an instance method. The class member above it is a function *type*, so its '->'
// is unrelated and stays where it is.

class Show<T> {
    show: fn(value: T) -> Text;
};

instance Show<Int> {
    def show = fn(value: Int) : Text => value as Text;
};

Show::show(3);
