module ArrowAndFunctionTypeAnnotation

import { "../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

// The `->` in the annotation belongs to the function type; the `->` after the
// parameter list is the lambda's own return position.
def Predicate : fn(Int) -> Bool = fn(x: Int) -> Bool => x > 0;

defun Apply(f: fn(Int) -> Int, x: Int) -> Int => f(x);

defun SendOne(c: Channel<Text>) -> Int => { c -> "sent"; 0 };

def ch = channel<Text>(4);
def sent = SendOne(ch);
PrintLine(<- ch);
close(ch);

PrintLine(if Predicate(3) then "positive" else "not positive");
PrintLine(Apply(fn(x: Int) -> Int => x * 3, 5) as Text);
PrintLine(sent as Text);
