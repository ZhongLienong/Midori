module ArrowGenericAndConstrained

import { "../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

class Show<T> {
    show: fn(value: T) -> Text;
};

struct Boxed<T> { item: T };

instance Show<Int> {
    defun show(value: Int) -> Text => "Int(" ++ (value as Text) ++ ")";
};

instance Show<Boxed<T>> where Show<T> {
    defun show(value: Boxed<T>) -> Text => "Boxed(" ++ Show::show(value.item) ++ ")";
};

defun Length<T>(array: Array<T>) -> Int => #array;

def Append = fn<T>(array: Array<T>, value: T) -> Array<T> => array ++ [value];

def Describe = fn<T>(value: T) -> Text where Show<T> => Show::show(value);

def inner = new Boxed<Int>(7);
PrintLine(Show::show(inner));
PrintLine(Length([1, 2, 3]) as Text);
PrintLine(Length(Append([1, 2], 3)) as Text);
PrintLine(Describe(5));
