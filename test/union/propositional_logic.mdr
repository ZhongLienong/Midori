module PropositionalLogic

import
{
	"../../MidoriPrelude/IO.mdr",
}

type LogicExpr =
    Var(Text)
  | And(LogicExpr, LogicExpr)
  | Or(LogicExpr, LogicExpr)
  | Not(LogicExpr)
;

def Evaluate = fn(expr : LogicExpr, env : fn(Text) -> Bool) -> Bool =>
    match expr with
        case LogicExpr::Var(name) => env(name)
        case LogicExpr::And(left, right) => Evaluate(left, env) && Evaluate(right, env)
        case LogicExpr::Or(left, right) => Evaluate(left, env) || Evaluate(right, env)
        case LogicExpr::Not(inner) => !Evaluate(inner, env)
;

// Helper function to print axiom/fact description and its evaluation
def PrintAxiomEvaluation = fn(axiom_description : Text, expr_obj : LogicExpr, environment : fn(Text) -> Bool, bool_to_string_fn : fn(Bool) -> Text) -> Unit =>
{
    def actual_bool = Evaluate(expr_obj, environment);
    def actual_str = bool_to_string_fn(actual_bool);
    IO::PrintLine(axiom_description ++ "  =>  Evaluated: " ++ actual_str);
};

// Helper function to print test case results
def PrintTestResult = fn(case_name : Text, expr_as_string : Text, expr_obj : LogicExpr, expected_bool : Bool, environment : fn(Text) -> Bool, bool_to_string_fn : fn(Bool) -> Text) -> Unit =>
{
    def actual_bool = Evaluate(expr_obj, environment);
    def actual_str = bool_to_string_fn(actual_bool);
    def expected_str = bool_to_string_fn(expected_bool);
    IO::PrintLine
    (
        case_name ++ " (" ++ expr_as_string ++ "): Evaluated: " ++ actual_str ++
        ", Expected: " ++ expected_str ++
        (if actual_bool && expected_bool then " (PASS)" else " (FAIL)")
    );
};

// Environment: mapping variables to boolean values
def env = fn(name : Text) -> Bool =>
{
    if name == "A" then true
    else if name == "B" then false
    else if name == "C" then true
    // Variables like D, E, etc., are not explicitly defined, will default to false
    else false // default false
};

// Local helper to convert boolean to text for printing
def bool_to_text_local : fn(Bool) -> Text = fn(b : Bool) -> Text => if b then "true" else "false";

IO::PrintLine("--- Environment ---");
IO::PrintLine("  A = " ++ bool_to_text_local(env("A")));
IO::PrintLine("  B = " ++ bool_to_text_local(env("B")));
IO::PrintLine("  C = " ++ bool_to_text_local(env("C")));
IO::PrintLine("  D (default for undefined vars) = " ++ bool_to_text_local(env("D")));
IO::PrintLine("");

IO::PrintLine("--- Axioms / Key Facts (Evaluated in the Current Environment) ---");

// Fact 1: Value of A
PrintAxiomEvaluation("Fact 1: A", LogicExpr::Var("A"), env, bool_to_text_local);
// Fact 2: Value of NOT B
PrintAxiomEvaluation("Fact 2: NOT B", LogicExpr::Not(LogicExpr::Var("B")), env, bool_to_text_local);

// Axiom 3: Law of Excluded Middle (for A) - Should always be true
def axiom3_expr = LogicExpr::Or(LogicExpr::Var("A"), LogicExpr::Not(LogicExpr::Var("A")));
PrintAxiomEvaluation("Axiom 3 (Law of Excluded Middle): A OR (NOT A)", axiom3_expr, env, bool_to_text_local);

// Axiom 4: Principle of Non-Contradiction (for B) - Should always be true
def axiom4_expr = LogicExpr::Not(LogicExpr::And(LogicExpr::Var("B"), LogicExpr::Not(LogicExpr::Var("B"))));
PrintAxiomEvaluation("Axiom 4 (Non-Contradiction): NOT (B AND (NOT B))", axiom4_expr, env, bool_to_text_local);

// Fact 5: A specific compound statement: (A AND C)
def fact5_expr = LogicExpr::And(LogicExpr::Var("A"), LogicExpr::Var("C"));
PrintAxiomEvaluation("Fact 5: A AND C", fact5_expr, env, bool_to_text_local);

// Fact 6: Implication: A -> B (equivalent to (NOT A) OR B)
def fact6_expr = LogicExpr::Or(LogicExpr::Not(LogicExpr::Var("A")), LogicExpr::Var("B"));
PrintAxiomEvaluation("Fact 6 (Implication): A -> B (i.e., (NOT A) OR B)", fact6_expr, env, bool_to_text_local);

// Fact 7: Implication: B -> C (equivalent to (NOT B) OR C)
def fact7_expr = LogicExpr::Or(LogicExpr::Not(LogicExpr::Var("B")), LogicExpr::Var("C"));
PrintAxiomEvaluation("Fact 7 (Implication): B -> C (i.e., (NOT B) OR C)", fact7_expr, env, bool_to_text_local);

IO::PrintLine("");
IO::PrintLine("--- Specific Test Cases (with Expected Outcomes) ---");

// Test Case 1: Original Expression
def expr1 = LogicExpr::Or(LogicExpr::And(LogicExpr::Var("A"), LogicExpr::Not(LogicExpr::Var("B"))), LogicExpr::Var("C"));
PrintTestResult("Test 1", "(A AND NOT B) OR C", expr1, true, env, bool_to_text_local);

// Test Case 2: NOT A
def expr2 = LogicExpr::Not(LogicExpr::Var("A"));
PrintTestResult("Test 2", "NOT A", expr2, false, env, bool_to_text_local);

// Test Case 3: A OR B
def expr3 = LogicExpr::Or(LogicExpr::Var("A"), LogicExpr::Var("B"));
PrintTestResult("Test 3", "A OR B", expr3, true, env, bool_to_text_local);

// Test Case 4: A AND B
def expr4 = LogicExpr::And(LogicExpr::Var("A"), LogicExpr::Var("B"));
PrintTestResult("Test 4", "A AND B", expr4, false, env, bool_to_text_local);

// Test Case 5: (NOT A) OR (NOT C)
def expr5 = LogicExpr::Or(LogicExpr::Not(LogicExpr::Var("A")), LogicExpr::Not(LogicExpr::Var("C")));
PrintTestResult("Test 5", "(NOT A) OR (NOT C)", expr5, false, env, bool_to_text_local);

// Test Case 6: B OR (NOT C AND A)
def expr6 = LogicExpr::Or(LogicExpr::Var("B"), LogicExpr::And(LogicExpr::Not(LogicExpr::Var("C")), LogicExpr::Var("A")));
PrintTestResult("Test 6", "B OR (NOT C AND A)", expr6, false, env, bool_to_text_local);

// Test Case 7: NOT (NOT B)
def expr7 = LogicExpr::Not(LogicExpr::Not(LogicExpr::Var("B")));
PrintTestResult("Test 7", "NOT (NOT B)", expr7, false, env, bool_to_text_local);

// Test Case 8: A AND D (D is undefined, defaults to false)
def expr8 = LogicExpr::And(LogicExpr::Var("A"), LogicExpr::Var("D"));
PrintTestResult("Test 8", "A AND D", expr8, false, env, bool_to_text_local);

// Test Case 9: (A OR D) AND (C OR B)
def expr9 = LogicExpr::And(LogicExpr::Or(LogicExpr::Var("A"), LogicExpr::Var("D")), LogicExpr::Or(LogicExpr::Var("C"), LogicExpr::Var("B")));
PrintTestResult("Test 9", "(A OR D) AND (C OR B)", expr9, true, env, bool_to_text_local);

// Test Case 10: NOT (A AND C)
def expr10 = LogicExpr::Not(LogicExpr::And(LogicExpr::Var("A"), LogicExpr::Var("C")));
PrintTestResult("Test 10", "NOT (A AND C)", expr10, false, env, bool_to_text_local);

// Test Case 11: De Morgan's Law Example: NOT (A OR B) <=> (NOT A) AND (NOT B)
def expr11_lhs = LogicExpr::Not(LogicExpr::Or(LogicExpr::Var("A"), LogicExpr::Var("B")));
PrintTestResult("Test 11a (De Morgan LHS)", "NOT (A OR B)", expr11_lhs, false, env, bool_to_text_local);
def expr11_rhs = LogicExpr::And(LogicExpr::Not(LogicExpr::Var("A")), LogicExpr::Not(LogicExpr::Var("B")));
PrintTestResult("Test 11b (De Morgan RHS)", "(NOT A) AND (NOT B)", expr11_rhs, false, env, bool_to_text_local);

// Test Case 12: Variable D (undefined) in OR: B OR D
def expr12 = LogicExpr::Or(LogicExpr::Var("B"), LogicExpr::Var("D"));
PrintTestResult("Test 12", "B OR D", expr12, false, env, bool_to_text_local);

// Test Case 13: Variable D (undefined) in NOT: NOT D
def expr13 = LogicExpr::Not(LogicExpr::Var("D"));
PrintTestResult("Test 13", "NOT D", expr13, true, env, bool_to_text_local);