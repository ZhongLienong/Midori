module NestedCase

import
{
	"../../MidoriPrelude/IO.mdr",
}

struct S1
{
};

union U1 = A(Int) | B | C(Float, Int, Text) | D(U1) | E(S1);

def z = U1::D(U1::D(U1::E(S1())));

union Inner = A | B(U1);

def zz = Inner::A();

def sssw = match z with
	case U1::D(u) => IO::PrintLine("D")
	default => IO::PrintLine("Outer default case")
;