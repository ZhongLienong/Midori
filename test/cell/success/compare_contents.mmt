module CellCompareContents

import
{
	"../../../MarmotPrelude/IO.mmt",
	"../../../MarmotPrelude/Cell.mmt"
}

// Cells have no equality of their own; compare what they hold.

def a = Cell::New(1);
def b = Cell::New(1);
def same_contents = Cell::Get(a) == Cell::Get(b);
IO::PrintLine(if same_contents then "true" else "false");
