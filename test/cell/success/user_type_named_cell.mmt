module UserTypeNamedCell

import
{
	"../../../MarmotPrelude/IO.mmt",
	"../../../MarmotPrelude/Cell.mmt"
}

// Cell is not a keyword: a program may declare its own type named Cell, and its
// own type wins over the built-in one even when Cell.mmt is imported.

type Cell<T> = { row: Int, value: T };

def spreadsheet_cell : Cell<Text> = Cell(3, "total");
IO::PrintLine((spreadsheet_cell.row as Text) ++ " " ++ spreadsheet_cell.value);
