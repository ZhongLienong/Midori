// Library module that exports type aliases

module TypeAliasLib
public export { UserId, Name, Point, Position, createPoint, getUserId }

// Type aliases for primitives
alias UserId = Int;
alias Name = Text;

// Struct definition
type Point =
{
    x: Float,
    y: Float
};

// Type alias for struct
alias Position = Point;

// Functions using type aliases
def createPoint = fn(x: Float, y: Float) -> Position => Point(x, y);

def getUserId = fn() -> UserId => 42;
