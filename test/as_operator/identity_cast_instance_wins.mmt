module IdentityCastInstanceWins

// A user-defined Convertable<T, T> instance still takes priority over the
// identity no-op, so `x as T` dispatches to Convert instead of being erased.

import
{
	"../../MarmotPrelude/IO.mmt"
}

class Convertable<From, To>
{
	Convert: fn(value: From) -> To;
};

instance Convertable<Text, Text>
{
	def Convert = fn(value: Text) -> Text => value ++ "!";
};

def shouted = "hello" as Text;

IO::PrintLine(shouted);
