module TypeDeclarationSum

// Test: `type X = A | B(T)` declares a sum.
// Expected: identical to the `union X = A | B(T)` it lowers to - variants are
// namespaced under the type name, and recursive variants can name the type.

import
{
	"../../../MidoriPrelude/IO.mdr"
}

type Shape = Dot | Line(Int) | Box(Int, Int);

// Recursive: a variant naming the type being declared.
type IntList = Nil | Cons(Int, IntList);

def Area = fn(s: Shape) -> Int =>
	match s with
		case Shape::Dot => 0
		case Shape::Line(n) => n
		case Shape::Box(w, h) => w * h
;

def SumList = fn(l: IntList) -> Int =>
	match l with
		case IntList::Nil => 0
		case IntList::Cons(x, rest) => x + SumList(rest)
;

def numbers = new IntList::Cons(1, new IntList::Cons(2, new IntList::Cons(3, new IntList::Nil())));

IO::PrintLine("dot=" ++ (Area(new Shape::Dot()) as Text));
IO::PrintLine("line=" ++ (Area(new Shape::Line(7)) as Text));
IO::PrintLine("box=" ++ (Area(new Shape::Box(3, 4)) as Text));
IO::PrintLine("list=" ++ (SumList(numbers) as Text));
