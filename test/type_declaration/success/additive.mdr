module TypeDeclarationAdditive

// Test: the new forms are purely additive.
// Expected: `struct`, `union`, `type` and `alias` all coexist in one file, and
// values flow between a `struct`-declared type and a `type`-declared one freely,
// because both produce the same AST node and the same MidoriType.

import
{
	"../../../MidoriPrelude/IO.mdr"
}

struct OldPoint
{
	x: Int,
	y: Int
};

type NewPoint = { x: Int, y: Int };

union OldFlag = Off | On(Int);

type NewFlag = Off | On(Int);

// `alias` stays transparent: Meters and Int are the same type, so a raw Int is
// accepted where Meters is declared.
alias Meters = Int;

def OldSum = fn(p: OldPoint) -> Int => p.x + p.y;
def NewSum = fn(p: NewPoint) -> Int => p.x + p.y;

def DescribeOld = fn(f: OldFlag) -> Int =>
	match f with
		case OldFlag::Off => 0
		case OldFlag::On(n) => n
;

def Describe = fn(f: NewFlag) -> Int =>
	match f with
		case NewFlag::Off => 0
		case NewFlag::On(n) => n
;

def TakesMeters = fn(m: Meters) -> Int => m;

def raw: Int = 12;
def distance: Meters = 30;

IO::PrintLine("old=" ++ (OldSum(OldPoint(1, 2)) as Text));
IO::PrintLine("new=" ++ (NewSum(NewPoint(3, 4)) as Text));
IO::PrintLine("old_flag=" ++ (DescribeOld(OldFlag::On(5)) as Text));
IO::PrintLine("new_flag=" ++ (Describe(NewFlag::On(9)) as Text));
IO::PrintLine("alias_transparent=" ++ (TakesMeters(raw) as Text));
IO::PrintLine("alias_annotated=" ++ (TakesMeters(distance) as Text));
