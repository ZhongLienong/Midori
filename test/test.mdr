import 
{
	"../MidoriPrelude/IO.mdr",
	"../MidoriPrelude/DateTime.mdr"
}

def TestPrimeNumbers : () -> Unit = fn() ->
{
	def IsPrime : (Int) -> Bool = fn(n) ->
	{
		def IsPrimeHelper : (Int, Int) -> Bool = fn(n, divisor) ->
		{
			if divisor * divisor > n
			then true
			else
			{
				if n % divisor == 0
				then false
				else IsPrimeHelper(n, divisor + 1)
			}
		};

		if n <= 1 then false else IsPrimeHelper(n, 2)
	};

	def start = DateTime::GetTime();

	def prime_count = 0;
	def count = 0;
	loop
	{
		if count >= 100000
		then break ()
		else
		{
			if IsPrime(count)
			then
			{
				prime_count = prime_count + 1;
			}
			else ();
			count = count + 1;
		}
	};

	def end = DateTime::GetTime();

	IO::PrintLine("Prime(100000): " ++ (prime_count as Text) ++ " benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
};

def TestFib : () -> Unit = fn() ->
{

	def fib : (Int) -> Int = fn(n) -> if n <= 1 then n else fib(n - 1) + fib(n - 2);

	def start = DateTime::GetTime();

	def fib_35 = fib(35);

	def end = DateTime::GetTime();

	IO::PrintLine("Fibonacci(35): " ++ (fib_35 as Text) ++ " benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
};

def TestStringManipulation : () -> Unit = fn() ->
{
    def start = DateTime::GetTime();

    def test_string = "";
	def count = 0;
	loop
	{
		if count >= 10000
		then break ()
		else
		{
			test_string = test_string ++ "a";
			count = count + 1;
		}
	};

    def end = DateTime::GetTime();

    IO::PrintLine("String manipulation benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
};

def TestParenthesisGeneration : (Int) -> Unit = fn(max_len) ->
{
    def output = [];
    def BackTrack : (Int, Int, Int, Text) -> Unit = fn(len, left, right, acc) ->
    {   
		if left < right
		then
		{
			return ();
		}
		else
		{
			if left > len || right > len
			then
			{
				return ();
			}
			else
			{
				if left == len && right == len
				then
				{
					output = output ++ [acc];
					return ();
				}
				else
				{
					BackTrack(len, left + 1, right, acc ++ "(");
					BackTrack(len, left, right + 1, acc ++ ")");
				}
			}
		}
    };

    def start = DateTime::GetTime();

    BackTrack(max_len, 0, 0, "");

    def end = DateTime::GetTime();

    IO::PrintLine("Parenthesis generation benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
};

TestFib();
TestPrimeNumbers();
TestStringManipulation();
TestParenthesisGeneration(8);