module LinkedList
import { "../MidoriPrelude/IO.mdr", "../MidoriPrelude/Convertable.mdr"  }

union ListNode<T> = None | Value(T, ListNode<T>);

defun ListToString<T>(List : ListNode<T>) : Text where Convertable<T, Text> =>
    match List with
        case ListNode::None => ""
        case ListNode::Value(Head, Tail) => (Head as Text) ++ ", " ++ ListToString(Tail)
;

def MyList = new ListNode::Value(1, new ListNode::Value(2, new ListNode::Value(3, new ListNode::None())));

IO::PrintLine(ListToString(MyList));