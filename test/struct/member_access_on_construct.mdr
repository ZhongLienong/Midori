module MemberAccessOnConstruct

// A construction in the object position of a member access is not the expression the
// surrounding context is asking about: `.x` decides the type that flows outward, the struct
// does not. Call arguments are where this used to break, because the parameter type was
// pushed down through the member access and unified with the struct's own type, so
// `IO::PrintLine((new Point(7, 8)).x as Text)` was rejected with "Expected type 'Text' but
// got 'Point'" anchored on `Point`.

import
{
	"../../MidoriPrelude/IO.mdr",
}

struct Point
{
	x : Int,
	y : Int
};

struct Named
{
	label : Text,
	n : Int
};

struct Box
{
	p : Point
};

struct Holder<T>
{
	items : Array<T>,
	tag : Text
};

// The reported repro: an Int member converted to Text, straight into a call argument.
IO::PrintLine((Point(7, 8)).x as Text);
IO::PrintLine("concatenated: " ++ ((Point(7, 8)).x as Text));

// The paren-less constructor spelling builds the same node, so it must behave the same.
IO::PrintLine("paren_less: " ++ (Point(9, 10).y as Text));

// No conversion involved: a Text member already matches the parameter type, and the struct
// type still must not be unified with it.
IO::PrintLine((Named("unconverted", 1)).label);

// Every object position along a chain, not only the innermost one.
IO::PrintLine("chained: " ++ ((Box(Point(3, 4))).p.x as Text));

// A record update in object position.
IO::PrintLine("record_update: " ++ ({ Point(20, 21) with y = 99 }.y as Text));

// The expected type still reaches a construction that is itself the argument: `Holder<Int>`
// is the only thing that can decide T here, since the empty array does not pin it.
def holder : Holder<Int> = Holder([], "holder");
IO::PrintLine("holder: " ++ holder.tag);
