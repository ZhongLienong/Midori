import 
{
	"C:\\Users\\jk381\\source\\repos\\ZhongLienong\\Midori\\MidoriPrelude\\IO.mdr"
}

struct Vec3
{
	x : Float,
	y : Float,
	z : Float
};

struct Complex
{
	real : Float,
	img : Float,
};

def TestNestedStruct = fn() : Unit =>
{
	struct Test
	{
		x : Int
	};

	def test = new Test(1);

	defun struct_in_closure() : Unit =>
	{
		struct Test2
		{
			x : Int
		};

		fn() : Unit =>
		{
			struct Test3
			{
				x : Vec3,
				y : Complex
			};

			def test3 = new Test3(new Vec3(1.2, 2.4, 3.2), new Complex(1.12, 2.22));

			IO::PrintLine(test.x as Text);
			IO::PrintLine(test3.y.real as Text);
		}();

		def test2 = new Test2(2);
		IO::PrintLine(test2.x as Text)
	};

	struct_in_closure();
};

TestNestedStruct();