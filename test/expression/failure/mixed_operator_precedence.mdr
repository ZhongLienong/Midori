module MixedOperatorPrecedence

// Operators that do not bind equally cannot be mixed without parentheses: the
// grouping is written rather than remembered from a precedence table. A chain of
// one class - `a + b - c`, `x && y && z` - still needs none.

def a = 2;
def b = 3;
def c = 4;

def mixed = a + b * c;
