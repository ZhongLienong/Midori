module HiddenLocalCaptureInOperandPosition

// A closure capturing a local that a match binds, with the match used as an
// operand, must be rejected at compile time.
//
// The match's locals are shifted above the pending operand, but capture rewrites
// a local into a cell by matching its PARSER index, which cannot reach the
// shifted index actually emitted. Before this was a diagnostic the program
// compiled and read unrelated memory: the label came back empty and the result
// was a different garbage number on every run. The same holds for blocks, for
// loops and array comprehensions used as operands.

import { "../../../MidoriPrelude/IO.mdr" }

def ShowF = fn(label : Text, f : fn() -> Int) -> Unit =>
	IO::PrintLine(label ++ " " ++ (f() as Text));

def pair = (3, 4);

ShowF("captured", match pair with case (a, b) => fn() -> Int => a + b);
