module OperatorPrecedenceParentheses

import { "../../../MidoriPrelude/IO.mdr" }

// What the parentheses rule still allows: a chain of operators that bind equally,
// and any grouping written out. `+` and `-` are one class, as are `*`, `/` and `%`.

def a = 2;
def b = 3;
def c = 4;

IO::PrintLine("chain: " ++ ((a + b - c) as Text));
IO::PrintLine("factors: " ++ ((a * b / c) as Text));
IO::PrintLine("grouped: " ++ ((a + (b * c)) as Text));
IO::PrintLine("nested: " ++ (((a + b) * (c - a)) as Text));
IO::PrintLine("comparisons: " ++ (if (a < b) && (b < c) then "ordered" else "unordered"));
IO::PrintLine("unary: " ++ ((-a + b) as Text));
