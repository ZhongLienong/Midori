module TupleElementExpectedType

import { "../../../MidoriPrelude/IO.mdr" }

type Point = { x: Int, y: Int };

def Annotated : (Int, Point) = (1, Point(2, 3));

def Nested : (Point, (Int, Point)) = (Point(4, 5), (6, Point(7, 8)));

def Returned = fn() -> (Text, Point) => ("p", Point(9, 10));

def (label, corner) = Returned();

def (first, inner) = Nested;
def (n, deep) = inner;

def InArray : Array<(Int, Point)> = [(11, Point(12, 13))];
def (idx, boxed) = InArray[0];

def (one, pt) = Annotated;
IO::PrintLine(pt.y as Text);
IO::PrintLine(label);
IO::PrintLine(corner.x as Text);
IO::PrintLine(first.x as Text);
IO::PrintLine(deep.y as Text);
IO::PrintLine(boxed.x as Text);
