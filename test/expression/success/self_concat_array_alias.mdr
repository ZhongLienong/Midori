module SelfConcatArrayAlias

import
{
    "../../../MidoriPrelude/Prelude/Panic.mdr",
}

def items = [1];
def alias = items;
def result = items = items ++ [2];

if #alias == 1 then () else Panic::Panic("array alias should keep the original array for x = x ++ y");
if #items == 2 then () else Panic::Panic("self-concat assignment should rebind the local array");
if items[1] == 2 then () else Panic::Panic("self-concat assignment should include the appended element");
if result[1] == 2 then () else Panic::Panic("assignment should return the updated array");
