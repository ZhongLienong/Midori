module ConcatAssignTextScopes

import
{
    "../../../MidoriPrelude/Prelude/Panic.mdr",
}

def LocalConcat = fn() -> Text => {
    def text = "lo";
    def result = text = text ++ "cal";
    text ++ "|" ++ result
};

def makeConcat = fn() -> fn() -> Text =>
{
    def text = "mid";
    fn() -> Text => text = text ++ "ori"
};

def append = makeConcat();

if LocalConcat() == "local|local" then () else Panic::Panic("local concat-assign should store and return the updated value");
if append() == "midori" then () else Panic::Panic("captured concat-assign should update the captured cell");
if append() == "midoriori" then () else Panic::Panic("captured concat-assign should keep the updated value for later calls");
