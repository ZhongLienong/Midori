module CellCrossesWorkerCapture

import
{
	"../../../MarmotPrelude/IO.mmt",
	"../../../MarmotPrelude/Cell.mmt",
	"../../../MarmotPrelude/Concurrency.mmt",
	"../../../MarmotPrelude/Prelude/Result.mmt"
}

use Result.{ Result }

// A spawned lambda that captures a cell takes a copy of it into the worker. The
// cell the worker makes for itself inside a nested lambda never crosses, so only
// the captured one is reported.

def RunWorker = fn(outer: Cell<Int>) -> Int =>
{
	def worker = Concurrency::Spawn((), fn() -> Int =>
	{
		def local = Cell::New(1);
		def Bump = fn() -> Int => Cell::Set(local, Cell::Get(local) + 1);
		Cell::Set(outer, Cell::Get(outer) + Bump())
	});
	match Concurrency::Join(worker) with
		case Result::Ok(value) => value
		case Result::Err(_) => -1
};

def shared = Cell::New(40);
IO::PrintLine("worker got " ++ (RunWorker(shared) as Text) ++ ", caller still has " ++ (Cell::Get(shared) as Text));
