module IterableIteration

import
{
    "../../MarmotPrelude/IO.mmt",
    "../../MarmotPrelude/Iterable.mmt",
    "../../MarmotPrelude/Prelude/Option.mmt"
}

use Option.{Option}

type Counter =
{
    current: Int,
    end: Int
};

def CounterNew = fn(end: Int) -> Counter => Counter(0, end);

instance Iterable<Counter>
{
    type Item = Int;
    def Next = fn(counter: Counter) -> Option<(Int, Counter)> => {
        if counter.current >= counter.end
        then Option::None()
        else Option::Some((counter.current, Counter(counter.current + 1, counter.end)))
    };
};

def iter = CounterNew(4);

def SumIter = fn(state: Counter, acc: Int) -> Int =>
    match Iterable::Next(state) with
        case Option::Some(step) => {
            def (value, rest) = step;
            SumIter(rest, acc + value)
        }
        case Option::None() => acc;

def total = SumIter(iter, 0);

if total == 6
then IO::PrintLine("iterable_iteration: PASS")
else IO::PrintLine("iterable_iteration: FAIL");
