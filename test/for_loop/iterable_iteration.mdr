module IterableIteration

import
{
    "../../MidoriPrelude/IO.mdr",
    "../../MidoriPrelude/Iterable.mdr",
    "../../MidoriPrelude/Prelude/Option.mdr"
}

use Option.{Option}

type Counter =
{
    current: Int,
    end: Int
};

def CounterNew = fn(end: Int) -> Counter => Counter(0, end);

instance Iterable<Counter>
{
    type Item = Int;
    def Next = fn(counter: Counter) -> Option<(Int, Counter)> => {
        if counter.current >= counter.end
        then Option::None()
        else Option::Some((counter.current, Counter(counter.current + 1, counter.end)))
    };
};

def iter = CounterNew(4);
def total = 0;

for i in iter {
    total = total + i;
};

if total == 6
then IO::PrintLine("iterable_iteration: PASS")
else IO::PrintLine("iterable_iteration: FAIL");
