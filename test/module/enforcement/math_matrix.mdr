// Module in same namespace - should access private exports from Math.Vector
module Math.Matrix
public export { run_tests }

import 
{
    "math_vector.mdr"
}

// This should SUCCEED - same namespace (Math), can access private function
defun test_private_access() : Float => internal_normalize(1.0, 2.0);

// This should SUCCEED - public export always accessible
defun test_public_access() : Float => add_vectors(1.0, 2.0, 3.0, 4.0);

defun run_tests() : Int => 
{
    def sum = test_public_access();
    def normalized = test_private_access();
    42
};
