// Module with both public and private exports
module Math.Vector
public export { add_vectors, scale_vector }
private export { internal_normalize }

// Public exports - accessible to everyone
defun add_vectors(x1: Float, y1: Float, x2: Float, y2: Float) : Float => x1 + x2 + y1 + y2;

defun scale_vector(x: Float, y: Float, scale: Float) : Float => (x + y) * scale;

// Private exports - only accessible to Math.* modules
defun internal_normalize(x: Float, y: Float) : Float => x + y;

// Internal (not exported) - only accessible within this module
defun helper_function() : Int => 42;
