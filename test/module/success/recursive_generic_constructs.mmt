module RecursiveGenericConstructs

import { "recursive_generic_constructs_lib.mmt", "../../../MarmotPrelude/IO.mmt" }

def plain = RecursiveGenericConstructsLib::RecPlain(7);
def pairs = RecursiveGenericConstructsLib::RecStruct(1, "a");
def other : Array < RecursiveGenericConstructsLib::Pair < Text, Int > > = RecursiveGenericConstructsLib::RecStruct("k", 9);

IO::PrintLine(#plain as Text);
IO::PrintLine(#pairs as Text);
IO::PrintLine(pairs[0].k as Text);
IO::PrintLine(pairs[1].v);
IO::PrintLine(other[0].k);
IO::PrintLine(other[1].v as Text);
