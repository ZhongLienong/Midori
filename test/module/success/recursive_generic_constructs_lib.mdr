module RecursiveGenericConstructsLib
import { "../../../MidoriPrelude/ArrayUtil.mdr" }
public export { Pair, RecPlain, RecStruct }

type Pair < K, V > = { k: K, v: V };

def AppendRecPlain = fn < K >(out: Array < K >, key: K, n: Int) -> Unit => {
    if n <= 0 then () else {
        ArrayUtil::Append(out, key);
        AppendRecPlain(out, key, n - 1)
    }
};
def RecPlain = fn < K >(key: K) -> Array < K > => {
    def out: Array < K > =[];
    AppendRecPlain(out, key, 2);
    out
};

def AppendRecStruct = fn < K, V >(out: Array < Pair < K, V > >, key: K, value: V, n: Int) -> Unit => {
    if n <= 0 then () else {
        ArrayUtil::Append(out, Pair (key, value));
        AppendRecStruct(out, key, value, n - 1)
    }
};
def RecStruct = fn < K, V >(key: K, value: V) -> Array < Pair < K, V > > => {
    def out: Array < Pair < K, V > > =[];
    AppendRecStruct(out, key, value, 2);
    out
};
