module SideEffect

import
{
	"../../MidoriPrelude/IO.mdr",
}

def makeCounter = fn() : fn() -> Int =>
{
	def privateCounter = 0;
	fn() : Int => { privateCounter = privateCounter + 1; privateCounter }
};

def counter = makeCounter();

IO::PrintLine(counter() as Text);  // Should print 1
IO::PrintLine(counter() as Text);  // Should print 2
