import
{
	"../../MidoriPrelude/IO.mdr",
}

def createCounter = fn(initial : Int) : fn(Int) -> fn() -> Int =>
{
  def counter = fn(value : Int) : fn() -> Int =>
  {
    initial = initial + value;
    fn() : Int => initial
  };
  counter
};

def counter = createCounter(5);
def next = counter(3);

IO::PrintLine(next() as Text);  // Should print 8