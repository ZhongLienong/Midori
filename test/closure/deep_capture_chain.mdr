module DeepCaptureChain

import
{
	"../../MidoriPrelude/IO.mdr",
}

// Replaces man_or_boy.mdr. Knuth's Man-or-Boy test turns on a nested closure
// mutating its enclosing scope's parameter between calls, which an immutable
// language cannot express; it was removed rather than rewritten into something
// that shares its name but not its meaning.
//
// What it exercised that is still expressible: closures capturing at several
// depths at once, passed as arguments and re-entered recursively.

def level = fn(depth : Int, base : Int) -> fn(Int) -> Int =>
{
	def here = base + depth;
	fn(extra : Int) -> Int => here + extra
};

// Each returned closure keeps its own `here`, so a later one cannot disturb an
// earlier one.
def first = level(1, 100);
def second = level(2, 200);
def third = level(3, 300);

IO::PrintLine(first(0) as Text);
IO::PrintLine(second(0) as Text);
IO::PrintLine(third(0) as Text);
IO::PrintLine(first(7) as Text);

// A recursive walk that carries closures through the recursion, so captures
// survive several frames.
def walk = fn(n : Int, acc : fn(Int) -> Int) -> Int =>
	if n <= 0 then acc(0) else walk(n - 1, acc);

IO::PrintLine(walk(5, second) as Text);
