module RecursiveClosure

import
{
	"../../MidoriPrelude/IO.mdr",
}

defun makeRecursive(n : Int) : fn(Int) -> Int =>
	if n == 0
	then fn(x : Int) : Int => 1
	else fn(x : Int) : Int => x * makeRecursive(n - 1)(x - 1)
;

def factorial = makeRecursive(5);

IO::PrintLine(factorial(5) as Text);  // Should print 120