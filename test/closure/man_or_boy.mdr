import
{
    "C:\\Users\\jk381\\source\\repos\\ZhongLienong\\Midori\\MidoriPrelude\\IO.mdr"
}

defun x(x : Int) : fn() -> Int => fn() : Int => x;

defun A(k : Int, x1 : fn() -> Int, x2 : fn() -> Int, x3 : fn() -> Int, x4 : fn() -> Int, x5 : fn() -> Int) : Int =>
{
    defun B() : Int =>
    {
        k = k - 1;
        A(k, B, x1, x2, x3, x4)
    };
    if k > 0 then B() else x4() + x5()
};

IO::PrintLine(A(10, x(1), x(-1), x(-1), x(1), x(0)) as Text);   