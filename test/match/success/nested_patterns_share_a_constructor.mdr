module NestedPatternsShareAConstructor

import { "../../../MidoriPrelude/Prelude/Result.mdr", "../../../MidoriPrelude/IO.mdr" }

use Result.{ Result }

// Two arms may share an outer constructor when they discriminate on different
// nested patterns. An arm only covers its whole constructor when every argument
// matches anything, and only then does a later arm on it become unreachable.

type Code = Alpha | Beta | Other(Int);

def Describe = fn(result : Result<Int, Code>) -> Text =>
	match result with
		case Result::Ok(n) => "ok " ++ (n as Text)
		case Result::Err(Code::Alpha) => "alpha"
		case Result::Err(Code::Beta) => "beta"
		case Result::Err(Code::Other(n)) => "other " ++ (n as Text);

IO::PrintLine(Describe(Result::Ok(7)));
IO::PrintLine(Describe(Result::Err(Code::Alpha())));
IO::PrintLine(Describe(Result::Err(Code::Beta())));
IO::PrintLine(Describe(Result::Err(Code::Other(3))));

// The same, one level deeper: the nested constructor itself carries a pattern.
def Inner = fn(result : Result<Int, Result<Int, Text>>) -> Text =>
	match result with
		case Result::Ok(n) => "ok " ++ (n as Text)
		case Result::Err(Result::Ok(n)) => "err-ok " ++ (n as Text)
		case Result::Err(Result::Err(message)) => "err-err " ++ message;

IO::PrintLine(Inner(Result::Err(Result::Ok(1))));
IO::PrintLine(Inner(Result::Err(Result::Err("boom"))));

// A literal inside the constructor discriminates too.
def Classify = fn(value : Result<Int, Text>) -> Text =>
	match value with
		case Result::Ok(0) => "zero"
		case Result::Ok(n) => "nonzero " ++ (n as Text)
		case Result::Err(message) => message;

IO::PrintLine(Classify(Result::Ok(0)));
IO::PrintLine(Classify(Result::Ok(5)));
