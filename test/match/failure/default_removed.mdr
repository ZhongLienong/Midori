module DefaultRemoved

// `default` was removed: the catch-all arm is `case _ =>`, since `_` is already a
// wildcard pattern and nests where `default` could not. The error names that
// replacement rather than failing with "Expected at least one case.".

def Describe = fn(n : Int) -> Text => match n with
	case 0 => "zero"
	default => "other"
;
