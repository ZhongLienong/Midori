module CaseAfterCatchAllConstructor

import { "../../../MidoriPrelude/Prelude/Result.mdr" }

use Result.{ Result }

type Code = Alpha | Beta;

// `Err(e)` matches every Err, so the arm after it can never run. The error names
// the constructor rather than calling it a duplicate, because the two arms are
// not written the same way.

def Describe = fn(result : Result<Int, Code>) -> Text =>
	match result with
		case Result::Ok(n) => "ok"
		case Result::Err(e) => "any error"
		case Result::Err(Code::Alpha) => "alpha";
