module TailCallDefBinding

// Test: a self-recursive tail call in a function bound with `def Name = fn(...)`.
// The sums assert depth rather than completion: without the tail call the stack
// overflows at roughly 2,499 frames, far short of the 100,000 counted here.
// Expected: the `def = fn` binding is optimised exactly as the `defun` is.

import
{
	"../../MidoriPrelude/IO.mdr"
}

def CountDownBinding = fn(n : Int, acc : Int) -> Int =>
{
	if n <= 0 then acc else CountDownBinding(n - 1, acc + n)
};

defun CountDownDefun(n : Int, acc : Int) -> Int =>
{
	if n <= 0 then acc else CountDownDefun(n - 1, acc + n)
};

def CountDownInMatch = fn(n : Int, acc : Int) -> Int => match n <= 0 with
	case true => acc
	default => CountDownInMatch(n - 1, acc + n)
;

defun OuterHoldingLocalBinding() -> Int =>
{
	def CountDownLocal = fn(n : Int, acc : Int) -> Int =>
	{
		if n <= 0 then acc else CountDownLocal(n - 1, acc + n)
	};
	CountDownLocal(100000, 0)
};

IO::PrintLine("binding=" ++ (CountDownBinding(100000, 0) as Text));
IO::PrintLine("defun=" ++ (CountDownDefun(100000, 0) as Text));
IO::PrintLine("match=" ++ (CountDownInMatch(100000, 0) as Text));
IO::PrintLine("local=" ++ (OuterHoldingLocalBinding() as Text));
