module CanonicalizationCleanup

import { "../../MidoriPrelude/IO.mdr" }

struct Point
{
    x : Int,
    y : Int
};

defun grouped_value(value: Int) : Int => (((value)));
defun unary_plus_value(value: Int) : Int => +(+value);
defun double_negative_value(value: Int) : Int => -(-value);
defun double_not_value(flag: Bool) : Bool => !(!flag);
defun and_left_identity(flag: Bool) : Bool => true && flag;
defun and_right_identity(flag: Bool) : Bool => flag && true;
defun or_left_identity(flag: Bool) : Bool => false || flag;
defun or_right_identity(flag: Bool) : Bool => flag || false;
defun shift_identity(value: Int) : Int => value <~ 0;
defun bitor_identity(value: Int) : Int => value | 0;
defun xor_identity(value: Int) : Int => value ^ 0;
defun text_left_identity(value: Text) : Text => "" ++ value;
defun text_right_identity(value: Text) : Text => value ++ "";
defun array_left_identity(values: Array<Int>) : Array<Int> => [] ++ values;
defun array_right_identity(values: Array<Int>) : Array<Int> => values ++ [];
defun point_x(point: Point) : Int => (point as Point).x;

def input_true: Bool = true;
def input_false: Bool = false;
def input_numbers: Array<Int> = [4, 5, 6];
def input_point: Point = new Point(9, 11);

IO::PrintLine("grouped_value=" ++ (grouped_value(42) as Text));
IO::PrintLine("unary_plus_value=" ++ (unary_plus_value(7) as Text));
IO::PrintLine("double_negative_value=" ++ (double_negative_value(9) as Text));
IO::PrintLine("double_not_true=" ++ (if double_not_value(input_true) then "true" else "false"));
IO::PrintLine("double_not_false=" ++ (if double_not_value(input_false) then "true" else "false"));
IO::PrintLine("and_left_false=" ++ (if and_left_identity(input_false) then "true" else "false"));
IO::PrintLine("and_right_true=" ++ (if and_right_identity(input_true) then "true" else "false"));
IO::PrintLine("or_left_false=" ++ (if or_left_identity(input_false) then "true" else "false"));
IO::PrintLine("or_right_true=" ++ (if or_right_identity(input_true) then "true" else "false"));
IO::PrintLine("shift_identity=" ++ (shift_identity(12) as Text));
IO::PrintLine("bitor_identity=" ++ (bitor_identity(12) as Text));
IO::PrintLine("xor_identity=" ++ (xor_identity(12) as Text));
IO::PrintLine("text_left_identity=" ++ text_left_identity("midori"));
IO::PrintLine("text_right_identity=" ++ text_right_identity("midori"));
IO::PrintLine("array_left_count=" ++ ((#array_left_identity(input_numbers)) as Text));
IO::PrintLine("array_left_last=" ++ (array_left_identity(input_numbers)[2] as Text));
IO::PrintLine("array_right_count=" ++ ((#array_right_identity(input_numbers)) as Text));
IO::PrintLine("array_right_first=" ++ (array_right_identity(input_numbers)[0] as Text));
IO::PrintLine("point_x=" ++ (point_x(input_point) as Text));
