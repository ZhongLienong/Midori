module GenerationalChurn

import
{
	"../../MidoriPrelude/Appendable.mdr",
	"../../MidoriPrelude/ArrayUtil.mdr",
	"../../MidoriPrelude/IO.mdr"
}

def Main = fn() -> Unit =>
{
	// Long-lived, created before the churn and alive throughout, so the young
	// pointers appended to it below are the old-to-young writes this test exists
	// to exercise. Appendable::Append mutates in place and is untouched by the
	// removal of assignment, so that path survives intact.
	def keeper : Array<Text> = [];

	// `for` accumulates nothing now; every statement in the body is an effect.
	// The allocation profile is unchanged: 32000 iterations, four short-lived
	// strings and one scratch array each.
	for i in 0..1..32000
	{
		def scratch : Array<Text> = [];
		Appendable::Append(scratch, "churn-" ++ (i as Text));
		Appendable::Append(scratch, scratch[0] ++ "-x");
		Appendable::Append(scratch, scratch[1] ++ "-y");
		Appendable::Append(scratch, scratch[2] ++ "-z");

		if i % 1000 == 0
		then Appendable::Append(keeper, "fresh-" ++ (i as Text))
		else ();
	};

	for item in keeper
	{
		IO::PrintLine(item);
	};

	// Previously read out of two mutable captures. Both were bookkeeping over
	// the same promotions and are derivable from `keeper` itself.
	IO::PrintLine(keeper[ArrayUtil::Length(keeper) - 1]);
	IO::PrintLine(ArrayUtil::Length(keeper) as Text);
};

Main();
