module ExtendWriteBarrier

import
{
	"../../MidoriPrelude/IO.mdr",
	"../../MidoriPrelude/ArrayUtil.mdr"
}

// Old-to-young write-barrier coverage for EXTEND_ARRAY, the in-place `++` the
// code generator emits when the left operand is a fresh temporary.
//
// The fresh left array is pending on the stack while the right operand is
// evaluated. That evaluation allocates enough to force collections, which mark
// the left array (old). The right operand then builds a small array without a
// collection, so it and its elements are young. The extend copies those young
// elements into the old array, and nothing else references them once the right
// array is dropped. Removing the barrier from EXTEND_ARRAY lost all 50 of them,
// on every run.
//
// The right array must stay small: if a collection runs while it is being built,
// it becomes old and is logged by the ADD_BACK_ARRAY barrier, and that stale
// remembered-set entry keeps its elements alive whether or not EXTEND_ARRAY has
// a barrier -- the test would then pass without testing anything.
//
// The texts are longer than the small-string interning limit on purpose:
// interned texts are GC roots and would survive with or without the barrier.

def Prefix = "a-prefix-long-enough-that-small-string-interning-cannot-hold-it-";

def MakeItem = fn(i : Int) -> Text =>
{
	def junk = [Prefix ++ (i as Text) ++ "-junk" for _ in 0..1..64];
	if ArrayUtil::Length(junk) == 64 then Prefix ++ (i as Text) else "wrong-junk-length"
};

def CountWrong = fn(items : Array<Text>, index : Int, wrong : Int) -> Int =>
	if index >= ArrayUtil::Length(items)
	then wrong
	else CountWrong(items, index + 1, if items[index] == Prefix ++ (index as Text) then wrong else wrong + 1);

// Forces collections (promoting the pending left operand), then returns a small
// array whose elements are all allocated after them, so they are young.
def YoungTail = fn(count : Int) -> Array<Text> =>
{
	def garbage = [MakeItem(i) for i in 0..1..4000];
	if ArrayUtil::Length(garbage) == 4000 then [Prefix ++ (i as Text) for i in 1..1..count] else []
};

def items = [Prefix ++ "0"] ++ YoungTail(51);

// More allocation, so minor collections run while `items` is old.
def churn = [MakeItem(i) for i in 0..1..2000];
IO::PrintLine("churn=" ++ (ArrayUtil::Length(churn) as Text));

IO::PrintLine("wrong=" ++ (CountWrong(items, 0, 0) as Text));
IO::PrintLine("last=" ++ items[50]);
