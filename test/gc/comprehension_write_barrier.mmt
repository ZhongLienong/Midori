module ComprehensionWriteBarrier

import
{
	"../../MarmotPrelude/IO.mmt",
	"../../MarmotPrelude/ArrayUtil.mmt"
}

// Old-to-young write-barrier coverage for ADD_BACK_ARRAY, the append a
// comprehension performs on each element.
//
// v2 has no in-place writes in the language, but the runtime still makes them:
// a comprehension builds its result by appending into an array that lives in a
// hidden local. When a minor collection runs mid-build, that array is marked
// (old); every element appended afterwards is young and referenced only by it.
// A minor collection does not re-trace an old root, so without the barrier those
// elements are swept. Removing the barrier from ADD_BACK_ARRAY made 19739 of the
// 20000 elements below come back wrong, on every run.
//
// The texts are longer than the small-string interning limit on purpose:
// interned texts are GC roots and would survive with or without the barrier.

def Prefix = "a-prefix-long-enough-that-small-string-interning-cannot-hold-it-";

// Allocates garbage so collections run while the comprehension is still building.
def MakeItem = fn(i : Int) -> Text =>
{
	def junk = [Prefix ++ (i as Text) ++ "-junk" for _ in 0..1..64];
	if ArrayUtil::Length(junk) == 64 then Prefix ++ (i as Text) else "wrong-junk-length"
};

def CountWrong = fn(items : Array<Text>, index : Int, wrong : Int) -> Int =>
	if index >= ArrayUtil::Length(items)
	then wrong
	else CountWrong(items, index + 1, if items[index] == (Prefix ++ (index as Text)) then wrong else wrong + 1);

def items = [MakeItem(i) for i in 0..1..20000];

IO::PrintLine("wrong=" ++ (CountWrong(items, 0, 0) as Text));
IO::PrintLine("first=" ++ items[0]);
IO::PrintLine("last=" ++ items[19999]);
