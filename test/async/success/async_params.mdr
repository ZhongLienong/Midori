module AsyncParams

import { <IO>, <Math> }

struct Complex {
    Real : Float,
    Imag : Float,
};

defun complex_abs(x : Complex) : Float => Math::SquareRoot(x.Real * x.Real + x.Imag * x.Imag);

defun test_func(count : Int, scale : Float) : Text =>
{
    def tasks : Array<Future<Float>> = [];
    def i = 0;
    loop
    {
        def i_copy = i;
        tasks ++= (async
        {
            def c = new Complex((i_copy as Float) * scale, scale);
            complex_abs(c)
        });

        i = i + 1;
        if i >= count then break () else ();
    };

    def result = "";
    def j = 0;
    loop
    {
        def value = await tasks[j];
        result ++= (value as Text);
        result ++= " ";
        j = j + 1;
        if j >= count then break () else ();
    };
    result
};

IO::PrintLine(test_func(100, 1.0));
