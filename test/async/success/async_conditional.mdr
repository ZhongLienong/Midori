import { <IO> }

defun abs(x: Int) : Int => if x < 0 then -x else x;

def task1 : Future<Int> = async abs(-42);
def task2 : Future<Int> = async abs(42);

def r1 : Int = await task1;
def r2 : Int = await task2;

IO::PrintLine("abs(-42) = " ++ (r1 as Text));
IO::PrintLine("abs(42) = " ++ (r2 as Text));
