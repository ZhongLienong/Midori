module Loop2CaptureStructTest

// Async test with loop (2 iterations), capture AND struct

import { <IO> }

struct Point {
    X : Float,
    Y : Float,
};

defun make_point(x : Float, y : Float) : Point => new Point(x, y);

def tasks : Array<Future<Float>> = [];

def y = 0;
loop {
    def y_copy = y;
    tasks ++= (async {
        def c = make_point(1.0, (y_copy as Float));
        c.X + c.Y
    });

    y = y + 1;
    if y >= 2 then break () else ();
};

def i = 0;
loop {
    def value = await tasks[i];
    IO::PrintLine(value as Text);
    i = i + 1;
    if i >= 2 then break () else ();
};
