module SourceOrderSharedCapture

import { <IO> }

def result = {
    def x = 0;

    defun inc() : Int => {
        x = x + 1;
        x
    };

    def task = async {
        def _ = inc();
        x
    };

    def async_value = await task;
    def sync_value = x;
    (async_value * 10) + sync_value
};

IO::PrintLine(result as Text);
