module TwoAsyncTest

// Async test with just 2 tasks

import { <IO> }

struct Point {
    X : Float,
    Y : Float,
};

defun make_point(x : Float, y : Float) : Point => new Point(x, y);
defun add_points(a : Point, b : Point) : Point => new Point(a.X + b.X, a.Y + b.Y);
defun double_point(a : Point) : Point => add_points(a, a);

def tasks : Array<Future<Float>> = [];

// First task
def y_copy1 = 1;
tasks ++= (async {
    def c = make_point(1.0, (y_copy1 as Float));
    def z = make_point(0.0, 0.0);
    z = add_points(double_point(z), c);
    z.X + z.Y
});

IO::PrintLine("First task spawned");

// Second task
def y_copy2 = 2;
tasks ++= (async {
    def c = make_point(1.0, (y_copy2 as Float));
    def z = make_point(0.0, 0.0);
    z = add_points(double_point(z), c);
    z.X + z.Y
});

IO::PrintLine("Second task spawned");

def v1 = await tasks[0];
IO::PrintLine(v1 as Text);

def v2 = await tasks[1];
IO::PrintLine(v2 as Text);
