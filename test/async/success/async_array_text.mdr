module AsyncArrayText

import { <IO> }

defun compute(x: Int) : Text => "Result: " ++ (x * x as Text);

def tasks : Array<Future<Text>> = [];
def i = 0;
loop {
    def i_copy = i;
    tasks ++= async compute(i_copy);
    i = i + 1;
    if i >= 50 then break () else ();
};

IO::PrintLine("Spawned 50 tasks");

def j = 0;
loop {
    def result = await tasks[j];
    IO::PrintLine(result);
    j = j + 1;
    if j >= 50 then break () else ();
};

IO::PrintLine("Done");
