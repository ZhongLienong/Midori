import
{
    <IO>,
    <Math>
}

struct Complex {
    Real : Float,
    Imag : Float,
};

defun complex_abs(x : Complex) : Float => Math::SquareRoot(x.Real * x.Real + x.Imag * x.Imag);
defun complex_add(a : Complex, b : Complex) : Complex => new Complex(a.Real + b.Real, a.Imag + b.Imag);
defun complex_square(a : Complex) : Complex => new Complex(a.Real * a.Real - a.Imag * a.Imag, 2.0 * a.Real * a.Imag);

defun test_func(width : Int, height : Int, limit : Int) : Text =>
{
    def tasks : Array<Future<Text>> = [];
    def y = 0;
    loop
    {
        def y_copy = y;
        tasks ++= (async
        {
            def row_data = "";
            def x = 0;
            loop
            {
                def c = new Complex(-2.05 + (x as Float) * 2.6 / (width as Float),
                                    -1.2  + (y_copy as Float) * 2.4 / (height as Float));
                def z = new Complex(0.0, 0.0);
                def iterations = 0;
                loop
                {
                    if iterations >= limit then break () else ();
                    z = complex_add(complex_square(z), c);
                    if complex_abs(z) >= 2.0 then break () else ();
                    iterations = iterations + 1;
                };
                row_data ++= (iterations as Text);
                row_data ++= " ";

                x = x + 1;
                if x >= width then break () else ();
            };
            row_data
        });

        y = y + 1;
        if y >= height then break () else ();
    };

    def result = "";
    def i = 0;
    loop
    {
        result ++= await tasks[i];
        result ++= "\n";
        i = i + 1;
        if i >= height then break () else ();
    };
    result
};

IO::PrintLine(test_func(3, 2, 5));
