module SimpleAsyncArray

import { <IO> }

defun compute(x: Int) : Int => x * x;

def tasks : Array<Future<Int>> = [];
def i = 0;
loop {
    def i_copy = i;
    tasks ++= async compute(i_copy);
    i = i + 1;
    if i >= 10 then break () else ();
};

IO::PrintLine("Spawned 10 tasks");

def j = 0;
loop {
    def result = await tasks[j];
    IO::PrintLine((result as Text));
    j = j + 1;
    if j >= 10 then break () else ();
};

IO::PrintLine("Done");
