import { <IO> }

struct Point {
    X : Float,
    Y : Float,
};

def tasks : Array<Future<Float>> = [];

def y = 0;
loop {
    def y_copy = y;
    tasks ++= (async {
        def c = new Point(1.0, (y_copy as Float));
        c.X + c.Y
    });

    y = y + 1;
    if y >= 3 then break () else ();
};

def i = 0;
loop {
    def value = await tasks[i];
    IO::PrintLine(value as Text);
    i = i + 1;
    if i >= 3 then break () else ();
};
