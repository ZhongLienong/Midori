// Async test with nested calls and captures like mandelbrot

import { <IO> }

struct Point {
    X : Float,
    Y : Float,
};

defun make_point(x : Float, y : Float) : Point => new Point(x, y);
defun add_points(a : Point, b : Point) : Point => new Point(a.X + b.X, a.Y + b.Y);
defun double_point(a : Point) : Point => add_points(a, a);

def y = 5;
def y_copy = y;

def result = async {
    def p1 = make_point(1.0, (y_copy as Float));
    def p2 = make_point(3.0, 4.0);
    // Nested call like mandelbrot: add_points(double_point(p1), p2)
    def p3 = add_points(double_point(p1), p2);
    p3.X + p3.Y
};

def value = await result;
IO::PrintLine(value as Text);
