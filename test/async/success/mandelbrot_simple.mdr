import { <IO> }

struct Point {
    X : Float,
    Y : Float,
};

defun helper(p : Point) : Float => p.X + p.Y;

defun test_func(width : Int, height : Int) : Text =>
{
    def tasks : Array<Future<Float>> = [];
    def y = 0;
    loop
    {
        def y_copy = y;
        tasks ++= (async
        {
            def p = new Point(1.0, (y_copy as Float));
            helper(p)
        });

        y = y + 1;
        if y >= 3 then break () else ();
    };

    def result = "";
    def i = 0;
    loop
    {
        def value = await tasks[i];
        result ++= (value as Text);
        result ++= " ";
        i = i + 1;
        if i >= 3 then break () else ();
    };
    result
};

IO::PrintLine(test_func(10, 10));
