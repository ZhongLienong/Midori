module NewtypeCompoundRepresentation

// Task 3 only parses newtype declarations; conversion between a newtype and
// its representation is deferred to a later task's derived Convertable
// instances, so this exercises ParseType's harder representation shapes
// (tuple, function, array) as a newtype's right-hand side without needing to
// construct a value of the newtype itself.
type Coordinates = (Int, Int, Int);
type Transformer = fn(Int) -> Int;
type Items = Array<Int>;

defun UseCoordinates(c: Coordinates) : Coordinates => c;
defun UseTransformer(t: Transformer) : Transformer => t;
defun UseItems(items: Items) : Items => items;
