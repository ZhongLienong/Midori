module NewtypeCountableStaysNominal

// `#` on a newtype must dispatch on the newtype's own Countable instance,
// never on the instance that happens to match its representation. Code is a
// newtype over Text, and Text already has a built-in Countable instance
// (TextLength) from the prelude. The Code instance multiplies by 100, so if
// opcode selection ever erased the newtype before instance lookup - the bug
// this test pins - #id would silently come back as the raw Text length
// instead of failing to compile.

import
{
	"../../../MidoriPrelude/Prelude/Panic.mdr",
	"../../../MidoriPrelude/Countable.mdr",
}

type Code = Text;

instance Countable<Code> {
	defun Count(value: Code): Int => (#(value as Text)) * 100;
};

def id: Code = "ab" as Code;

if #id == 200 then () else Panic::Panic("Countable<Code> instance should resolve nominally, not fall back to Countable<Text>'s built-in behaviour");
