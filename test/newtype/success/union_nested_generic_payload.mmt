module NewtypeUnionNestedGenericPayload

import
{
	"../../../MarmotPrelude/Prelude/Panic.mmt",
}

// Regression: a nested generic payload whose closing '>>' lexes as a single
// RIGHT_SHIFT token used to make TypeBodyHasTopLevelBar scan past the
// declaration's real ';' and misroute this union to ParseNewTypeBody, which
// then failed with a misleading "Undefined struct or union" pointing at Ok.
type Result = Ok(Array<Array<Int>>) | Err(Text);

def value = Result::Ok([[1, 2], [3]]);
def is_ok = match value with
	case Result::Ok(_) => true
	case Result::Err(_) => false;

if is_ok then () else Panic::Panic("nested generic union payload should still construct and match");
