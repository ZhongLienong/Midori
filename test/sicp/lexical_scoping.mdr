module LexicalScoping

import
{
	"../../MidoriPrelude/IO.mdr",
}

defun abs(x : Float) : Float => if x < 0.0 then -x else x;
defun square(x : Float) : Float => x * x;
defun sqrt(x : Float) : Float =>
{
	defun is_good_enough(guess : Float) : Bool => abs(square(guess) - x) < 0.001;

	defun improve(guess : Float) : Float => (guess + x / guess) / 2.0;

	defun sqrt_iter(guess : Float) : Float =>
		if is_good_enough(guess)
		then guess
		else sqrt_iter(improve(guess));

	sqrt_iter(1.0)
};

IO::PrintLine(sqrt(2.0) as Text);