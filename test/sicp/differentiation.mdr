import 
{
	"C:\\Users\\jk381\\source\\repos\\ZhongLienong\\Midori\\MidoriPrelude\\IO.mdr"
}

struct Term
{
	variable : Text,
	num : Int,
	is_var : Bool
};

struct Sum
{
	left : Term,
	right : Term
};

struct Product
{
	left : Term,
	right : Term
};

struct Expr
{
	sum_expr : Sum,
	prod_expr : Product,
	is_sum : Bool,
	error : Bool
};

defun make_variable(name : Text) : Term => new Term(name, 0, true);
defun make_number(num : Int) : Term => new Term("", num, false);
defun is_variable(t : Term) : Bool => t.is_var;
defun is_number(t : Term) : Bool => !t.is_var;
defun is_same_variable(v1 : Term, v2 : Term) : Bool => is_variable(v1) && is_variable(v2) && v1.variable == v2.variable;

defun make_sum(v1 : Term, v2 : Term) : Expr => 
{
	def is_sum = true;
	def error = false;
	return new Expr(new Sum(v1, v2), new Product(v1, v2), is_sum, error);
};

defun make_product(v1 : Term, v2 : Term) : Expr => 
{
	def is_sum = false;
	def error = false;
	return new Expr(new Sum(v1, v2), new Product(v1, v2), is_sum, error);
};

defun is_sum(exp : Expr) : Bool => exp.is_sum;
defun is_product(exp : Expr) : Bool => !exp.is_sum;
defun addend(exp : Expr) : Term => exp.sum_expr.left;
defun augend(exp : Expr) : Term => exp.sum_expr.right;
defun multiplier(exp : Expr) : Term => exp.prod_expr.left;
defun multiplicand(exp : Expr) : Term => exp.prod_expr.right;

defun deriv(t : Term, var_ : Text) : Term =>
{
    if is_number(t)
	then make_number(0)
    else if is_variable(t)
	then (if t.variable == var_ then make_number(1) else make_number(0)) // The derivative of the variable with respect to itself is 1, else it's 0
    else
    {
        // Handle more complex cases here (like sum or product)
        // Currently returning a default value for unsupported types
        make_number(0)
    }
};

def var1 = make_variable("x");
def var2 = make_number(3);
def var3 : Expr = make_product(var1, var2);

IO::PrintLine(deriv(var1, "x").num as Text);