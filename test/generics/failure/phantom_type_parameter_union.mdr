module PhantomTypeParameterUnion

// Test: A generic union whose type parameter appears in no variant payload
// Expected: SHOULD FAIL - Tag<Int> and Tag<Text> are distinct types

union Tag<T> = First | Second;

defun make_int_tag() : Tag<Int> => new Tag::First();

defun wants_text_tag(t: Tag<Text>) : Int => 1;

defun main() : Int => 
{
	def t = make_int_tag();
	return wants_text_tag(t);
};
