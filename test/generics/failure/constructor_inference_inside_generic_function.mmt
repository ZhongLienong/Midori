module ConstructorInferenceInsideGenericFunction

// Being inside a generic function is not a licence to leave a construction ambiguous.
// `Bag<T>` is fine there because T is owned by `Hold`, but `Option::None` introduces a
// type variable of its own that nothing pins, so it is still an inference failure.

type Bag<T> =
{
	items : Array<T>,
	tag : Int
};

type Option<T> = Some(T) | None;

def Hold = fn<T>(xs : Array<T>) -> Bag<T> =>
{
	def owned = Bag(xs, 0);
	def unowned = Option::None();
	owned
};

def held = Hold([1, 2]);
