module GenericFunctionAsValue

// Test: a generic function passed where a concrete function type is expected.
// Expected: rejected. A generic function is monomorphised at each call site,
// so there is no single procedure for the argument to carry.

import
{
	"../../../MidoriPrelude/IO.mdr"
}

def identity = fn<T>(x: T) -> T => x;
def apply = fn(f: fn(Int) -> Int, v: Int) -> Int => f(v);

IO::PrintLine(apply(identity, 5) as Text);
