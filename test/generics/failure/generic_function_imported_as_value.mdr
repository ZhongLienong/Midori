module GenericFunctionImportedAsValue

// Test: a generic function imported from another module, passed as a value.
// Expected: rejected. Specialization happens in the importing module, so the
// exported name has no address to link against either.

import
{
	"../../../MidoriPrelude/IO.mdr",
	"../success/generic_function_value_library.mdr"
}

defun apply(f: fn(Int) -> Int, v: Int) -> Int => f(v);

IO::PrintLine(apply(GenericFunctionValueLibrary::Identity, 5) as Text);
