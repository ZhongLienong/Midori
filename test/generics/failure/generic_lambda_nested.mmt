module GenericLambdaNested

// Test: a generic lambda bound inside a function body.
// Expected: rejected. Specialization keys on a global name, so a generic
// function bound anywhere but at module level fails at code generation.

import
{
	"../../../MarmotPrelude/IO.mmt"
}

def outer = fn() -> Unit =>
{
	def Id = fn<T>(x: T) -> T => x;
	IO::PrintLine(Id(1) as Text);
};

outer();
