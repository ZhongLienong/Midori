module ConstructorInferenceFromLaterArgument

// Argument-directed inference flows forwards only. Each argument is unified against its
// parameter before the next one is checked, so an argument is decided by the arguments to
// its left and by nothing to its right.
//
// Here the construction is the first argument and the array that would decide it is the
// second, so `T` is still an undecided type variable when `Slot::Empty()` is checked. The
// mirror image compiles - see
// test/generics/success/generic_construction_in_call_argument.mmt.
//
// Deciding this would need the arguments checked as a group rather than in order, or
// call-site type arguments, which the language does not have.

type Slot<K, V> = Empty | Occupied(K, V);

def PrependTo = fn<T>(value : T, items : Array<T>) -> Unit => ();

def slots : Array<Slot<Int, Text>> = [];

PrependTo(Slot::Empty(), slots);
