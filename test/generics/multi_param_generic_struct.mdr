// Test: Generic struct with multiple type parameters
// Expected: Should compile and allow different combinations

struct Pair<T, U> {
    first: T,
    second: U
};

// Different instantiations
def int_text_pair = new Pair(42, "hello");
def float_bool_pair = new Pair(3.14, true);
def text_int_pair = new Pair("world", 100);

// Access members
def first_val = int_text_pair.first;
def second_val = int_text_pair.second;

// Nested generics
struct Triple<A, B, C> {
    a: A,
    b: B,
    c: C
};

def triple = new Triple(1, "two", 3.0);
