module GenericLambda

// Test: type parameters on a fn expression bound to a top-level name.
// Expected: each call site is instantiated separately, so one binding
// serves both Int and Text without pinning to the first use.

import
{
	"../../../MidoriPrelude/IO.mdr"
}

def Id = fn<T>(x: T) -> T => x;

IO::PrintLine(Id(5) as Text);
IO::PrintLine(Id("a"));

def First = fn<A, B>(a: A, _b: B) -> A => a;

IO::PrintLine(First(10, "ignored") as Text);
IO::PrintLine(First("kept", 99));
