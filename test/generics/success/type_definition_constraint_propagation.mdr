module TypeDefinitionConstraintPropagation

class Show<T> {
    show: fn(value: T) -> Text;
};

struct Box<T> where Show<T> {
    value: T
};

instance Show<Int> {
    def show = fn(value: Int) -> Text => {
        return value as Text;
    };
};

def MakeBox = fn<T>(value: T) -> Box<T> => new Box<T>(value);

def ShowBox = fn<T>(box: Box<T>) -> Text => {
    return Show::show(box.value);
};

def text = ShowBox(MakeBox(42));
