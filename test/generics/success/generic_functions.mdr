module GenericFunctions

// Test: Generic functions
// Expected: Should compile and allow type inference at call sites

import 
{
	"../../../MidoriPrelude/DateTime.mdr"
}

defun identity<T>(x: T) : T => 
{
    return x;
};

def int_result = identity(42);
def text_result = identity("hello");
def float_result = identity(3.14);


defun swap<A, B>(x: A, y: B) : Bool => 
{
    // Just test that we can use generic parameters
    return true;
};

def swap_result = swap(1, "two");

defun first<T, U>(a: T, b: U) : T => a;

def first_int = first(10, "ignored");
def first_text = first("kept", 99);