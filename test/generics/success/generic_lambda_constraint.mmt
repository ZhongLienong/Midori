module GenericLambdaConstraint

// Test: a where clause on a fn expression.
// Expected: the constraint reaches specialization, so each instantiation
// dispatches to the Convertable instance for its own type.

import
{
	"../../../MarmotPrelude/IO.mmt",
	"../../../MarmotPrelude/Convertable.mmt"
}

def Show = fn<T>(x: T) -> Text where Convertable<T, Text> => x as Text;

IO::PrintLine(Show(42));
IO::PrintLine(Show(3.5));
IO::PrintLine(Show(true));
