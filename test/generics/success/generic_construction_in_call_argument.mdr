module GenericConstructionInCallArgument

// A generic construction passed as a call argument infers its type arguments from the
// callee's parameter types; the language has no form for stating them explicitly.
//
// The callee's type parameters are freshened at the call site, so the parameter type an
// argument is checked against is only decided once an earlier argument has been unified
// against its own parameter. Each argument is therefore unified before the next one is
// checked - see TypeChecker::operator()(MidoriExpression::Call&). Deferring every
// unification to a second pass left `Slot::Empty()` below checked against a bare type
// variable, which the Construct visitor rightly rejects as uninferred.
//
// This is the shape the prelude's bucket tables use - MidoriPrelude/Collections/Map.mdr
// and Set.mdr both append a fresh empty slot to an array of slots.
//
// A construction that nothing decides is still an error, and a later argument does not
// decide an earlier one - see
// test/generics/failure/constructor_inference_unowned_type_var.mdr and
// test/generics/failure/constructor_inference_from_later_argument.mdr.

import
{
	"../../../MidoriPrelude/IO.mdr",
	"../../../MidoriPrelude/ArrayUtil.mdr",
}

type Slot<K, V> = Empty | Occupied(K, V);

type Bag<T> =
{
	items : Array<T>
};

def AppendTo = fn<T>(items : Array<T>, value : T) -> Array<T> => ArrayUtil::WithAppended(items, value);

// The deciding argument comes first and is concrete.
def slots : Array<Slot<Int, Text>> = [];
def slots_with_empty = AppendTo(slots, Slot::Empty());
def slots_filled = AppendTo(slots_with_empty, Slot::Occupied(1, "one"));

IO::PrintLine("slots: " ++ (#slots_filled as Text));

// The same call inside a generic function, where the deciding argument is generic in the
// enclosing definition rather than concrete.
def FillGeneric = fn<K, V>(bucket : Array<Slot<K, V>>) -> Array<Slot<K, V>> =>
{
	AppendTo(bucket, Slot::Empty())
};

def texts : Array<Slot<Text, Int>> = [];
def texts_once = FillGeneric(texts);
IO::PrintLine("generic: " ++ (#texts_once as Text));
def texts_twice = FillGeneric(texts_once);
IO::PrintLine("generic again: " ++ (#texts_twice as Text));

// The construction is nested inside another generic instantiation in argument position.
def bags : Array<Bag<Slot<Int, Text>>> = [];
def bags_filled = AppendTo(bags, Bag([Slot::Empty()]));

IO::PrintLine("bags: " ++ (#bags_filled as Text) ++ " inner " ++ (#(bags_filled[0].items) as Text));

match slots_filled[1] with
	case Slot::Occupied(k, v) => IO::PrintLine("occupied: " ++ (k as Text) ++ "/" ++ v)
	case Slot::Empty => IO::PrintLine("empty")
;
