module BasicOperations

import
{
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Collections/Set.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}

def Expect = fn(condition: Bool, message: Text) -> Unit => {
    if condition
    then ()
    else Panic::Panic(message)
};

def numbers : Set::Set<Int> = Set::SetNew();

Expect(Set::SetInsert(numbers, 10), "SetInsert should add 10");
Expect(Set::SetInsert(numbers, 20), "SetInsert should add 20");
Expect(Set::SetInsert(numbers, 30), "SetInsert should add 30");
Expect(Set::SetCount(numbers) == 3, "SetCount should reflect three inserted elements");

Expect(Set::SetContains(numbers, 10), "SetContains should find 10");
Expect(Set::SetContains(numbers, 20), "SetContains should find 20");
Expect(!Set::SetContains(numbers, 99), "SetContains should reject missing elements");

Expect(!Set::SetInsert(numbers, 10), "SetInsert should reject duplicate elements");
Expect(Set::SetCount(numbers) == 3, "Duplicate SetInsert should not change the count");

Expect(Set::SetRemove(numbers, 20), "SetRemove should remove an existing element");
Expect(!Set::SetContains(numbers, 20), "Removed elements should no longer be present");
Expect(Set::SetCount(numbers) == 2, "SetCount should decrease after removal");
Expect(!Set::SetRemove(numbers, 99), "SetRemove should report false for a missing element");

IO::PrintLine("hashset_basic: PASS");
