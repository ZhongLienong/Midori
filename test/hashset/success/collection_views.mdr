module SetCollectionViews

import
{
    "../../../MidoriPrelude/ArrayUtil.mdr",
    "../../../MidoriPrelude/Collections/Set.mdr",
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}

defun Expect(condition: Bool, message: Text) : Unit => {
    if condition
    then ()
    else Panic::Panic(message)
};

def numbers : Set::Set<Int> = Set::SetNew();

Expect(Set::SetInsert(numbers, 10), "SetInsert should add 10");
Expect(Set::SetInsert(numbers, 20), "SetInsert should add 20");
Expect(Set::SetInsert(numbers, 30), "SetInsert should add 30");
Expect(Set::SetRemove(numbers, 20), "SetRemove should remove 20");
Expect(Set::SetInsert(numbers, 40), "SetInsert should add 40 after a removal");

def values = Set::SetToArray(numbers);

Expect(ArrayUtil::Length(values) == Set::SetCount(numbers), "SetToArray should return one element per occupied slot");
Expect(ArrayUtil::Contains(values, 10), "SetToArray should include 10");
Expect(ArrayUtil::Contains(values, 30), "SetToArray should include 30");
Expect(ArrayUtil::Contains(values, 40), "SetToArray should include 40");
Expect(!ArrayUtil::Contains(values, 20), "SetToArray should not include removed elements");

IO::PrintLine("hashset_collection_views: PASS");
