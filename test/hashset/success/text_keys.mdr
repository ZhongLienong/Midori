module TextKeys

// Test HashSet with Text keys
import 
{
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Collections/Set.mdr"
}

def names : Set::Set<Text> = Set::SetNew();

// Insert strings
Set::SetInsert(names, "Alice");
Set::SetInsert(names, "Bob");
Set::SetInsert(names, "Charlie");

IO::PrintLine("Size: " ++ (Set::SetCount(names) as Text));

// Test contains
def has_alice = Set::SetContains(names, "Alice");
def has_dave = Set::SetContains(names, "Dave");

IO::PrintLine(if has_alice then "Has Alice: true" else "Has Alice: false");
IO::PrintLine(if has_dave then "Has Dave: true" else "Has Dave: false");

// Remove and check
Set::SetRemove(names, "Bob");
def has_bob = Set::SetContains(names, "Bob");
IO::PrintLine(if has_bob then "Has Bob after remove: true" else "Has Bob after remove: false");

IO::PrintLine("Final size: " ++ (Set::SetCount(names) as Text));

IO::PrintLine("hashset_text: PASS");

