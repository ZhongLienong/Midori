module TextKeys

import
{
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Collections/Set.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}

def Expect = fn(condition: Bool, message: Text) -> Unit => {
    if condition
    then ()
    else Panic::Panic(message)
};

def names : Set::Set<Text> = Set::SetNew();

Expect(Set::SetInsert(names, "Alice"), "SetInsert should add Alice");
Expect(Set::SetInsert(names, "Bob"), "SetInsert should add Bob");
Expect(Set::SetInsert(names, "Charlie"), "SetInsert should add Charlie");
Expect(Set::SetCount(names) == 3, "SetCount should reflect the inserted text values");

Expect(Set::SetContains(names, "Alice"), "SetContains should find Alice");
Expect(!Set::SetContains(names, "Dave"), "SetContains should reject missing text values");

Expect(Set::SetRemove(names, "Bob"), "SetRemove should remove Bob");
Expect(!Set::SetContains(names, "Bob"), "Removed text values should no longer be present");
Expect(Set::SetCount(names) == 2, "SetCount should decrease after removing Bob");

IO::PrintLine("hashset_text: PASS");

