module HashSetOperations

import
{
    "../../../MidoriPrelude/Collections/Set.mdr",
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Iterable.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}

def Expect = fn(condition: Bool, message: Text) -> Unit => if condition then () else Panic::Panic(message);

def words0 : Set::Set < Text > = Set::SetEmpty();
def words = Set::SetWith(Set::SetWith(Set::SetWith(words0, "alpha"), "beta"), "alpha");
Expect(Set::SetCount(words) == 2, "a repeated value is stored once");
Expect(Set::SetHas(words, "alpha"), "a text value is found");
Expect(!Set::SetHas(words, "gamma"), "an absent text value is absent");
Expect(#Set::SetToArray(words) == 2, "SetToArray returns every value once");
Expect(#words == 2, "Countable resolves for a set");

def negatives0 : Set::Set < Int > = Set::SetEmpty();
def negatives = Set::SetWith(Set::SetWith(negatives0, - 1), - 33);
Expect(Set::SetHas(negatives, - 1), "a negative value is found");
Expect(Set::SetHas(negatives, - 33), "a second negative value is found");

def removed = Set::SetWithout(words, "alpha");
Expect(Set::SetCount(removed) == 1, "removal decrements");
Expect(!Set::SetHas(removed, "alpha"), "the removed value is gone");
Expect(Set::SetHas(words, "alpha"), "removal leaves the source alone");
Expect(Set::SetCount(Set::SetWithout(words, "absent")) == 2, "removing an absent value is a no-op");

def seen = 0;
for value in Set::SetIterNew(words) {
    seen = seen + 1;
};
Expect(seen == 2, "iteration visits every value exactly once");

def emptied = Set::SetWithout(removed, "beta");
Expect(Set::SetIsEmpty(emptied), "removing everything empties the set");
Expect(Set::SetCount(words) == 2, "the source of the removals is untouched");

IO::PrintLine("set_operations: PASS");
