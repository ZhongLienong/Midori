module ImprovedSetDemo

import
{
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Collections/Set.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}

def Expect = fn(condition: Bool, message: Text) -> Unit => {
    if condition
    then ()
    else Panic::Panic(message)
};

def numbers : Set::Set<Int> = Set::SetNew();
def evens : Set::Set<Int> = Set::SetNew();
def empty_set : Set::Set<Int> = Set::SetNew();

Set::SetInsert(numbers, 1);
Set::SetInsert(numbers, 2);
Set::SetInsert(numbers, 3);
Set::SetInsert(numbers, 4);
Set::SetInsert(numbers, 5);

Set::SetInsert(evens, 2);
Set::SetInsert(evens, 4);
Set::SetInsert(evens, 6);

def union_set = Set::SetUnion(numbers, evens);
def intersection_set = Set::SetIntersection(numbers, evens);
def diff_set = Set::SetDifference(numbers, evens);

Expect(Set::SetCount(numbers) == 5, "SetCount should reflect the inserted number set");
Expect(Set::SetCount(evens) == 3, "SetCount should reflect the inserted evens set");
Expect(Set::SetIsEmpty(empty_set), "SetIsEmpty should report true for a new empty set");
Expect(!Set::SetIsEmpty(numbers), "SetIsEmpty should report false for a populated set");

Expect(Set::SetCount(union_set) == 6, "SetUnion should contain every unique element");
Expect(Set::SetContains(union_set, 1), "SetUnion should keep left-only members");
Expect(Set::SetContains(union_set, 6), "SetUnion should keep right-only members");

Expect(Set::SetCount(intersection_set) == 2, "SetIntersection should keep only the shared elements");
Expect(Set::SetContains(intersection_set, 2), "SetIntersection should contain shared values");
Expect(!Set::SetContains(intersection_set, 1), "SetIntersection should exclude non-shared values");

Expect(Set::SetCount(diff_set) == 3, "SetDifference should remove shared elements from the left set");
Expect(Set::SetContains(diff_set, 1), "SetDifference should keep left-only values");
Expect(!Set::SetContains(diff_set, 2), "SetDifference should exclude shared values");

Set::SetClear(numbers);
Expect(Set::SetCount(numbers) == 0, "SetClear should reset the count to zero");
Expect(Set::SetIsEmpty(numbers), "SetClear should leave the set empty");

IO::PrintLine("improved_set_demo: PASS");

