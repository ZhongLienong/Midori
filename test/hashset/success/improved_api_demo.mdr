module ImprovedSetDemo

import
{
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Collections/Set.mdr"
}

def numbers : Set::Set<Int> = Set::SetNew();
def evens : Set::Set<Int> = Set::SetNew();

Set::SetInsert(numbers, 1);
Set::SetInsert(numbers, 2);
Set::SetInsert(numbers, 3);
Set::SetInsert(numbers, 4);
Set::SetInsert(numbers, 5);

Set::SetInsert(evens, 2);
Set::SetInsert(evens, 4);
Set::SetInsert(evens, 6);

IO::PrintLine("=== Basic operations ===");
IO::PrintLine("Numbers size: " ++ (Set::SetCount(numbers) as Text));
IO::PrintLine("Evens size: " ++ (Set::SetCount(evens) as Text));

IO::PrintLine("=== SetIsEmpty ===");
def empty_set : Set::Set<Int> = Set::SetNew();
IO::PrintLine(if Set::SetIsEmpty(empty_set) then "Empty set is empty" else "Empty set has elements");
IO::PrintLine(if Set::SetIsEmpty(numbers) then "Numbers is empty" else "Numbers has elements");

IO::PrintLine("=== SetUnion ===");
def union_set = Set::SetUnion(numbers, evens);
IO::PrintLine("Union size: " ++ (Set::SetCount(union_set) as Text));
IO::PrintLine("Contains 1: " ++ (if Set::SetContains(union_set, 1) then "true" else "false"));
IO::PrintLine("Contains 6: " ++ (if Set::SetContains(union_set, 6) then "true" else "false"));

IO::PrintLine("=== SetIntersection ===");
def intersection_set = Set::SetIntersection(numbers, evens);
IO::PrintLine("Intersection size: " ++ (Set::SetCount(intersection_set) as Text));
IO::PrintLine("Contains 2: " ++ (if Set::SetContains(intersection_set, 2) then "true" else "false"));
IO::PrintLine("Contains 1: " ++ (if Set::SetContains(intersection_set, 1) then "true" else "false"));

IO::PrintLine("=== SetDifference ===");
def diff_set = Set::SetDifference(numbers, evens);
IO::PrintLine("Difference size: " ++ (Set::SetCount(diff_set) as Text));
IO::PrintLine("Contains 1: " ++ (if Set::SetContains(diff_set, 1) then "true" else "false"));
IO::PrintLine("Contains 2: " ++ (if Set::SetContains(diff_set, 2) then "true" else "false"));

IO::PrintLine("=== SetClear ===");
Set::SetClear(numbers);
IO::PrintLine("After clear, size: " ++ (Set::SetCount(numbers) as Text));
IO::PrintLine(if Set::SetIsEmpty(numbers) then "Numbers is now empty" else "Numbers still has elements");

IO::PrintLine("improved_set_demo: PASS");

