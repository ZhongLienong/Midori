module StressTest

import
{
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Collections/Map.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}

def Expect = fn(condition: Bool, message: Text) -> Unit => {
    if condition
    then ()
    else Panic::Panic(message)
};

def numbers : Map::Map<Int, Int> = Map::MapNew();
def inserted = 0;

for i in 0..1..100 {
    if Map::MapInsert(numbers, i, i * 2)
    then { inserted = inserted + 1; }
    else Panic::Panic("Stress setup should insert a new key for " ++ (i as Text));
};

Expect(Map::MapCount(numbers) == inserted, "Stress insertions should match the reported map count");

for i in 0..1..100 {
    Expect(
        Map::MapGetOr(numbers, i, -1) == i * 2,
        "MapGetOr should return the stress-test value for key " ++ (i as Text)
    );
};

Expect(!Map::MapContains(numbers, 200), "MapContains should reject a missing large key");
Expect(!Map::MapContains(numbers, -1), "MapContains should reject a missing negative key");
Expect(!Map::MapInsert(numbers, 10, 999), "MapInsert should remain insert-only after rehashing");
Expect(Map::MapGetOr(numbers, 10, -1) == 20, "Duplicate insertion after rehashing should preserve the stored value");

IO::PrintLine("hashmap_stress: PASS");

