module BasicOperations

import
{
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Collections/Map.mdr",
    "../../../MidoriPrelude/Prelude/Option.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}
use Option.{Option}

def Expect = fn(condition: Bool, message: Text) -> Unit => {
    if condition
    then ()
    else Panic::Panic(message)
};

def ExpectSomeInt = fn(result: Option<Int>, expected: Int, message: Text) -> Unit => {
    match result with
        case Option::Some(value) => Expect(value == expected, message)
        case Option::None() => Panic::Panic(message)
};

def ages : Map::Map<Text, Int> = Map::MapNew();

Expect(Map::MapInsert(ages, "Alice", 25), "MapInsert should add Alice");
Expect(Map::MapInsert(ages, "Bob", 30), "MapInsert should add Bob");
Expect(Map::MapInsert(ages, "Charlie", 35), "MapInsert should add Charlie");
Expect(Map::MapCount(ages) == 3, "MapCount should reflect three inserted entries");

ExpectSomeInt(Map::MapGet(ages, "Alice"), 25, "MapGet should return Alice's value");
ExpectSomeInt(Map::MapGet(ages, "Bob"), 30, "MapGet should return Bob's value");
Expect(Map::MapContains(ages, "Alice"), "MapContains should find inserted keys");
Expect(!Map::MapContains(ages, "Dave"), "MapContains should reject missing keys");

Expect(!Map::MapInsert(ages, "Alice", 26), "MapInsert should reject duplicate keys");
ExpectSomeInt(Map::MapGet(ages, "Alice"), 25, "Duplicate MapInsert should preserve the original value");
Expect(Map::MapCount(ages) == 3, "Duplicate MapInsert should not change the count");

Expect(Map::MapRemove(ages, "Bob"), "MapRemove should remove an existing key");
Expect(!Map::MapContains(ages, "Bob"), "Removed keys should no longer be present");
Expect(!Map::MapRemove(ages, "Bob"), "MapRemove should report false when the key is already absent");
Expect(Map::MapCount(ages) == 2, "MapCount should decrease after removal");

IO::PrintLine("hashmap_basic: PASS");

