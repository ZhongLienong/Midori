module FloatKeys

import
{
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Collections/Map.mdr",
    "../../../MidoriPrelude/Prelude/Option.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}
use Option.{Option}

defun Expect(condition: Bool, message: Text) -> Unit => {
    if condition
    then ()
    else Panic::Panic(message)
};

defun ExpectSomeText(result: Option<Text>, expected: Text, message: Text) -> Unit => {
    match result with
        case Option::Some(value) => Expect(value == expected, message)
        case Option::None() => Panic::Panic(message)
};

def measurements : Map::Map<Float, Text> = Map::MapNew();

Expect(Map::MapInsert(measurements, 3.14, "Pi"), "MapInsert should add 3.14");
Expect(Map::MapInsert(measurements, 2.71, "Euler"), "MapInsert should add 2.71");
Expect(Map::MapInsert(measurements, 1.41, "Sqrt2"), "MapInsert should add 1.41");
Expect(Map::MapCount(measurements) == 3, "MapCount should reflect the float-key inserts");

ExpectSomeText(Map::MapGet(measurements, 3.14), "Pi", "MapGet should find the 3.14 entry");
ExpectSomeText(Map::MapGet(measurements, 2.71), "Euler", "MapGet should find the 2.71 entry");
Expect(!Map::MapContains(measurements, 9.99), "MapContains should reject missing float keys");

IO::PrintLine("hashmap_float: PASS");

