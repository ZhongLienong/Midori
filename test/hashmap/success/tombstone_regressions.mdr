module MapTombstoneRegressions

import
{
    "../../../MidoriPrelude/Collections/Map.mdr",
    "../../../MidoriPrelude/Equatable.mdr",
    "../../../MidoriPrelude/Hashable.mdr",
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Prelude/Option.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}
use Option.{Option}

struct CollisionKey
{
    id: Int
};

instance Equatable<CollisionKey>
{
    def Equals = fn(a: CollisionKey, b: CollisionKey) -> Bool => a.id == b.id;
};

instance Hashable<CollisionKey>
{
    def Hash = fn(value: CollisionKey) -> Int => 1;
};

def Expect = fn(condition: Bool, message: Text) -> Unit => {
    if condition
    then ()
    else Panic::Panic(message)
};

def ExpectSomeText = fn(result: Option<Text>, expected: Text, message: Text) -> Unit => {
    match result with
        case Option::Some(value) => Expect(value == expected, message)
        case Option::None() => Panic::Panic(message)
};

def ExpectNoneText = fn(result: Option<Text>, message: Text) -> Unit => {
    match result with
        case Option::Some(_) => Panic::Panic(message)
        case Option::None() => ()
};

def reinserted : Map::Map<CollisionKey, Text> = Map::MapNew();
def key1 = CollisionKey(1);

Expect(Map::MapInsert(reinserted, key1, "one"), "MapInsert should add the first colliding key");
Expect(Map::MapRemove(reinserted, CollisionKey(1)), "MapRemove should remove the original key");
Expect(Map::MapInsert(reinserted, CollisionKey(1), "one-again"), "MapInsert should allow reinserting a removed key");
Expect(Map::MapCount(reinserted) == 1, "Reinserting the same key should leave exactly one logical entry");
ExpectSomeText(Map::MapGet(reinserted, CollisionKey(1)), "one-again", "Reinsertion should store the replacement value");

def collisions : Map::Map<CollisionKey, Text> = Map::MapNew();
def key2 = CollisionKey(2);
def key3 = CollisionKey(3);
def key4 = CollisionKey(4);
def missing = CollisionKey(99);

Expect(Map::MapInsert(collisions, key1, "one"), "MapInsert should add the first colliding entry");
Expect(Map::MapInsert(collisions, key2, "two"), "MapInsert should add the second colliding entry");
Expect(Map::MapInsert(collisions, key3, "three"), "MapInsert should add the third colliding entry");
Expect(Map::MapRemove(collisions, CollisionKey(1)), "MapRemove should create a tombstone in the collision chain");

Expect(Map::MapContains(collisions, CollisionKey(2)), "Lookup should continue past tombstones for later colliding keys");
ExpectSomeText(Map::MapGet(collisions, CollisionKey(3)), "three", "MapGet should find entries beyond a tombstone");

Expect(!Map::MapInsert(collisions, CollisionKey(2), "two-updated"), "MapInsert should reject an existing colliding key after a tombstone");
ExpectSomeText(Map::MapGet(collisions, CollisionKey(2)), "two", "Duplicate MapInsert should preserve the original colliding value");
Expect(Map::MapCount(collisions) == 2, "Duplicate MapInsert should not change the count after tombstone reuse checks");

Expect(Map::MapInsert(collisions, key4, "four"), "A new colliding key should reuse the tombstone slot");
ExpectSomeText(Map::MapGet(collisions, CollisionKey(4)), "four", "Inserted keys should remain retrievable after tombstone reuse");

ExpectNoneText(Map::MapUpdate(collisions, missing, "missing"), "MapUpdate should not insert a missing colliding key");
Expect(!Map::MapContains(collisions, missing), "MapUpdate should leave missing keys absent");
ExpectSomeText(Map::MapUpdate(collisions, CollisionKey(3), "three-new"), "three", "MapUpdate should return the previous value for an existing key");
ExpectSomeText(Map::MapGet(collisions, CollisionKey(3)), "three-new", "MapUpdate should replace the stored value for an existing key");

IO::PrintLine("hashmap_tombstone_regressions: PASS");
