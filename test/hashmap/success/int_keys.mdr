module IntKeys

import
{
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Collections/Map.mdr",
    "../../../MidoriPrelude/Prelude/Option.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}
use Option.{Option}

defun Expect(condition: Bool, message: Text) -> Unit => {
    if condition
    then ()
    else Panic::Panic(message)
};

defun ExpectSomeText(result: Option<Text>, expected: Text, message: Text) -> Unit => {
    match result with
        case Option::Some(value) => Expect(value == expected, message)
        case Option::None() => Panic::Panic(message)
};

def scores : Map::Map<Int, Text> = Map::MapNew();

Expect(Map::MapInsert(scores, 1, "First Place"), "MapInsert should add the first integer key");
Expect(Map::MapInsert(scores, 2, "Second Place"), "MapInsert should add the second integer key");
Expect(Map::MapInsert(scores, 3, "Third Place"), "MapInsert should add the third integer key");
Expect(Map::MapCount(scores) == 3, "MapCount should reflect the integer-key inserts");

ExpectSomeText(Map::MapGet(scores, 1), "First Place", "MapGet should return the first integer-key value");
ExpectSomeText(Map::MapGet(scores, 2), "Second Place", "MapGet should return the second integer-key value");
Expect(!Map::MapContains(scores, 10), "MapContains should reject missing integer keys");

IO::PrintLine("hashmap_int: PASS");

