module MapCollectionViews

import
{
    "../../../MidoriPrelude/ArrayUtil.mdr",
    "../../../MidoriPrelude/Collections/Map.mdr",
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}

defun Expect(condition: Bool, message: Text) : Unit => {
    if condition
    then ()
    else Panic::Panic(message)
};

def ages : Map::Map<Text, Int> = Map::MapNew();

Expect(Map::MapInsert(ages, "Alice", 25), "MapInsert should add Alice");
Expect(Map::MapInsert(ages, "Bob", 30), "MapInsert should add Bob");
Expect(Map::MapInsert(ages, "Charlie", 35), "MapInsert should add Charlie");
Expect(Map::MapRemove(ages, "Bob"), "MapRemove should create a deleted slot for Bob");
Expect(Map::MapInsert(ages, "Dana", 40), "MapInsert should add Dana after a removal");

def keys = Map::MapKeys(ages);
Expect(ArrayUtil::Length(keys) == Map::MapCount(ages), "MapKeys should return one key per occupied entry");
Expect(ArrayUtil::Contains(keys, "Alice"), "MapKeys should include Alice");
Expect(ArrayUtil::Contains(keys, "Charlie"), "MapKeys should include Charlie");
Expect(ArrayUtil::Contains(keys, "Dana"), "MapKeys should include Dana");
Expect(!ArrayUtil::Contains(keys, "Bob"), "MapKeys should not include removed keys");

def values = Map::MapValues(ages);
Expect(ArrayUtil::Length(values) == Map::MapCount(ages), "MapValues should return one value per occupied entry");
Expect(ArrayUtil::Contains(values, 25), "MapValues should include Alice's value");
Expect(ArrayUtil::Contains(values, 35), "MapValues should include Charlie's value");
Expect(ArrayUtil::Contains(values, 40), "MapValues should include Dana's value");
Expect(!ArrayUtil::Contains(values, 30), "MapValues should not include removed values");

def entries = Map::MapEntries(ages);
Expect(ArrayUtil::Length(entries) == Map::MapCount(ages), "MapEntries should return one entry per occupied slot");

def saw_alice = false;
def saw_charlie = false;
def saw_dana = false;
def index = 0;

loop {
    if index >= ArrayUtil::Length(entries)
    then break ()
    else {
        def entry = entries[index];
        if entry.key == "Alice"
        then {
            Expect(entry.value == 25, "MapEntries should keep Alice's value");
            saw_alice = true;
        }
        else if entry.key == "Charlie"
        then {
            Expect(entry.value == 35, "MapEntries should keep Charlie's value");
            saw_charlie = true;
        }
        else if entry.key == "Dana"
        then {
            Expect(entry.value == 40, "MapEntries should keep Dana's value");
            saw_dana = true;
        }
        else Panic::Panic("MapEntries should not expose removed or unexpected keys");
        index = index + 1;
    }
};

Expect(saw_alice, "MapEntries should include Alice");
Expect(saw_charlie, "MapEntries should include Charlie");
Expect(saw_dana, "MapEntries should include Dana");

IO::PrintLine("hashmap_collection_views: PASS");
