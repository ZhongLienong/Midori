module ImprovedApiDemo

import
{
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Collections/Map.mdr",
    "../../../MidoriPrelude/Prelude/Option.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}

use Option.{Option}

def Expect = fn(condition: Bool, message: Text) -> Unit => {
    if condition
    then ()
    else Panic::Panic(message)
};

def ExpectSomeInt = fn(result: Option<Int>, expected: Int, message: Text) -> Unit => {
    match result with
        case Option::Some(value) => Expect(value == expected, message)
        case Option::None() => Panic::Panic(message)
};

def ExpectNoneInt = fn(result: Option<Int>, message: Text) -> Unit => {
    match result with
        case Option::Some(_) => Panic::Panic(message)
        case Option::None() => ()
};

def scores : Map::Map<Text, Int> = Map::MapNew();

Expect(Map::MapInsert(scores, "Alice", 100), "MapInsert should add Alice");
Expect(Map::MapInsert(scores, "Bob", 85), "MapInsert should add Bob");
Expect(Map::MapInsert(scores, "Charlie", 92), "MapInsert should add Charlie");

ExpectSomeInt(Map::MapGet(scores, "Alice"), 100, "MapGet should return Alice's score");
Expect(Map::MapGetOr(scores, "Dave", 0) == 0, "MapGetOr should use the default for missing keys");
Expect(Map::MapGetOr(scores, "Bob", 0) == 85, "MapGetOr should return the stored value for existing keys");

ExpectSomeInt(Map::MapUpdate(scores, "Alice", 105), 100, "MapUpdate should return Alice's previous score");
ExpectSomeInt(Map::MapGet(scores, "Alice"), 105, "MapUpdate should replace Alice's stored value");
ExpectNoneInt(Map::MapUpdate(scores, "Dana", 88), "MapUpdate should not insert missing keys");
Expect(!Map::MapContains(scores, "Dana"), "MapUpdate should leave missing keys absent");

Expect(!Map::MapIsEmpty(scores), "MapIsEmpty should report false for a populated map");
Map::MapClear(scores);
Expect(Map::MapCount(scores) == 0, "MapClear should reset the count to zero");
Expect(Map::MapIsEmpty(scores), "MapClear should leave the map empty");

IO::PrintLine("improved_api_demo: PASS");

