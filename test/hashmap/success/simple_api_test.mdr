module SimpleHashMapTest

import
{
    "../../../MidoriPrelude/Collections/Map.mdr",
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}

defun Expect(condition: Bool, message: Text) : Unit => {
    if condition
    then ()
    else Panic::Panic(message)
};

def scores : Map::Map<Int, Int> = Map::MapNew();

Expect(Map::MapIsEmpty(scores), "MapNew should create an empty map");
Expect(Map::MapInsert(scores, 1, 100), "MapInsert should add the first entry");
Expect(Map::MapInsert(scores, 2, 85), "MapInsert should add the second entry");
Expect(Map::MapGetOr(scores, 1, 0) == 100, "MapGetOr should return the stored value");
Expect(Map::MapGetOr(scores, 999, -1) == -1, "MapGetOr should return the default for a missing key");
Expect(!Map::MapIsEmpty(scores), "MapIsEmpty should report false after insertion");

Map::MapClear(scores);
Expect(Map::MapIsEmpty(scores), "MapClear should leave the map empty");
Expect(Map::MapCount(scores) == 0, "MapClear should reset the count");

IO::PrintLine("hashmap_simple_api: PASS");


