module SimpleHashMapTest

import
{
    "../../../MidoriPrelude/Collections/Map.mdr"
}

def scores : Map::Map<Int, Int> = Map::MapNew();

Map::MapInsert(scores, 1, 100);
Map::MapInsert(scores, 2, 85);

def result1 = Map::MapGetOr(scores, 1, 0);
def result2 = Map::MapGetOr(scores, 999, -1);

def is_empty1 = Map::MapIsEmpty(scores);
Map::MapClear(scores);
def is_empty2 = Map::MapIsEmpty(scores);

