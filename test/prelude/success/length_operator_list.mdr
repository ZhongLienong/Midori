module TestPreludeLengthOperatorList

import { "../../../MidoriPrelude/IO.mdr", "../../../MidoriPrelude/Prelude/List.mdr" }
use List.{List}

def list = new List::Cons(1, new List::Cons(2, new List::Nil()));
def len = #list;

if len == 2
then IO::PrintLine("length_operator_list: PASS")
else IO::PrintLine("length_operator_list: FAIL");
