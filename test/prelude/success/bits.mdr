module PreludeBits

import { "../../../MidoriPrelude/Collections/Bits.mdr", "../../../MidoriPrelude/IO.mdr", "../../../MidoriPrelude/Prelude/Panic.mdr" }

def Expect = fn(condition: Bool, message: Text) -> Unit => if condition then () else Panic::Panic(message);

Expect(Bits::PopCount(0) == 0, "PopCount of zero");
Expect(Bits::PopCount(1) == 1, "PopCount of one");
Expect(Bits::PopCount(7) == 3, "PopCount of 0b111");
Expect(Bits::PopCount(65535) == 16, "PopCount of 0xFFFF");
Expect(Bits::PopCount(-1) == 32, "PopCount counts only the 32-bit window");

Expect(Bits::BitAt(0) == 1, "BitAt 0");
Expect(Bits::BitAt(5) == 32, "BitAt 5");

Expect(Bits::HasBit(5, 0), "HasBit 0 of 0b101");
Expect(Bits::HasBit(5, 2), "HasBit 2 of 0b101");
Expect(!Bits::HasBit(5, 1), "HasBit 1 of 0b101 is clear");

// 0b1011: slots below bit 3 are bits 0, 1 and 3 -> two occupied below bit 3.
Expect(Bits::SparseIndex(11, 0) == 0, "SparseIndex of the lowest bit");
Expect(Bits::SparseIndex(11, 1) == 1, "SparseIndex counts bits below");
Expect(Bits::SparseIndex(11, 3) == 2, "SparseIndex skips the clear bit");

Expect(Bits::HashChunk(31, 0) == 31, "HashChunk takes the low five bits");
Expect(Bits::HashChunk(32, 0) == 0, "HashChunk masks above five bits");
Expect(Bits::HashChunk(32, 1) == 1, "HashChunk at depth one");
Expect(Bits::HashChunk(-1, 0) == 31, "HashChunk of a negative hash stays in range");

IO::PrintLine("bits: PASS");
