module PreludeArrayUtilWith

import { "../../../MidoriPrelude/ArrayUtil.mdr", "../../../MidoriPrelude/IO.mdr", "../../../MidoriPrelude/Prelude/Panic.mdr" }

def Expect = fn(condition: Bool, message: Text) -> Unit => if condition then () else Panic::Panic(message);

def Show = fn(array: Array < Int >) -> Text => {
    def parts : Array < Text > = [array[i] as Text for i in 0..1..ArrayUtil::Length(array)];
    if ArrayUtil::Length(parts) == 0 then "-" else ArrayUtil::Length(parts) as Text ++ ":" ++ parts[0] ++ ":" ++ parts[ArrayUtil::Length(parts) - 1]
};

def base = [10, 20, 30];
def empty : Array < Int > = [];

// The original must survive every operation.
def appended = ArrayUtil::WithAppended(base, 40);
Expect(ArrayUtil::Length(base) == 3, "WithAppended must not modify the original");
Expect((ArrayUtil::Length(appended) == 4) && (appended[3] == 40), "WithAppended appends");
Expect(ArrayUtil::Length(ArrayUtil::WithAppended(empty, 1)) == 1, "WithAppended on empty");

def replaced = ArrayUtil::WithReplaced(base, 1, 99);
Expect((replaced[1] == 99) && (base[1] == 20), "WithReplaced replaces without touching the original");
Expect(ArrayUtil::WithReplaced(base, 0, 5)[0] == 5, "WithReplaced at index 0");
Expect(ArrayUtil::WithReplaced(base, 2, 7)[2] == 7, "WithReplaced at the last index");

def inserted = ArrayUtil::WithInserted(base, 1, 15);
Expect(ArrayUtil::Length(inserted) == 4, "WithInserted grows by one");
Expect((inserted[0] == 10) && (inserted[1] == 15) && (inserted[2] == 20) && (inserted[3] == 30), "WithInserted shifts the tail");
Expect(ArrayUtil::WithInserted(base, 0, 1)[0] == 1, "WithInserted at the front");
Expect(ArrayUtil::WithInserted(base, 3, 40)[3] == 40, "WithInserted past the last index appends");
Expect(ArrayUtil::Length(ArrayUtil::WithInserted(empty, 0, 1)) == 1, "WithInserted into empty");

def removed = ArrayUtil::WithRemoved(base, 1);
Expect((ArrayUtil::Length(removed) == 2) && (removed[0] == 10) && (removed[1] == 30), "WithRemoved closes the gap");
Expect(ArrayUtil::Length(base) == 3, "WithRemoved must not modify the original");
Expect(ArrayUtil::Length(ArrayUtil::WithRemoved([7], 0)) == 0, "WithRemoved of the only element gives empty");
Expect(ArrayUtil::Length(ArrayUtil::WithRemoved(base, 9)) == 3, "WithRemoved past the end copies");
Expect(ArrayUtil::Length(ArrayUtil::WithRemoved(empty, 0)) == 0, "WithRemoved on empty");

IO::PrintLine(Show(appended));
IO::PrintLine(Show(inserted));
IO::PrintLine(Show(removed));
IO::PrintLine("array_util_with: PASS");
