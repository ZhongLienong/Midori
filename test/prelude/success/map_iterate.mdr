module PreludeMapIterate

import
{
    "../../../MidoriPrelude/Collections/Map.mdr",
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Iterable.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}

def Expect = fn(condition: Bool, message: Text) -> Unit => if condition then () else Panic::Panic(message);

def InsertRange = fn(map: Map::Map < Int, Int >, next: Int, stop: Int) -> Map::Map < Int, Int > =>
    if next >= stop then map else InsertRange(Map::With(map, next, next * 10), next + 1, stop);

// 80 keys forces a trie more than one level deep.
def seed : Map::Map < Int, Int > = Map::Empty();
def wide = InsertRange(seed, 0, 80);

// Every entry exactly once: sum the keys and count the visits.
def visited = 0;
def key_total = 0;
def value_total = 0;
for entry in Map::IterNew(wide) {
    visited = visited + 1;
    key_total = key_total + entry.key;
    value_total = value_total + entry.value;
};

Expect(visited == 80, "iteration visits every entry exactly once");
Expect(key_total == 3160, "every key is seen once and only once");
Expect(value_total == 31600, "every value accompanies its key");

def empty : Map::Map < Int, Int > = Map::Empty();
def empty_visits = 0;
for entry in Map::IterNew(empty) {
    empty_visits = empty_visits + 1;
};
Expect(empty_visits == 0, "an empty map yields nothing");

// Iterating must not disturb the map.
Expect(Map::Count(wide) == 80, "iteration leaves the map alone");
Expect(Map::GetOr(wide, 40, - 1) == 400, "the map still reads after iteration");

IO::PrintLine("map_iterate: PASS");
