module PreludeSetPersistent

import
{
    "../../../MidoriPrelude/Collections/Set.mdr",
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Iterable.mdr",
    "../../../MidoriPrelude/Prelude/Option.mdr",
    "../../../MidoriPrelude/Prelude/Panic.mdr"
}

use Option.{ Option }

def Expect = fn(condition: Bool, message: Text) -> Unit => if condition then () else Panic::Panic(message);

def AddRange = fn(set: Set::Set < Int >, next: Int, stop: Int) -> Set::Set < Int > =>
    if next >= stop then set else AddRange(Set::SetWith(set, next), next + 1, stop);

def seed : Set::Set < Int > = Set::SetEmpty();
Expect(Set::SetCount(seed) == 0, "a new set is empty");
Expect(Set::SetIsEmpty(seed), "a new set reports empty");
Expect(!Set::SetHas(seed, 1), "a new set holds nothing");

def one = Set::SetWith(seed, 1);
def two = Set::SetWith(one, 2);
Expect(Set::SetCount(seed) == 0, "adding does not disturb the source");
Expect(Set::SetCount(one) == 1, "the first set keeps its size");
Expect(Set::SetCount(two) == 2, "the second set has both");
Expect(!Set::SetHas(one, 2), "the earlier set does not gain the later value");

def again = Set::SetWith(two, 1);
Expect(Set::SetCount(again) == 2, "adding a present value does not grow the set");

def wide = AddRange(seed, 0, 80);
Expect(Set::SetCount(wide) == 80, "every value is counted once");
Expect(Set::SetHas(wide, 79), "the last value is present");
Expect(!Set::SetHas(wide, 80), "an absent value is absent");

def shrunk = Set::SetWithout(wide, 40);
Expect(Set::SetCount(shrunk) == 79, "removal decrements");
Expect(!Set::SetHas(shrunk, 40), "the removed value is gone");
Expect(Set::SetHas(wide, 40), "removal leaves the source alone");

def Tally = fn(state: Set::SetIter < Int >, seen: Int, sum: Int) -> (Int, Int) =>
    match Iterable::Next(state) with
        case Option::Some(step) => {
            def (value, rest) = step;
            Tally(rest, seen + 1, sum + value)
        }
        case Option::None() => (seen, sum);

def (visited, total) = Tally(Set::SetIterNew(wide), 0, 0);
Expect(visited == 80, "iteration visits every value exactly once");
Expect(total == 3160, "every value is seen once and only once");

Expect(#Set::SetToArray(wide) == 80, "SetToArray returns every value");

IO::PrintLine("set_persistent: PASS");
