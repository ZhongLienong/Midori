module ListLargeRoundtrip

import
{
	"../../../MidoriPrelude/IO.mdr",
	"../../../MidoriPrelude/ArrayUtil.mdr",
	"../../../MidoriPrelude/Prelude/List.mdr",
}

// Regression: ListFromArray built the list front-to-back, which put the
// recursive call inside Cons and so was not a tail call -- it overflowed the
// stack at roughly 3333 elements. ListToArray copied the whole array per
// element and was quadratic: 34.6s for 40000 elements against 0.16s now.
// 8000 is comfortably past the old stack limit while keeping the test quick.
def N = 8000;
def source = [i for i in 0..1..N];
def roundtrip = List::ListToArray(List::ListFromArray(source));

IO::PrintLine(ArrayUtil::Length(roundtrip) as Text);
IO::PrintLine(roundtrip[0] as Text);
IO::PrintLine(roundtrip[N - 1] as Text);
