module WordBasic

// Basic Word Type Tests
import { "../../MidoriPrelude/IO.mdr" }

IO::PrintLine("=== Word Basic Operations Test ===");

// Arithmetic
def w1: Word = 1000 as Word;
def w2: Word = 500 as Word;
def w_add: Word = w1 + w2;
def w_sub: Word = w1 - w2;
def w_mul: Word = (10 as Word) * (5 as Word);
def w_div: Word = w1 / (4 as Word);
def w_mod: Word = w1 % (7 as Word);

IO::Print("Addition (1000 + 500): ");
IO::PrintLine(w_add as Text);
IO::Print("Subtraction (1000 - 500): ");
IO::PrintLine(w_sub as Text);
IO::Print("Multiplication (10 * 5): ");
IO::PrintLine(w_mul as Text);
IO::Print("Division (1000 / 4): ");
IO::PrintLine(w_div as Text);
IO::Print("Modulo (1000 % 7): ");
IO::PrintLine(w_mod as Text);

// Comparisons
IO::PrintLine("");
IO::PrintLine("=== Comparisons ===");
def cmp1: Bool = w1 > w2;
def cmp2: Bool = w1 < w2;
def cmp3: Bool = w1 == (1000 as Word);
def cmp4: Bool = w1 != w2;

IO::Print("1000 > 500: ");
if cmp1 then { IO::PrintLine("true"); } else { IO::PrintLine("false"); };
IO::Print("1000 < 500: ");
if cmp2 then { IO::PrintLine("true"); } else { IO::PrintLine("false"); };
IO::Print("1000 == 1000: ");
if cmp3 then { IO::PrintLine("true"); } else { IO::PrintLine("false"); };
IO::Print("1000 != 500: ");
if cmp4 then { IO::PrintLine("true"); } else { IO::PrintLine("false"); };

// Large values
IO::PrintLine("");
IO::PrintLine("=== Large Values ===");
def large1: Word = 1000000000 as Word;
def large2: Word = 500000000 as Word;
def large_add: Word = large1 + large2;

IO::Print("1000000000 + 500000000: ");
IO::PrintLine(large_add as Text);

IO::PrintLine("=== Test Complete ===");
