module TextLiterals

import
{
    <IO>
}

IO::PrintLine("=== Text Literal Tests ===");

// Empty and simple strings
def empty = "";
def single_char = "a";
def word = "hello";
def sentence = "The quick brown fox jumps over the lazy dog.";

IO::PrintLine("Empty string: '" ++ empty ++ "'");
IO::PrintLine("Single char: '" ++ single_char ++ "'");
IO::PrintLine("Word: '" ++ word ++ "'");
IO::PrintLine("Sentence: " ++ sentence);

// Strings with spaces and punctuation
def with_spaces = "  spaced  out  ";
def with_punctuation = "Hello, World! How are you?";
def with_numbers = "The answer is 42.";

IO::PrintLine("With spaces: '" ++ with_spaces ++ "'");
IO::PrintLine("With punctuation: " ++ with_punctuation);
IO::PrintLine("With numbers: " ++ with_numbers);

// Escape sequences
def with_newline = "Line 1\nLine 2\nLine 3";
def with_tab = "Column1\tColumn2\tColumn3";
def with_quote = "She said, \"Hello!\"";
def with_backslash = "Path: C:\\Users\\Documents";

IO::PrintLine("With newline:");
IO::PrintLine(with_newline);
IO::PrintLine("With tab: " ++ with_tab);
IO::PrintLine("With quote: " ++ with_quote);
IO::PrintLine("With backslash: " ++ with_backslash);

// Unicode strings
def chinese = "你好世界";
def japanese = "こんにちは世界";
def korean = "안녕하세요";
def russian = "Привет мир";
def arabic = "مرحبا بالعالم";
def greek = "Γεια σου κόσμε";

IO::PrintLine("Chinese: " ++ chinese);
IO::PrintLine("Japanese: " ++ japanese);
IO::PrintLine("Korean: " ++ korean);
IO::PrintLine("Russian: " ++ russian);
IO::PrintLine("Arabic: " ++ arabic);
IO::PrintLine("Greek: " ++ greek);

// Emoji and special symbols
def emoji_faces = "😀😃😄😁😆😅🤣😂";
def emoji_hearts = "❤️💛💚💙💜🖤🤍🤎";
def emoji_animals = "🐶🐱🐭🐹🐰🦊🐻🐼";
def symbols = "★☆♠♣♥♦•◦∘∙⋆";
def math_symbols = "∑∏∫√∞≠≈≤≥";

IO::PrintLine("Emoji faces: " ++ emoji_faces);
IO::PrintLine("Emoji hearts: " ++ emoji_hearts);
IO::PrintLine("Emoji animals: " ++ emoji_animals);
IO::PrintLine("Symbols: " ++ symbols);
IO::PrintLine("Math symbols: " ++ math_symbols);

// Mixed Unicode
def mixed = "English + 中文 + 日本語 + Emoji 🌍";
def accented = "Café, naïve, résumé, Zürich";

IO::PrintLine("Mixed: " ++ mixed);
IO::PrintLine("Accented: " ++ accented);

// String concatenation
def part1 = "Hello";
def part2 = "World";
def combined = part1 ++ " " ++ part2 ++ "!";

IO::PrintLine("Concatenated: " ++ combined);

// Long strings
def long_text = "This is a very long string that contains many characters and demonstrates that Midori can handle longer text literals without any issues. It includes multiple sentences and various punctuation marks!";

IO::PrintLine("Long text: " ++ long_text);

IO::PrintLine("=== All Text Tests Passed ===");
