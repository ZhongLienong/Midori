module channel_pingpong

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

def Ponger = fn(ch_in: Channel<Text>, ch_out: Channel<Text>) -> Int => {
    def msg = <- ch_in;
    PrintLine("Ponger received: " ++ msg);
    ch_out -> "pong";
    0
};

def ping_ch : Channel<Text> = Concurrency::MakeChannel(1);
def pong_ch : Channel<Text> = Concurrency::MakeChannel(1);

def w = Concurrency::Spawn((ping_ch, pong_ch), Ponger);

ping_ch -> "ping";
def reply = <- pong_ch;
PrintLine("Main received: " ++ reply);

Concurrency::Close(ping_ch);
Concurrency::Close(pong_ch);
def r = Concurrency::JoinedOrPanic(Concurrency::Join(w));
