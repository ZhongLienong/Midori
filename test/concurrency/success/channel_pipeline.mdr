module channel_pipeline

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

// Defined before the stages: a worker rebuilds its globals by name, and forward
// references do not resolve across a spawn.
def Double = fn(in_ch: Channel<Int>, out_ch: Channel<Int>, i: Int, count: Int) -> Unit =>
    if i >= count
    then ()
    else
    {
        def val = <- in_ch;
        out_ch -> (val * 2);
        Double(in_ch, out_ch, i + 1, count)
    };

def AddTen = fn(in_ch: Channel<Int>, out_ch: Channel<Int>, i: Int, count: Int) -> Unit =>
    if i >= count
    then ()
    else
    {
        def val = <- in_ch;
        out_ch -> (val + 10);
        AddTen(in_ch, out_ch, i + 1, count)
    };

def Stage1_Double = fn(in_ch: Channel<Int>, out_ch: Channel<Int>, count: Int) -> Int => {
    Double(in_ch, out_ch, 0, count);
    0
};

def Stage2_AddTen = fn(in_ch: Channel<Int>, out_ch: Channel<Int>, count: Int) -> Int => {
    AddTen(in_ch, out_ch, 0, count);
    0
};

def count = 5;
def ch_input = channel<Int>(count);
def ch_mid = channel<Int>(count);
def ch_output = channel<Int>(count);

def w1 = spawn Stage1_Double(ch_input, ch_mid, count);
def w2 = spawn Stage2_AddTen(ch_mid, ch_output, count);

ch_input -> 1;
ch_input -> 5;
ch_input -> 10;
ch_input -> 0;
ch_input -> 100;

def Drain = fn(source: Channel<Int>, i: Int, limit: Int) -> Unit =>
    if i >= limit
    then ()
    else
    {
        PrintLine("out=" ++ ((<- source) as Text));
        Drain(source, i + 1, limit)
    };

Drain(ch_output, 0, count);

close(ch_input);
close(ch_mid);
close(ch_output);
def _r1 = join w1;
def _r2 = join w2;
