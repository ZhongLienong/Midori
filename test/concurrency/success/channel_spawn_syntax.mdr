module channel_spawn_syntax

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

def Producer = fn(ch: Channel<Text>) -> Int => {
    ch -> "left";
    ch -> "right";
    close(ch);
    7
};

def ch = channel<Text>(2);
def worker = spawn Producer(ch);
def first = <- ch;
def second = <- ch;
def result = Concurrency::JoinedOrPanic(join worker);

PrintLine(first ++ "," ++ second ++ "," ++ (result as Text));
