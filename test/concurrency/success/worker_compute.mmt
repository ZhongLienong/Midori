module worker_compute

import { "../../../MarmotPrelude/Concurrency.mmt", "../../../MarmotPrelude/Prelude/Result.mmt" }

import { "../../../MarmotPrelude/IO.mmt" }
use IO.{PrintLine}

// Defined before SumRange: a worker rebuilds its globals by name, and forward
// references do not resolve across a spawn.
def SumTo = fn(i: Int, end_val: Int) -> Int =>
    if i > end_val then 0 else i + SumTo(i + 1, end_val);

def SumRange = fn(ch: Channel<Int>, start: Int, end_val: Int) -> Int => {
    ch -> SumTo(start, end_val);
    0
};

def ch1 : Channel<Int> = Concurrency::MakeChannel(1);
def ch2 : Channel<Int> = Concurrency::MakeChannel(1);
def ch3 : Channel<Int> = Concurrency::MakeChannel(1);
def ch4 : Channel<Int> = Concurrency::MakeChannel(1);

def w1 = Concurrency::Spawn((ch1, 1, 250), SumRange);
def w2 = Concurrency::Spawn((ch2, 251, 500), SumRange);
def w3 = Concurrency::Spawn((ch3, 501, 750), SumRange);
def w4 = Concurrency::Spawn((ch4, 751, 1000), SumRange);

def s1 = <- ch1;
def s2 = <- ch2;
def s3 = <- ch3;
def s4 = <- ch4;

def total = s1 + s2 + s3 + s4;
PrintLine("Sum 1..1000 = " ++ (total as Text));

Concurrency::Close(ch1);
Concurrency::Close(ch2);
Concurrency::Close(ch3);
Concurrency::Close(ch4);
def _r1 = Concurrency::JoinedOrPanic(Concurrency::Join(w1));
def _r2 = Concurrency::JoinedOrPanic(Concurrency::Join(w2));
def _r3 = Concurrency::JoinedOrPanic(Concurrency::Join(w3));
def _r4 = Concurrency::JoinedOrPanic(Concurrency::Join(w4));
