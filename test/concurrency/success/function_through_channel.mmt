module FunctionThroughChannel

import
{
	"../../../MarmotPrelude/Concurrency.mmt",
	"../../../MarmotPrelude/Prelude/Result.mmt",
	"../../../MarmotPrelude/IO.mmt"
}

// A channel serializes what it carries, so a function travels through one the way
// it travels to a worker: procedure index plus a copy of its captured cells.

def scale = 3;
def channel : Channel<fn(Int) -> Int> = Concurrency::MakeChannel(1);

channel -> fn(n : Int) -> Int => n * scale;
def received = <- channel;
IO::PrintLine("received applies: " ++ (received(14) as Text));

// And back out of a worker that was handed the channel.
def worker = Concurrency::Spawn(channel, fn(ch : Channel<fn(Int) -> Int>) -> Int =>
{
	ch -> fn(n : Int) -> Int => n + 100;
	0
});
def from_worker = <- channel;
IO::PrintLine("from the worker: " ++ (from_worker(5) as Text));
IO::PrintLine("joined: " ++ (Concurrency::JoinedOrPanic(Concurrency::Join(worker)) as Text));
Concurrency::Close(channel);
