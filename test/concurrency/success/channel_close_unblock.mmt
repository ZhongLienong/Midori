module channel_close_unblock

import { "../../../MarmotPrelude/Concurrency.mmt", "../../../MarmotPrelude/Prelude/Result.mmt" }

import { "../../../MarmotPrelude/IO.mmt" }
use IO.{PrintLine}

def Sender = fn(ch : Channel<Text>) -> Int =>
{
    ch -> "first";
    ch -> "second";
    Concurrency::Close(ch);
    0
};

def ch : Channel<Text> = Concurrency::MakeChannel(2);
def w = Concurrency::Spawn(ch, Sender);

def msg1 = <- ch;
def msg2 = <- ch;

PrintLine("msg1=[" ++ msg1 ++ "]");
PrintLine("msg2=[" ++ msg2 ++ "]");

def r = Concurrency::JoinedOrPanic(Concurrency::Join(w));
PrintLine("worker_done=true");
