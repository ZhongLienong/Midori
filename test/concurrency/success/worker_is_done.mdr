module worker_is_done

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

import { "../../../MidoriPrelude/System.mdr" }
use System.{Sleep}

defun SlowTask(dummy: Text) : Int => {
    Sleep(100);
    0
};

def w = spawn SlowTask("x");
def done_early = is_done(w);
if done_early
then PrintLine("Done immediately: yes")
else PrintLine("Done immediately: no");
def r = join w;
PrintLine("Done after join");
