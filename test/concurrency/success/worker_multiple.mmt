module worker_multiple

import { "../../../MarmotPrelude/Concurrency.mmt", "../../../MarmotPrelude/Prelude/Result.mmt" }

import { "../../../MarmotPrelude/IO.mmt" }
use IO.{PrintLine}

// Defined before Counter: a worker rebuilds its globals by name, and forward
// references do not resolve across a spawn.
def CountTo = fn(i: Int, limit: Int) -> Int =>
    if i >= limit then i else CountTo(i + 1, limit);

def Counter = fn(label: Text) -> Int => {
    PrintLine(label ++ " counted to " ++ (CountTo(0, 1000) as Text));
    0
};

def w1 = Concurrency::Spawn("A", Counter);
def w2 = Concurrency::Spawn("B", Counter);
def w3 = Concurrency::Spawn("C", Counter);

def r1 = Concurrency::JoinedOrPanic(Concurrency::Join(w1));
def r2 = Concurrency::JoinedOrPanic(Concurrency::Join(w2));
def r3 = Concurrency::JoinedOrPanic(Concurrency::Join(w3));
PrintLine("All workers done");
