module worker_failure_propagation

import { "../../../MarmotPrelude/Concurrency.mmt", "../../../MarmotPrelude/Prelude/Result.mmt" }

import { "../../../MarmotPrelude/IO.mmt" }
use IO.{PrintLine}

def GoodWorker = fn(x : Int) -> Int =>
{
    (x * 2) + 20
};

def w = Concurrency::Spawn(11, GoodWorker);
def result = Concurrency::JoinedOrPanic(Concurrency::Join(w));
PrintLine("Worker result: " ++ (result as Text));
PrintLine("No error");
