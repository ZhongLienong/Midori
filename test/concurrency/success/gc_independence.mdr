module gc_independence

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

type Pair =
{
    A : Int,
    B : Int,
};

// Tail recursive, so 100000 iterations do not grow the stack. Still allocates
// one Pair per iteration -- the allocation pressure is the point of this test.
// Defined before AllocHeavyWorker: a worker rebuilds its globals by name, and
// forward references do not resolve across a spawn.
def AccumulatePairs = fn(i: Int, sum: Int, count: Int) -> Int =>
    if i >= count
    then sum
    else
    {
        def p = Pair(i, i * 2);
        AccumulatePairs(i + 1, sum + p.A + p.B, count)
    };

def AllocHeavyWorker = fn(ch: Channel<Int>, count: Int) -> Int => {
    ch -> AccumulatePairs(0, 0, count);
    0
};

def ch1 = channel<Int>(1);
def ch2 = channel<Int>(1);
def ch3 = channel<Int>(1);
def ch4 = channel<Int>(1);

def w1 = spawn AllocHeavyWorker(ch1, 100000);
def w2 = spawn AllocHeavyWorker(ch2, 100000);
def w3 = spawn AllocHeavyWorker(ch3, 100000);
def w4 = spawn AllocHeavyWorker(ch4, 100000);

def s1 = <- ch1;
def s2 = <- ch2;
def s3 = <- ch3;
def s4 = <- ch4;

PrintLine("s1=" ++ (s1 as Text));
PrintLine("s2=" ++ (s2 as Text));
PrintLine("s3=" ++ (s3 as Text));
PrintLine("s4=" ++ (s4 as Text));
PrintLine("all_equal=" ++ (if s1 == s2 then (if s2 == s3 then (if s3 == s4 then "true" else "false") else "false") else "false"));

close(ch1);
close(ch2);
close(ch3);
close(ch4);
def _r1 = join w1;
def _r2 = join w2;
def _r3 = join w3;
def _r4 = join w4;
