module channel_close_unblock

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

defun Sender(ch : Channel<Text>) -> Int =>
{
    ch -> "first";
    ch -> "second";
    close(ch);
    0
};

def ch = channel<Text>(2);
def w = spawn Sender(ch);

def msg1 = <- ch;
def msg2 = <- ch;

PrintLine("msg1=[" ++ msg1 ++ "]");
PrintLine("msg2=[" ++ msg2 ++ "]");

def r = join w;
PrintLine("worker_done=true");
