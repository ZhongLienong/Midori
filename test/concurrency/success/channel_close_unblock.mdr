module channel_close_unblock

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

def Sender = fn(ch : Channel<Text>) -> Int =>
{
    ch -> "first";
    ch -> "second";
    close(ch);
    0
};

def ch = channel<Text>(2);
def w = spawn Sender(ch);

def msg1 = <- ch;
def msg2 = <- ch;

PrintLine("msg1=[" ++ msg1 ++ "]");
PrintLine("msg2=[" ++ msg2 ++ "]");

def r = Concurrency::JoinedOrPanic(join w);
PrintLine("worker_done=true");
