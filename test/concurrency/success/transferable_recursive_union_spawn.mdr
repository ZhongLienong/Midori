module TransferableRecursiveUnionSpawn

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }

type IntList = Nil | Cons(Int, IntList) deriving (Transferable);

def Count = fn(list: IntList) -> Int =>
    match list with
        case IntList::Nil => 0
        case IntList::Cons(_, tail) => 1 + Count(tail)
;

def list =
    IntList::Cons(
        1,
        IntList::Cons(
            2,
            IntList::Cons(3, IntList::Nil())
        )
    );

def worker = Concurrency::Spawn(list, Count);
def result = Concurrency::JoinedOrPanic(Concurrency::Join(worker));

IO::PrintLine("count=" ++ (result as Text));
