module channel_spawn_syntax

import { "../../../MarmotPrelude/Concurrency.mmt", "../../../MarmotPrelude/Prelude/Result.mmt" }

import { "../../../MarmotPrelude/IO.mmt" }
use IO.{PrintLine}

def Producer = fn(ch: Channel<Text>) -> Int => {
    ch -> "left";
    ch -> "right";
    Concurrency::Close(ch);
    7
};

def ch : Channel<Text> = Concurrency::MakeChannel(2);
def worker = Concurrency::Spawn(ch, Producer);
def first = <- ch;
def second = <- ch;
def result = Concurrency::JoinedOrPanic(Concurrency::Join(worker));

PrintLine(first ++ "," ++ second ++ "," ++ (result as Text));
