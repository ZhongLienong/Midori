module SpawnReadsDataGlobals

import { "../../../MidoriPrelude/IO.mdr", "../../../MidoriPrelude/Countable.mdr" }

// A spawned worker must see the same global values as the code that spawned it.
// Workers used to start from zero-filled globals and restore only globals whose
// name matched a procedure, so a function reading a data global answered
// differently inside `spawn` than when called directly -- `direct=15 worker=5`
// for the Int case below -- with no error.

type Point = { x: Int, y: Int };
type Shape = Circle(Int) | Square(Int);

def MakeAdder = fn(amount : Int) -> fn(Int) -> Int => fn(n : Int) -> Int => n + amount;

def base = 10;
def label = "a global text long enough that small-string interning cannot hold it";
def weights = [1, 2, 3, 4];
def origin = Point(3, 4);
def shape = Shape::Square(6);
def AddHundred = MakeAdder(100);

// A local recursive closure refers to itself through its own captured cell, so
// copying this global into a worker has to handle a cycle.
def MakeSumTo = fn(bonus : Int) -> fn(Int) -> Int =>
{
	def SumTo = fn(n : Int) -> Int => if n <= 0 then bonus else n + SumTo(n - 1);
	SumTo
};
def SumToWithBonus = MakeSumTo(1000);

def UsesInt = fn(n : Int) -> Int => n + base;
def UsesText = fn(n : Int) -> Int => n + #label;
def UsesArray = fn(n : Int) -> Int => n + weights[0] + weights[3];
def UsesRecord = fn(n : Int) -> Int => n + origin.x * origin.y;
def UsesUnion = fn(n : Int) -> Int =>
	match shape with
	case Shape::Circle(r) => n + r
	case Shape::Square(s) => n + s * s;
def UsesCapturingClosure = fn(n : Int) -> Int => AddHundred(n);
def UsesRecursiveClosure = fn(n : Int) -> Int => SumToWithBonus(n);

def Report = fn(name : Text, direct : Int, worker : Int) -> Unit =>
	IO::PrintLine(name ++ ": direct=" ++ (direct as Text) ++ " worker=" ++ (worker as Text) ++ (if direct == worker then " same" else " DIFFERENT"));

def int_worker = spawn UsesInt(5);
def text_worker = spawn UsesText(5);
def array_worker = spawn UsesArray(5);
def record_worker = spawn UsesRecord(5);
def union_worker = spawn UsesUnion(5);
def closure_worker = spawn UsesCapturingClosure(5);
def recursive_worker = spawn UsesRecursiveClosure(5);

Report("int", UsesInt(5), join int_worker);
Report("text", UsesText(5), join text_worker);
Report("array", UsesArray(5), join array_worker);
Report("record", UsesRecord(5), join record_worker);
Report("union", UsesUnion(5), join union_worker);
Report("capturing closure", UsesCapturingClosure(5), join closure_worker);
Report("recursive closure", UsesRecursiveClosure(5), join recursive_worker);
