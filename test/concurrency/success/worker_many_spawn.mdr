module worker_many_spawn

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

def IdentityWorker = fn(ch: Channel<Int>, val: Int) -> Int => {
    ch -> val;
    0
};

def n = 16;
def ch = channel<Int>(n);

// Spawning is an effect, so `for` still suits it.
for i in 0..1..n
{
    def _w = spawn IdentityWorker(ch, i);
};

// Receiving accumulates, so it becomes a tail-recursive helper.
def Collect = fn(source: Channel<Int>, j: Int, sum: Int, limit: Int) -> Int =>
    if j >= limit then sum else Collect(source, j + 1, sum + (<- source), limit);

def sum = Collect(ch, 0, 0, n);

PrintLine("count=" ++ (n as Text));
PrintLine("sum=" ++ (sum as Text));
PrintLine("expected=" ++ (((n * (n - 1)) / 2) as Text));
PrintLine("match=" ++ (if sum == (n * (n - 1)) / 2 then "true" else "false"));

close(ch);
