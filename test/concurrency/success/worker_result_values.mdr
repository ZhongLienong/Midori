module worker_result_values

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

def ReturnZero = fn(ch: Channel<Int>) -> Int => {
    ch -> 0;
    0
};

def ReturnFortyTwo = fn(ch: Channel<Int>) -> Int => {
    ch -> 42;
    0
};

def ReturnNegative = fn(ch: Channel<Int>) -> Int => {
    ch -> (0 - 1);
    0
};

def ComputeReturn = fn(ch: Channel<Int>, x: Int) -> Int => {
    ch -> ((x * x) + 1);
    0
};

def ch1 : Channel<Int> = Concurrency::MakeChannel(1);
def ch2 : Channel<Int> = Concurrency::MakeChannel(1);
def ch3 : Channel<Int> = Concurrency::MakeChannel(1);
def ch4 : Channel<Int> = Concurrency::MakeChannel(1);

def w1 = Concurrency::Spawn(ch1, ReturnZero);
def w2 = Concurrency::Spawn(ch2, ReturnFortyTwo);
def w3 = Concurrency::Spawn(ch3, ReturnNegative);
def w4 = Concurrency::Spawn((ch4, 7), ComputeReturn);

PrintLine("zero=" ++ ((<- ch1) as Text));
PrintLine("fortytwo=" ++ ((<- ch2) as Text));
PrintLine("negative=" ++ ((<- ch3) as Text));
PrintLine("compute(7)=" ++ ((<- ch4) as Text));

Concurrency::Close(ch1);
Concurrency::Close(ch2);
Concurrency::Close(ch3);
Concurrency::Close(ch4);
def _r1 = Concurrency::JoinedOrPanic(Concurrency::Join(w1));
def _r2 = Concurrency::JoinedOrPanic(Concurrency::Join(w2));
def _r3 = Concurrency::JoinedOrPanic(Concurrency::Join(w3));
def _r4 = Concurrency::JoinedOrPanic(Concurrency::Join(w4));
