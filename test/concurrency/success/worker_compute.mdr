module worker_compute

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

// Defined before SumRange: a worker rebuilds its globals by name, and forward
// references do not resolve across a spawn.
def SumTo = fn(i: Int, end_val: Int) -> Int =>
    if i > end_val then 0 else i + SumTo(i + 1, end_val);

def SumRange = fn(ch: Channel<Int>, start: Int, end_val: Int) -> Int => {
    ch -> SumTo(start, end_val);
    0
};

def ch1 = channel<Int>(1);
def ch2 = channel<Int>(1);
def ch3 = channel<Int>(1);
def ch4 = channel<Int>(1);

def w1 = spawn SumRange(ch1, 1, 250);
def w2 = spawn SumRange(ch2, 251, 500);
def w3 = spawn SumRange(ch3, 501, 750);
def w4 = spawn SumRange(ch4, 751, 1000);

def s1 = <- ch1;
def s2 = <- ch2;
def s3 = <- ch3;
def s4 = <- ch4;

def total = s1 + s2 + s3 + s4;
PrintLine("Sum 1..1000 = " ++ (total as Text));

close(ch1);
close(ch2);
close(ch3);
close(ch4);
def _r1 = Concurrency::JoinedOrPanic(join w1);
def _r2 = Concurrency::JoinedOrPanic(join w2);
def _r3 = Concurrency::JoinedOrPanic(join w3);
def _r4 = Concurrency::JoinedOrPanic(join w4);
