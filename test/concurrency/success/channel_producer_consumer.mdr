module channel_producer_consumer

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

// Defined before Producer: a worker rebuilds its globals by name, and forward
// references do not resolve across a spawn.
def Send = fn(ch: Channel<Text>, i: Int, count: Int) -> Unit =>
    if i >= count
    then ()
    else
    {
        ch -> ("item-" ++ (i as Text));
        Send(ch, i + 1, count)
    };

def Producer = fn(ch: Channel<Text>, count: Int) -> Int => {
    Send(ch, 0, count);
    ch -> "DONE";
    0
};

def ch : Channel<Text> = Concurrency::MakeChannel(4);
def w = Concurrency::Spawn((ch, 5), Producer);

// Receives until the sentinel and returns the count, which the loop used to
// accumulate into `received`.
def Receive = fn(source: Channel<Text>, received: Int) -> Int =>
{
    def msg = <- source;
    if msg == "DONE"
    then received
    else
    {
        PrintLine("Got: " ++ msg);
        Receive(source, received + 1)
    }
};

PrintLine("Total received: " ++ (Receive(ch, 0) as Text));
close(ch);
def r = Concurrency::JoinedOrPanic(Concurrency::Join(w));
