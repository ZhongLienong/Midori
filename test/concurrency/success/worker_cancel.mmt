module worker_cancel

import { "../../../MarmotPrelude/Concurrency.mmt" }

import { "../../../MarmotPrelude/IO.mmt" }
use IO.{PrintLine}

import { "../../../MarmotPrelude/System.mmt" }
use System.{Sleep}

def LongTask = fn(dummy: Text) -> Int => {
    Sleep(5000);
    0
};

def w = Concurrency::Spawn("x", LongTask);
def cancelled = Concurrency::Cancel(w);
if cancelled
then PrintLine("Cancel requested: yes")
else PrintLine("Cancel requested: no");
