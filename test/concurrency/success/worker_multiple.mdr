module worker_multiple

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

// Defined before Counter: a worker rebuilds its globals by name, and forward
// references do not resolve across a spawn.
def CountTo = fn(i: Int, limit: Int) -> Int =>
    if i >= limit then i else CountTo(i + 1, limit);

def Counter = fn(label: Text) -> Int => {
    PrintLine(label ++ " counted to " ++ (CountTo(0, 1000) as Text));
    0
};

def w1 = spawn Counter("A");
def w2 = spawn Counter("B");
def w3 = spawn Counter("C");

def r1 = Concurrency::JoinedOrPanic(join w1);
def r2 = Concurrency::JoinedOrPanic(join w2);
def r3 = Concurrency::JoinedOrPanic(join w3);
PrintLine("All workers done");
