module gc_stress_arrays

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

// Total is tail recursive, so 10000 iterations do not grow the stack. The
// array itself is now built by a comprehension in a single allocation; the
// incremental reallocate-as-it-grows path the old in-place Append exercised
// is no longer covered.
// Defined before BuildArrayWorker: a worker rebuilds its globals by name, and
// forward references do not resolve across a spawn.
def Total = fn(arr: Array<Int>, j: Int, sum: Int, size: Int) -> Int =>
    if j >= size then sum else Total(arr, j + 1, sum + arr[j], size);

def BuildArrayWorker = fn(ch: Channel<Int>, size: Int) -> Int => {
    // Was built by repeated in-place Append. A comprehension allocates the
    // array once: same allocation volume, but the reallocate-as-it-grows path
    // is no longer exercised.
    def arr : Array<Int> = [i * i for i in 0..1..size];
    ch -> Total(arr, 0, 0, size);
    0
};

def ch1 : Channel<Int> = Concurrency::MakeChannel(1);
def ch2 : Channel<Int> = Concurrency::MakeChannel(1);

def w1 = Concurrency::Spawn((ch1, 10000), BuildArrayWorker);
def w2 = Concurrency::Spawn((ch2, 10000), BuildArrayWorker);

def s1 = <- ch1;
def s2 = <- ch2;

PrintLine("s1=" ++ (s1 as Text));
PrintLine("s2=" ++ (s2 as Text));
PrintLine("match=" ++ (if s1 == s2 then "true" else "false"));

close(ch1);
close(ch2);
def _r1 = Concurrency::JoinedOrPanic(Concurrency::Join(w1));
def _r2 = Concurrency::JoinedOrPanic(Concurrency::Join(w2));
