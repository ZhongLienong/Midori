module gc_stress_arrays

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

import { "../../../MidoriPrelude/Appendable.mdr" }
use Appendable.{Appendable}

// Both tail recursive, so 10000 iterations do not grow the stack. The array is
// still built by in-place Append, which is what this test stresses.
// Defined before BuildArrayWorker: a worker rebuilds its globals by name, and
// forward references do not resolve across a spawn.
def Fill = fn(arr: Array<Int>, i: Int, size: Int) -> Unit =>
    if i >= size
    then ()
    else
    {
        Appendable::Append(arr, i * i);
        Fill(arr, i + 1, size)
    };

def Total = fn(arr: Array<Int>, j: Int, sum: Int, size: Int) -> Int =>
    if j >= size then sum else Total(arr, j + 1, sum + arr[j], size);

def BuildArrayWorker = fn(ch: Channel<Int>, size: Int) -> Int => {
    def arr : Array<Int> = [];
    Fill(arr, 0, size);
    ch -> Total(arr, 0, 0, size);
    0
};

def ch1 = channel<Int>(1);
def ch2 = channel<Int>(1);

def w1 = spawn BuildArrayWorker(ch1, 10000);
def w2 = spawn BuildArrayWorker(ch2, 10000);

def s1 = <- ch1;
def s2 = <- ch2;

PrintLine("s1=" ++ (s1 as Text));
PrintLine("s2=" ++ (s2 as Text));
PrintLine("match=" ++ (if s1 == s2 then "true" else "false"));

close(ch1);
close(ch2);
def _r1 = join w1;
def _r2 = join w2;
