module worker_spawn

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

def WorkerTask = fn(msg: Text) -> Int => {
    42
};

def worker = Concurrency::Spawn("hello", WorkerTask);
def result = Concurrency::JoinedOrPanic(Concurrency::Join(worker));

PrintLine("Worker result: " ++ (result as Text));
