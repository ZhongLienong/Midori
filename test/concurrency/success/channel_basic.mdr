module channel_basic

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

def Producer = fn(ch: Channel<Text>) -> Int => {
    ch -> "message1";
    ch -> "message2";
    ch -> "done";
    0
};

def ch : Channel<Text> = Concurrency::MakeChannel(10);
def w = Concurrency::Spawn(ch, Producer);
def msg1 = <- ch;
def msg2 = <- ch;
def msg3 = <- ch;
PrintLine("Received: " ++ msg1 ++ ", " ++ msg2 ++ ", " ++ msg3);
Concurrency::Close(ch);
def r = Concurrency::JoinedOrPanic(Concurrency::Join(w));
