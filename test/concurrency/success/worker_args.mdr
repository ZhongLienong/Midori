module worker_args

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

def Greeter = fn(name: Text, greeting: Text) -> Int => {
    PrintLine(greeting ++ ", " ++ name ++ "!");
    0
};

def w = spawn Greeter("World", "Hello");
def r = Concurrency::JoinedOrPanic(join w);
PrintLine("Worker exited with: " ++ (r as Text));
