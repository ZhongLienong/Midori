module shared_bytecode

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

def Adder = fn(ch: Channel<Int>, a: Int, b: Int) -> Int => {
    ch -> (a + b);
    0
};

def Multiplier = fn(ch: Channel<Int>, a: Int, b: Int) -> Int => {
    ch -> (a * b);
    0
};

def Squarer = fn(ch: Channel<Int>, x: Int) -> Int => {
    ch -> (x * x);
    0
};

def ch1 = channel<Int>(1);
def ch2 = channel<Int>(1);
def ch3 = channel<Int>(1);
def ch4 = channel<Int>(1);
def ch5 = channel<Int>(1);

def w1 = spawn Adder(ch1, 10, 20);
def w2 = spawn Multiplier(ch2, 6, 7);
def w3 = spawn Squarer(ch3, 9);
def w4 = spawn Adder(ch4, 100, 200);
def w5 = spawn Multiplier(ch5, 11, 11);

PrintLine("add(10,20)=" ++ ((<- ch1) as Text));
PrintLine("mul(6,7)=" ++ ((<- ch2) as Text));
PrintLine("sq(9)=" ++ ((<- ch3) as Text));
PrintLine("add(100,200)=" ++ ((<- ch4) as Text));
PrintLine("mul(11,11)=" ++ ((<- ch5) as Text));

close(ch1);
close(ch2);
close(ch3);
close(ch4);
close(ch5);
def _r1 = Concurrency::JoinedOrPanic(join w1);
def _r2 = Concurrency::JoinedOrPanic(join w2);
def _r3 = Concurrency::JoinedOrPanic(join w3);
def _r4 = Concurrency::JoinedOrPanic(join w4);
def _r5 = Concurrency::JoinedOrPanic(join w5);
