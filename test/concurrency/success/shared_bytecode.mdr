module shared_bytecode

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

def Adder = fn(ch: Channel<Int>, a: Int, b: Int) -> Int => {
    ch -> (a + b);
    0
};

def Multiplier = fn(ch: Channel<Int>, a: Int, b: Int) -> Int => {
    ch -> (a * b);
    0
};

def Squarer = fn(ch: Channel<Int>, x: Int) -> Int => {
    ch -> (x * x);
    0
};

def ch1 : Channel<Int> = Concurrency::MakeChannel(1);
def ch2 : Channel<Int> = Concurrency::MakeChannel(1);
def ch3 : Channel<Int> = Concurrency::MakeChannel(1);
def ch4 : Channel<Int> = Concurrency::MakeChannel(1);
def ch5 : Channel<Int> = Concurrency::MakeChannel(1);

def w1 = Concurrency::Spawn((ch1, 10, 20), Adder);
def w2 = Concurrency::Spawn((ch2, 6, 7), Multiplier);
def w3 = Concurrency::Spawn((ch3, 9), Squarer);
def w4 = Concurrency::Spawn((ch4, 100, 200), Adder);
def w5 = Concurrency::Spawn((ch5, 11, 11), Multiplier);

PrintLine("add(10,20)=" ++ ((<- ch1) as Text));
PrintLine("mul(6,7)=" ++ ((<- ch2) as Text));
PrintLine("sq(9)=" ++ ((<- ch3) as Text));
PrintLine("add(100,200)=" ++ ((<- ch4) as Text));
PrintLine("mul(11,11)=" ++ ((<- ch5) as Text));

close(ch1);
close(ch2);
close(ch3);
close(ch4);
close(ch5);
def _r1 = Concurrency::JoinedOrPanic(Concurrency::Join(w1));
def _r2 = Concurrency::JoinedOrPanic(Concurrency::Join(w2));
def _r3 = Concurrency::JoinedOrPanic(Concurrency::Join(w3));
def _r4 = Concurrency::JoinedOrPanic(Concurrency::Join(w4));
def _r5 = Concurrency::JoinedOrPanic(Concurrency::Join(w5));
