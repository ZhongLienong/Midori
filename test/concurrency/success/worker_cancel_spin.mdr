module worker_cancel_spin

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

import { "../../../MidoriPrelude/System.mdr" }
use System.{Sleep}

// Spins forever until cancelled. Tail recursion gives the same unbounded loop
// the `loop` block did, without growing the stack and without assignment.
def SpinFrom = fn(i: Int) -> Int => SpinFrom(i + 1);

def Spin = fn(_dummy: Int) -> Int => SpinFrom(0);

def w = spawn Spin(0);
Sleep(50);
def cancelled = cancel(w);
// Polls the global `w` rather than taking it as a parameter, so the worker
// handle type does not have to be named.
def WaitUntilDone = fn(attempts: Int) -> Unit =>
    if is_done(w) || attempts >= 500
    then ()
    else
    {
        Sleep(10);
        WaitUntilDone(attempts + 1)
    };

WaitUntilDone(0);
if cancelled && is_done(w)
then PrintLine("spin worker cancelled")
else PrintLine("spin worker still running");
