module spawn_def_bound_lambda

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

def Double = fn(n: Int) -> Int => n * 2;

def Triple = fn(n: Int) -> Int => n * 3;

def SendBand = fn(ch: Channel<Text>, tag: Text) -> Int => {
    ch -> ("band:" ++ tag);
    0
};

def w1 = Concurrency::Spawn(21, Double);
def w2 = Concurrency::Spawn(14, Triple);
PrintLine("double=" ++ ((Concurrency::JoinedOrPanic(Concurrency::Join(w1))) as Text));
PrintLine("triple=" ++ ((Concurrency::JoinedOrPanic(Concurrency::Join(w2))) as Text));

def ch : Channel<Text> = Concurrency::MakeChannel(2);
def w3 = Concurrency::Spawn((ch, "left"), SendBand);
PrintLine(<- ch);
Concurrency::Close(ch);
def _r3 = Concurrency::JoinedOrPanic(Concurrency::Join(w3));

PrintLine("direct=" ++ (Double(5) as Text));
