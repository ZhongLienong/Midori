module worker_cancel_blocked_receive

import { "../../../MidoriPrelude/Concurrency.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

import { "../../../MidoriPrelude/System.mdr" }
use System.{Sleep}

def BlockOnChannel = fn(ch: Channel<Int>) -> Int => {
    def v = <- ch;
    v
};

def ch : Channel<Int> = Concurrency::MakeChannel(1);
def w = Concurrency::Spawn(ch, BlockOnChannel);
Sleep(50);
def cancelled = cancel(w);
// Polls the global `w` rather than taking it as a parameter, so the worker
// handle type does not have to be named.
def WaitUntilDone = fn(attempts: Int) -> Unit =>
    if is_done(w) || (attempts >= 500)
    then ()
    else
    {
        Sleep(10);
        WaitUntilDone(attempts + 1)
    };

WaitUntilDone(0);
if cancelled && is_done(w)
then PrintLine("blocked worker cancelled")
else PrintLine("blocked worker still running");
