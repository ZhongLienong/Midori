module spawn_nontransferable_worker_argument

import { "../../../MarmotPrelude/Concurrency.mmt", "../../../MarmotPrelude/Prelude/Result.mmt" }

def Produce = fn() -> Int =>
{
    42
};

def Rejoin = fn(worker: Worker<Int>) -> Int =>
{
    Concurrency::JoinedOrPanic(Concurrency::Join(worker))
};

def produced = Concurrency::Spawn((), Produce);
def nested = Concurrency::Spawn(produced, Rejoin);
