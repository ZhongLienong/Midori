module spawn_nontransferable_derived_field

import { "../../../MidoriPrelude/Concurrency.mdr" }

import { "../../../MidoriPrelude/IO.mdr" }

type BadPayload =
{
    callback: fn(Int) -> Int
} deriving (Transferable);

def UsePayload = fn(payload: BadPayload) -> Int => {
    payload.callback(5)
};

def increment = fn(value: Int) => {
    value + 1
};

def worker = Concurrency::Spawn(BadPayload(increment), UsePayload);
