module spawn_nontransferable_worker_argument

import { "../../../MidoriPrelude/Concurrency.mdr", "../../../MidoriPrelude/Prelude/Result.mdr" }

def Produce = fn() -> Int =>
{
    42
};

def Rejoin = fn(worker: Worker<Int>) -> Int =>
{
    Concurrency::JoinedOrPanic(join worker)
};

def produced = spawn Produce();
def nested = spawn Rejoin(produced);
