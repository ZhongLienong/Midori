module SpawnKeywordRemoved

import { "../../../MidoriPrelude/Concurrency.mdr" }

// `spawn` was removed in favour of Concurrency::Spawn(argument, F). It now lexes
// as an ordinary identifier, so the error names the replacement rather than
// failing with a bare "Undefined name.".

def Add = fn(a : Int, b : Int) -> Int => a + b;

def worker = spawn Add(1, 2);
