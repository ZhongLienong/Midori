module CloseBuiltinRemoved

import { "../../../MidoriPrelude/Concurrency.mdr" }

// `close`, `is_done` and `cancel` were unqualified builtins while the rest of the
// concurrency surface moved under Concurrency::. They now live there too, and the
// old spelling names its replacement.

def channel : Channel<Int> = Concurrency::MakeChannel(1);

def closed = close(channel);
