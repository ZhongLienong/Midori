import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

// Test float range comprehension
def floats = [x * 0.5 for x in 0.0..1.0..4.0];
PrintLine("Floats:");
for f in floats {
    PrintLine(f as Text);
};

// Test float with complex step
def precise = [x for x in 0.0..0.1..0.5];
PrintLine("Precise steps:");
for p in precise {
    PrintLine(p as Text);
};
