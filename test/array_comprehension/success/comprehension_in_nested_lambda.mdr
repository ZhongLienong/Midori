module ComprehensionInNestedLambda

import { "../../../MidoriPrelude/IO.mdr" }

// A comprehension inside a lambda that is itself inside another function used to
// crash with a memory access violation. Its hidden loop slots were numbered with the
// parser's running variable count, which is absolute across nested functions, so
// inside a nested lambda they addressed slots past the frame. A `for` loop in the
// same position numbered its slots the same way and survived by luck, reading and
// writing the same wrong slots; the comprehension treated one of them as the result
// array and followed it as a pointer.

def RangeInNested = fn(value : Int) -> Array<Int> =>
{
	def inner = fn(n : Int) -> Array<Int> => [i * 2 for i in 0..1..n];
	inner(value)
};

def ArrayInNested = fn(values : Array<Int>) -> Array<Int> =>
{
	def inner = fn(chunk : Array<Int>) -> Array<Int> => [n + 1 for n in chunk];
	inner(values)
};

def DoublyNested = fn(value : Int) -> Array<Int> =>
{
	def middle = fn(m : Int) -> Array<Int> =>
	{
		def inner = fn(n : Int) -> Array<Int> => [i * i for i in 0..1..n];
		inner(m)
	};
	middle(value)
};

// A nested lambda holding a local before the comprehension, so the frame slots the
// comprehension needs sit after a real local.
def AfterALocal = fn(value : Int) -> Array<Int> =>
{
	def inner = fn(n : Int) -> Array<Int> =>
	{
		def offset = 100;
		[i + offset for i in 0..1..n]
	};
	inner(value)
};

def ForInNested = fn(value : Int) -> Int =>
{
	def inner = fn(n : Int) -> Int =>
	{
		for i in 0..1..n { IO::PrintLine("  for " ++ (i as Text)); };
		n
	};
	inner(value)
};

IO::PrintLine("range: " ++ (RangeInNested(3)[2] as Text));
IO::PrintLine("array: " ++ (ArrayInNested([1, 2, 3])[2] as Text));
IO::PrintLine("doubly: " ++ (DoublyNested(3)[2] as Text));
IO::PrintLine("after a local: " ++ (AfterALocal(3)[2] as Text));
IO::PrintLine("for: " ++ (ForInNested(2) as Text));
