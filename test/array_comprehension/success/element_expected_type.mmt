module ComprehensionElementExpectedType

import { "../../../MarmotPrelude/IO.mmt" }

type Slot < T > = Empty | Full(T);
type Point = { x: Int, y: Int };

// The element is a construction that can only infer its arguments from the
// annotation's element type, not from the array type.
def slots : Array < Slot < Int > > = [Slot::Empty () for index in 0..1..3];

def points : Array < Point > = [Point (index, index * 2) for index in 0..1..3];

def MakeSlots = fn < T >(count: Int) -> Array < Slot < T > > => [Slot::Empty () for index in 0..1..count];

def words : Array < Slot < Text > > = MakeSlots(2);

IO::PrintLine(#slots as Text);
IO::PrintLine(#words as Text);
IO::PrintLine(points[2].y as Text);
match slots[0] with
    case Slot::Full(v) => IO::PrintLine(v as Text)
    case Slot::Empty => IO::PrintLine("empty");
