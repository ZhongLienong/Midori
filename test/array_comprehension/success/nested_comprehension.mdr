module NestedComprehension

import { "../../../MidoriPrelude/IO.mdr" }
use IO.{PrintLine}

// Test nested array comprehension (Matrix creation)
def rows = 3;
def cols = 3;
def matrix = [[(x * 10) + y for y in 1..1..cols] for x in 1..1..rows];

PrintLine("Matrix 3x3:");
def JoinRow = fn(row: Array < Int >, index: Int, acc: Text) -> Text =>
    if index >= #row then acc else JoinRow(row, index + 1, acc ++ (row[index] as Text) ++ " ");

for row in matrix {
    PrintLine(JoinRow(row, 0, ""));
};

// Test 3-level nesting
def cube = [[[x + y + z for z in 0..1..2] for y in 0..1..2] for x in 0..1..2];
PrintLine("Cube element [1][1][1]:");
PrintLine(cube[1][1][1] as Text);
