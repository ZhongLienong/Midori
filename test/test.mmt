module LinkedList
import { "../MarmotPrelude/IO.mmt", "../MarmotPrelude/Convertable.mmt"  }

type ListNode<T> = None | Value(T, ListNode<T>);

def ListToString = fn<T>(List : ListNode<T>) -> Text where Convertable<T, Text> =>
    match List with
        case ListNode::None => ""
        case ListNode::Value(Head, Tail) => (Head as Text) ++ ", " ++ ListToString(Tail)
;

def MyList = ListNode::Value(1, ListNode::Value(2, ListNode::Value(3, ListNode::None())));

IO::PrintLine(ListToString(MyList));