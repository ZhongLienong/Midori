import
{
	"../../MidoriPrelude/IO.mdr",
}

defun Pow(x : Float, n : Int) : Float =>
{
	if n < 0
	then Pow(1.0 / x, -n)
	else
	{
		if n == 0
		then 1.0
		else
		{
			if (n & 1) == 1
			then x * Pow(x, n - 1)
			else
			{
				def sub_result = Pow(x, n / 2);
				sub_result * sub_result
			}
		}
	}
};

IO::PrintLine(Pow(2.0, 10) as Text);
IO::PrintLine(Pow(2.1, 3) as Text);
IO::PrintLine(Pow(2.0, -2) as Text);