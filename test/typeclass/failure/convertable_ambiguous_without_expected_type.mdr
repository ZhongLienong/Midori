module ConvertableAmbiguousWithoutExpectedType

// The expected type is a tie-breaker for concrete instance selection, not
// a filter. Convertable is the class that genuinely needs it: every
// Convertable<Int, _> instance accepts an Int argument, so with no
// expected type to break the tie the call must stay ambiguous rather
// than silently pick one.

import { "../../../MidoriPrelude/Convertable.mdr", }

def value = Convertable::Convert(7);
