module CountableUnqualifiedNameCollision

// Cheap guard, not a regression test: `SiteMap` never matched the old
// name-suffix dispatch, because HasNameSuffix required the suffix to be
// the whole name or to follow a `::`. This case passed before the
// dispatch was removed and passes after it. It is here only to keep the
// clean error clean.

import { "../../../MarmotPrelude/IO.mmt", }

type SiteMap = { url: Text };

def s = SiteMap("example.com");
IO::PrintLine(#s as Text);
