module UnsatisfiableConstraint

// Test: Call to generic function with type that doesn't have required instance
import { "../../../MarmotPrelude/IO.mmt", "../../../MarmotPrelude/Convertable.mmt" }

type CustomType = {
    value: Int
};

def ToText = fn<T>(value: T) -> Text where Convertable<T, Text> => {
    value as Text
};

// This should fail because there's no Convertable<CustomType, Text> instance
def custom = CustomType(42);
def result = ToText(custom);  // ERROR: No Convertable instance for CustomType
IO::PrintLine(result);
