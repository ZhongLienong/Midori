module IndexableNoInstance

// `[]` used to reject every non-array operand with a message about arrays.
// It now reports the missing typeclass instead, and must name Indexable
// along with both type arguments. Text deliberately has no instance: its
// element type is decided by the planned newtype over Array<Byte>, not by
// whichever text FFI happens to exist today.

import { "../../../MarmotPrelude/IO.mmt", "../../../MarmotPrelude/Indexable.mmt", }

use Indexable.{ Indexable }

def t: Text = "abc";
IO::PrintLine(t[0] as Text);
