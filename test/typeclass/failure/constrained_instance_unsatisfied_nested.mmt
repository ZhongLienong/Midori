module ConstrainedInstanceUnsatisfiedNested

import { "../../../MarmotPrelude/IO.mmt", }

class Show<T> {
    show: fn(value: T) -> Text;
};

type Boxed<T> = { item: T };

type Opaque = { tag: Int };

instance Show<Boxed<T>> where Show<T> {
    def show = fn(value: Boxed<T>) -> Text => "Boxed(" ++ Show::show(value.item) ++ ")";
};

def bad = Boxed(Boxed(Opaque(1)));
IO::PrintLine(Show::show(bad));
