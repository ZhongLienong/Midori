module CountableNoInstance

// Regression guard for the miscompile that motivated removing the `#`
// name-suffix dispatch. `MapData` is one of the names the old dispatch
// matched exactly, and importing Map.mmt puts `MapCount` in scope, so
// `#value` used to compile into a call to `Map::MapCount` and read a
// field slot this struct does not have. It printed 0 with exit code 0.
// It must now be a clean "no Countable instance" error.

import { "../../../MarmotPrelude/IO.mmt", "../../../MarmotPrelude/Collections/Map.mmt", }

type MapData = { url: Text };

def value = MapData("example.com");
IO::PrintLine(#value as Text);
