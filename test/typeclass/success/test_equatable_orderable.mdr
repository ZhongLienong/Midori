import { "../../../MidoriPrelude/IO.mdr", "../../../MidoriPrelude/Equatable.mdr", "../../../MidoriPrelude/Orderable.mdr" }

struct Point {
    x: Int,
    y: Int
};

instance Equatable<Point>
{
    defun Equals(a: Point, b: Point) : Bool => a.x == b.x && a.y == b.y;
};

instance Orderable<Point>
{
    defun Compare(a: Point, b: Point) : Int => {
        if a.x < b.x then return -1 else
        if a.x > b.x then return 1 else
        if a.y < b.y then return -1 else
        if a.y > b.y then return 1 else
        return 0;
    };
};

def p1 = new Point(1, 2);
def p2 = new Point(1, 2);
def p3 = new Point(2, 3);
def p4 = new Point(1, 3);

IO::PrintLine("Testing Equatable:");
IO::PrintLine("p1 == p2: " ++ (if p1 == p2 then "true" else "false"));
IO::PrintLine("p1 == p3: " ++ (if p1 == p3 then "true" else "false"));
IO::PrintLine("p1 != p3: " ++ (if p1 != p3 then "true" else "false"));

IO::PrintLine("Testing Orderable:");
IO::PrintLine("p1 < p3: " ++ (if p1 < p3 then "true" else "false"));
IO::PrintLine("p3 > p1: " ++ (if p3 > p1 then "true" else "false"));
IO::PrintLine("p1 <= p2: " ++ (if p1 <= p2 then "true" else "false"));
IO::PrintLine("p1 >= p2: " ++ (if p1 >= p2 then "true" else "false"));
IO::PrintLine("p1 < p4: " ++ (if p1 < p4 then "true" else "false"));

IO::PrintLine("test_equatable_orderable: PASS");
