module EqualityConstraintFunction

import { "../../../MarmotPrelude/IO.mmt", "../../../MarmotPrelude/Prelude/Option.mmt" }

use Option.{ Option }

class Stepper<S> {
    type Item;
    Step: fn(state: S) -> Option<Item>;
};

type Counter = { current: Int, limit: Int };

instance Stepper<Counter> {
    type Item = Int;
    def Step = fn(state: Counter) -> Option<Int> =>
        if state.current >= state.limit
        then Option::None()
        else Option::Some(state.current);
};

def Twice = fn<S>(s: S) -> Int where Stepper<S>, Stepper::Item<S> ~ Int =>
    match Stepper::Step(s) with
        case Option::Some(v) => v * 2
        case Option::None() => 0;

IO::PrintLine(Twice(Counter(3, 10)) as Text);
