module CountableGenericUserType

// A user-defined generic container with a Countable instance. Before `#`
// resolved through the generic instance matchers this failed outright:
// the lookup was an exact string key, so Countable<Bag<T>> could not
// match Countable<Bag<Int>>.

import { "../../../MidoriPrelude/IO.mdr", "../../../MidoriPrelude/Countable.mdr", }

struct Bag < T > {
    items: Array < T >
};

instance Countable < Bag < T >> {
    defun Count(value: Bag < T >) -> Int => #value.items;
};

def ints: Bag < Int > = new Bag < Int >([1, 2, 3]);
def texts: Bag < Text > = new Bag < Text >(["a", "b"]);

IO::PrintLine(#ints as Text);
IO::PrintLine(#texts as Text);
