module TestCountableOperator

import { "../../../MarmotPrelude/IO.mmt", "../../../MarmotPrelude/Countable.mmt" }

type Box = {
    values: Array<Int>
};

instance Countable<Box> {
    def Count = fn(box: Box) -> Int => #box.values;
};

def box = Box([1, 2, 3, 4]);
def len = #box;

if len == 4
then IO::PrintLine("countable_operator: PASS")
else IO::PrintLine("countable_operator: FAIL");
