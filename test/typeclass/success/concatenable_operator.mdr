module ConcatenableOperator

import { "../../../MidoriPrelude/IO.mdr", "../../../MidoriPrelude/Concatenable.mdr" }

type Chunk = {
    text: Text
};

instance Concatenable<Chunk> {
    def Concat = fn(left: Chunk, right: Chunk) -> Chunk => Chunk(left.text ++ right.text);
};

def Join = fn<T>(left: T, right: T) -> T
    where Concatenable<T> => left ++ right;

def combined = Chunk("mid") ++ Chunk("ori");
def joined = Join(Chunk("type"), Chunk("class"));

if (combined.text == "midori") && (joined.text == "typeclass")
then IO::PrintLine("concatenable_operator: PASS")
else IO::PrintLine("concatenable_operator: FAIL");
