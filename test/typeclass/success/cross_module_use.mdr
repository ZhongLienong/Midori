// Test: Import typeclass from another module and use it

import { "../../../MidoriPrelude/IO.mdr", "./show_typeclass.mdr" }

// Define a constrained generic function using the imported typeclass
defun display<T>(value: T) : Text where T: Show<T> => {
    return show(value);
};

def result = display(42);
IO::PrintLine(result);

IO::PrintLine("cross_module_use: PASS");
