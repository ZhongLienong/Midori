module AssociatedTypesIterable

import
{
    "../../../MarmotPrelude/IO.mmt",
    "../../../MarmotPrelude/Iterable.mmt",
    "../../../MarmotPrelude/Prelude/Option.mmt"
}

use Option.{Option}

type Counter =
{
    current: Int,
    end: Int
};

def CounterNew = fn(end: Int) -> Counter => Counter(0, end);

instance Iterable<Counter>
{
    type Item = Int;

    def Next = fn(counter: Counter) -> Option<(Int, Counter)> => {
        if counter.current >= counter.end
        then Option::None()
        else Option::Some((counter.current, Counter(counter.current + 1, counter.end)))
    };
};

def NextValue = fn<Iter>(iter: Iter) -> Option<(Iterable::Item<Iter>, Iter)>
    where Iterable<Iter> => {
    Iterable::Next(iter)
};

def iter = CounterNew(2);

match NextValue(iter) with
    case Option::Some(pair) => {
        def (value, _) = pair;
        if value == 0
        then IO::PrintLine("associated_types_iterable: PASS")
        else IO::PrintLine("associated_types_iterable: FAIL")
    }
    case Option::None() => IO::PrintLine("associated_types_iterable: FAIL");
