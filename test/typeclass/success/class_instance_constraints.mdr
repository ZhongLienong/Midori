module ClassInstanceConstraints

import { "../../../MidoriPrelude/IO.mdr", }

class Show<T> {
    show: fn(value: T) -> Text;
};

class Debug<T> {
    debug: fn(value: T) -> Text;
};

instance Show<Int> {
    def show = fn(value: Int) -> Text => {
        "Int(" ++ (value as Text) ++ ")"
    };
};

instance Debug<Int> {
    def debug = fn(value: Int) -> Text => {
        "Debug(" ++ (value as Text) ++ ")"
    };
};

def debug_value = fn<T>(x: T) -> Text where Debug<T> => {
    Debug::debug(x)
};

def result = debug_value(7);
IO::PrintLine(result);
IO::PrintLine("class_instance_constraints: PASS");
