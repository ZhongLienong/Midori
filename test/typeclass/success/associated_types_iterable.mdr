module AssociatedTypesIterable

import
{
    "../../../MidoriPrelude/IO.mdr",
    "../../../MidoriPrelude/Iterable.mdr",
    "../../../MidoriPrelude/Prelude/Option.mdr"
}

use Option.{Option}

type Counter =
{
    current: Int,
    end: Int
};

def CounterNew = fn(end: Int) -> Counter => Counter(0, end);

instance Iterable<Counter>
{
    type Item = Int;

    def Next = fn(counter: Counter) -> Option<Int> => {
        if counter.current >= counter.end
        then Option::None()
        else {
            def value = counter.current;
            counter.current = counter.current + 1;
            Option::Some(value)
        }
    };
};

def NextValue = fn<Iter>(iter: Iter) -> Option<Iterable::Item<Iter>>
    where Iterable<Iter> => {
    return Iterable::Next(iter);
};

def iter = CounterNew(2);

match NextValue(iter) with
    case Option::Some(value) => {
        if value == 0
        then IO::PrintLine("associated_types_iterable: PASS")
        else IO::PrintLine("associated_types_iterable: FAIL")
    }
    case Option::None() => IO::PrintLine("associated_types_iterable: FAIL");
