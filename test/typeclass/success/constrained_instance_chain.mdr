module ConstrainedInstanceChain

import { "../../../MidoriPrelude/IO.mdr", }

class Show<T> {
    show: fn(value: T) -> Text;
};

class Tag<T> {
    tag: fn(value: T) -> Text;
};

struct Boxed<T> { item: T };

struct Wrapped<T> { inner: T };

instance Tag<Int> {
    defun tag(value: Int) : Text => "tag:" ++ (value as Text);
};

instance Show<Int> {
    defun show(value: Int) : Text => "Int(" ++ (value as Text) ++ ")";
};

instance Show<Wrapped<T>> where Tag<T> {
    defun show(value: Wrapped<T>) : Text => "Wrapped(" ++ Tag::tag(value.inner) ++ ")";
};

instance Show<Boxed<T>> where Show<T> {
    defun show(value: Boxed<T>) : Text => "Boxed(" ++ Show::show(value.item) ++ ")";
};

def deep = new Boxed<Boxed<Wrapped<Int>>>(new Boxed<Wrapped<Int>>(new Wrapped<Int>(5)));

IO::PrintLine(Show::show(deep));
IO::PrintLine(Show::show(new Boxed<Int>(1)));
IO::PrintLine(Show::show(new Wrapped<Int>(2)));
