module CrossModuleConstrainedLib
public export { Show, Boxed, MakeBoxedInt, MakeBoxedText, MakeNested }

class Show<T> {
    show: fn(value: T) -> Text;
};

struct Boxed<T> { item: T };

instance Show<Int> {
    def show = fn(value: Int) -> Text => "Int(" ++ (value as Text) ++ ")";
};

instance Show<Text> {
    def show = fn(value: Text) -> Text => "Text(" ++ value ++ ")";
};

instance Show<Boxed<T>> where Show<T> {
    def show = fn(value: Boxed<T>) -> Text => "Boxed(" ++ Show::show(value.item) ++ ")";
};

def MakeBoxedInt = fn(n: Int) -> Boxed<Int> => new Boxed<Int>(n);

def MakeBoxedText = fn(t: Text) -> Boxed<Text> => new Boxed<Text>(t);

def MakeNested = fn(n: Int) -> Boxed<Boxed<Int>> => new Boxed<Boxed<Int>>(new Boxed<Int>(n));
