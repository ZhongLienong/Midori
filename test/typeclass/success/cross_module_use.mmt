module CrossModuleUse

// Test: Import class from another module and use it

import { "../../../MarmotPrelude/IO.mmt", "./show_typeclass.mmt" }

// Define a constrained generic function using the imported typeclass
def display = fn<T>(value: T) -> Text where Show<T> => {
    Show::show(value)
};

def result = display(42);
IO::PrintLine(result);

IO::PrintLine("cross_module_use: PASS");
