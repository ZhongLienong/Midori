import { "../../../MidoriPrelude/IO.mdr", }

// Define multiple typeclasses
typeclass Show<T> {
    show: fn(value: T) -> Text;
};

typeclass Debug<T> {
    debug: fn(value: T) -> Text;
};

// Multiple instances for Show
instance Show<Int> {
    defun show(value: Int) : Text => {
        return "Int(" ++ (value as Text) ++ ")";
    };
};

instance Show<Float> {
    defun show(value: Float) : Text => {
        return "Float(" ++ (value as Text) ++ ")";
    };
};

// Instance for Debug
instance Debug<Int> {
    defun debug(value: Int) : Text => {
        return "[DEBUG] " ++ (value as Text);
    };
};

// Constrained generic functions
defun print_value<T>(x: T) : Text where T: Show<T> => {
    return show(x);
};

defun debug_value<T>(x: T) : Text where T: Debug<T> => {
    return debug(x);
};

// Test Show with Int
def r1 = print_value(42);
IO::PrintLine(r1);

// Test Show with Float
def r2 = print_value(2.718);
IO::PrintLine(r2);

// Test Debug with Int
def r3 = debug_value(100);
IO::PrintLine(r3);

IO::PrintLine("comprehensive: PASS");
