module CountableAllTypes

// `#` must resolve through Countable for every type. Array keeps a
// dedicated opcode; the other four go through their prelude instances.

import { "../../../MidoriPrelude/IO.mdr", "../../../MidoriPrelude/Collections/Map.mdr", "../../../MidoriPrelude/Collections/Set.mdr", "../../../MidoriPrelude/Prelude/List.mdr", }

def array: Array < Int > = [10, 20, 30];

def map: Map::Map < Text, Int > = Map::MapNew();
Map::MapInsert(map, "a", 1);
Map::MapInsert(map, "b", 2);

def set: Set::Set < Int > = Set::SetNew();
Set::SetInsert(set, 7);
Set::SetInsert(set, 8);
Set::SetInsert(set, 9);
Set::SetInsert(set, 7);

def list: List::List < Int > = List::ListFromArray([1, 2, 3, 4, 5]);

def text = "hello!";

IO::PrintLine(#array as Text);
IO::PrintLine(#map as Text);
IO::PrintLine(#set as Text);
IO::PrintLine(#list as Text);
IO::PrintLine(#text as Text);
