import 
{
	"../../MidoriPrelude/IO.mdr",
	"../../MidoriPrelude/DateTime.mdr"
}

defun TestPrimeNumbers() : Unit =>
{
	defun IsPrime(n : Int) : Bool =>
	{
		defun IsPrimeHelper(n : Int, divisor : Int) : Bool =>
		{
			if divisor * divisor > n
			then true
			else
			{
				if n % divisor == 0
				then false
				else IsPrimeHelper(n, divisor + 1)
			}
		};

		if n <= 1 then false else IsPrimeHelper(n, 2)
	};

	def start = DateTime::GetTime();

	def prime_count = 0;
	def count = 0;
	loop
	{
		if count >= 100000
		then break ()
		else
		{
			if IsPrime(count)
			then
			{
				prime_count = prime_count + 1;
			}
			else ();
			count = count + 1;
		}
	};

	def end = DateTime::GetTime();

	IO::PrintLine("Prime(100000): " ++ (prime_count as Text) ++ " benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
};

defun TestFib(n : Int) : Unit =>
{
	defun fib(n : Int) : Int => if n <= 1 then n else fib(n - 1) + fib(n - 2);

	def start = DateTime::GetTime();

	def fib_n = fib(n);

	def end = DateTime::GetTime();

	IO::PrintLine("Fibonacci(" ++ (n as Text) ++ "): " ++ (fib_n as Text) ++ " benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
};

defun TestStringManipulation() : Unit =>
{
    def start = DateTime::GetTime();

    def test_string = "";
	def count = 0;
	loop
	{
		if count >= 10000
		then break ()
		else
		{
			test_string = test_string ++ "a";
			count = count + 1;
		}
	};

    def end = DateTime::GetTime();

    IO::PrintLine("String manipulation benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
};

defun TestParenthesisGeneration(max_len : Int) : Unit =>
{
    def output : Array<Text> = [];
    defun BackTrack(len : Int, left : Int, right : Int, acc : Text) : Unit =>
    {   
		if left < right
		then
		{
			return ();
		}
		else
		{
			if left > len || right > len
			then
			{
				return ();
			}
			else
			{
				if left == len && right == len
				then
				{
					output = output ++ [acc];
					return ();
				}
				else
				{
					BackTrack(len, left + 1, right, acc ++ "(");
					BackTrack(len, left, right + 1, acc ++ ")");
				}
			}
		}
    };

    def start = DateTime::GetTime();

    BackTrack(max_len, 0, 0, "");

    def end = DateTime::GetTime();

    IO::PrintLine("Parenthesis generation benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
};

TestFib(35);
TestPrimeNumbers();
TestStringManipulation();
TestParenthesisGeneration(8);