import 
{
	"../MidoriPrelude/IO.mdr",
	"../MidoriPrelude/DateTime.mdr"
}

def TestPrimeNumbers : () -> Unit = fn() ->
{
	def IsPrime : (Int) -> Bool = fn(n) ->
	{
		when n <= 1
		{
			return false;
		}

		def i = 2;
		loop (i * i <= n)
		{
			when n % i == 0
			{
				return false;
			}
			i = i + 1;
		}
		
		true
	};

	def start = DateTime::GetTime();

	def prime_count = 0;
	loop (def i = 0; i < 100000; i = i + 1)
	{
		when IsPrime(i)
		{
			prime_count = prime_count + 1;
		}
	}

	def end = DateTime::GetTime();

	IO::PrintLine("Prime(100000): " ++ (prime_count as Text) ++ " benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
};

def main : () -> Unit = fn() ->
{
	return TestPrimeNumbers();
};