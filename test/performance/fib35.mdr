import 
{
	"../MidoriPrelude/IO.mdr",
	"../MidoriPrelude/DateTime.mdr"
}

def TestFib : () -> Unit = fn() ->
{

	def fib : (Int) -> Int = fn(n) -> if n <= 1 then n else fib(n - 1) + fib(n - 2);

	def start = DateTime::GetTime();

	def fib_35 = fib(35);

	def end = DateTime::GetTime();

	IO::PrintLine("Fibonacci(35): " ++ (fib_35 as Text) ++ " benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
};

def main : () -> Unit = fn() ->
{
	return TestFib();
};