module StrConcat

import 
{
	"../../MidoriPrelude/IO.mdr",
	"../../MidoriPrelude/DateTime.mdr"
}

def start = DateTime::GetTime();

def test_string = "";
def count = 0;
loop
{
	if count >= 10000
	then break ()
	else
	{
		test_string = test_string ++ "a";
		count = count + 1;
	}
};

def end = DateTime::GetTime();

IO::PrintLine("String manipulation benchmark took " ++ ((end - start) as Text) ++ " milliseconds");