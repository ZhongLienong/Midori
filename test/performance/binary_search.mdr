import
{
	"../../MidoriPrelude/IO.mdr",
	"../../MidoriPrelude/DateTime.mdr"
}

defun BinarySearch(arr : Array<Int>, target : Int, low : Int, high : Int) : Int =>
{
	if low > high
	then -1
	else
	{
		def mid = low + (high - low) / 2;
		def mid_val = arr[mid];

		if mid_val == target
		then mid
		else
		{
			if mid_val > target
			then BinarySearch(arr, target, low, mid - 1)
			else BinarySearch(arr, target, mid + 1, high)
		}
	}
};

def start = DateTime::GetTime();

def sorted_array : Array<Int> = [];
def array_len = 0;
def i = 0;
loop
{
	if i >= 100000
	then break ()
	else
	{
		sorted_array ++= i;
		array_len = array_len + 1;
		i = i + 1;
	}
};

def searches = 10000;
def found_count = 0;
def j = 0;
loop
{
	if j >= searches
	then break ()
	else
	{
		def target = (j * 7) % 100000;
		def result = BinarySearch(sorted_array, target, 0, array_len - 1);
		if result != -1
		then found_count = found_count + 1
		else 0;
		j = j + 1;
	}
};

def end = DateTime::GetTime();

IO::PrintLine("Binary search (10000 searches in 100000 elements): " ++ (found_count as Text) ++ " found, benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
