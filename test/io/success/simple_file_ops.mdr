import
{
    <IO>
}

// Test WriteFile
def write_success = IO::WriteFile("test_output.txt", "Hello from Midori!\nLine 2\nLine 3");
if write_success then
{
    IO::PrintLine("✓ WriteFile succeeded");
}
else
{
    IO::PrintLine("✗ WriteFile failed");
};

// Test ReadFile
def content = IO::ReadFile("test_output.txt");
IO::PrintLine("File content:");
IO::Print(content);

// Test AppendToFile
def append_success = IO::AppendToFile("test_output.txt", "\nAppended line");
if append_success then
{
    IO::PrintLine("✓ AppendToFile succeeded");
}
else
{
    IO::PrintLine("✗ AppendToFile failed");
};

// Read again to verify append
def updated_content = IO::ReadFile("test_output.txt");
IO::PrintLine("Updated content:");
IO::Print(updated_content);

IO::PrintLine("Simple file operations test completed");
